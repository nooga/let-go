# scripts/spec-vocabs/clj-repl.vocab -- top-level forms with inline expectations.
# Preamble is portable Clojure: runs on let-go and on JVM Clojure.
# `boot` lines are emitted once at the top of the runner, in order.
boot #?(:clj (import 'clojure.lang.ExceptionInfo))
boot (require '[clojure.string :as str])
boot (require '[clojure.test :refer :all])
boot (def ^:dynamic *spec-fails* (atom 0))
boot (defn spec-fail! [id what want got] (swap! *spec-fails* inc) (println (str "FAIL " id " want " (pr-str want) " got " (pr-str got) " [" what "]")))
boot (defn spec-xpass! [id] (swap! *spec-fails* inc) (println (str "FAIL " id " want failure got pass [xpass]")))
boot (defn spec-class-name [e] (symbol (last (str/split (str (type e)) #"[. ]"))))
boot (defn spec-case! [id thunk expect] (let [out (atom "") result (atom nil) thrown (atom nil) fails (atom [])] (reset! out (with-out-str (try (reset! result (thunk)) (catch Throwable e (reset! thrown e))))) (let [note (fn [what want got] (swap! fails conj [what want got]))] (when (contains? expect :throws) (let [[cls msg] (:throws expect)] (if (nil? @thrown) (note "throws" (:throws expect) @result) (when-not (and (instance? cls @thrown) (= msg (ex-message @thrown))) (note "throws" (:throws expect) [(type @thrown) (ex-message @thrown)]))))) (when (and (not (contains? expect :throws)) @thrown) (note "threw" :no-throw [(spec-class-name @thrown) (ex-message @thrown)])) (when (and (contains? expect :value) (nil? @thrown) (not= (:value expect) @result)) (note "value" (:value expect) @result)) (when (and (contains? expect :out) (not= (:out expect) @out)) (note "out" (:out expect) @out)) (let [bad (seq @fails)] (if (= :fail (:expect expect)) (if bad (println (str "ok " id " # XFAIL")) (spec-xpass! id)) (if bad (doseq [f @fails] (spec-fail! id (nth f 0) (nth f 1) (nth f 2))) (println (str "ok " id))))))))
form => (spec-case! "{id}" (fn [] {form}) {expect})
;=> {v*} => :value '{v*}
;; out: {s*} => :out {s*}
;; throws: {c} {m*} => :throws [{c} {m*}]
;; expect: fail => :expect :fail
;; expect: pass => :expect :pass
epilogue (System/exit (if (zero? @*spec-fails*) 0 1))
