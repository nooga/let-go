;; Generate a Go test package from one namespace of clojure.test deftests.
;; Usage: bin/lg scripts/lg-test-go <tests.lg> <out-dir>
(require 'ir.passes.pipeline 'clojure.string)

(defn die [message]
  (println "lg-test-go:" message)
  (os/exit 1))

;; deftest stores its body in :test metadata, separately from its callable var.
(defn test-bodies [form]
  (let [v (when (seq? form) (nth form 1 nil))
        self (if (and (seq? form) (= 'alter-meta! (first form))
                      (seq? v) (= 'var (first v))
                      (= :test (nth form 3 nil)))
               [[(second v) (nth form 4 nil)]] [])]
    (if (and (seq? form) (= 'do (first form)))
      (reduce into self (map test-bodies form))
      self)))

(def args (vec (drop 2 (seq os/args))))
(when (not= 2 (count args)) (die "usage: lg scripts/lg-test-go <tests.lg> <out-dir>"))
(def fixture (first args))
(def out-dir (second args))
(def forms (read-all-string (slurp fixture)))
(def namespaces (filter (fn [f] (and (seq? f) (= 'ns (first f)))) forms))
(when (not= 1 (count namespaces)) (die "expected exactly one ns form"))
(def target-ns (second (first namespaces)))
(defn analyze [forms]
  (doseq [form forms] (eval form))
  (let [tests (binding [*file* fixture]
                (vec (mapcat (fn [form]
                               (map (fn [[name body]] [name body (:line (meta form))])
                                    (test-bodies (ir.passes.pipeline/expand-all form))))
                             forms)))]
    (eval '(ns user))
    tests))
(def tests (analyze forms))
(when (empty? tests) (die "no deftest bodies found"))
(when (not= (count tests) (count (set (map first tests))))
  (die "duplicate test definitions"))
(doseq [name (keys (ns-interns target-ns))]
  (when (clojure.string/starts-with? (str name) "lg-test-body-")
    (die (str "generated test name collides with namespace var: " name))))
(def adapted
  (mapv (fn [i]
          (let [body (second (nth tests i))]
            (when (or (not= 'fn* (first body)) (not= [] (second body)))
              (die "test metadata must contain a zero-argument function"))
            (apply list 'defn (symbol (str "lg-test-body-" i)) [] (drop 2 body))))
        (range (count tests))))
(defn lower-tests []
  (eval (list 'ns target-ns))
  (doseq [form adapted] (eval form))
  (let [result (ir.passes.pipeline/lower-ns-to-go-result "lgtests" target-ns adapted)]
    (eval '(ns user))
    result))
(def lowered (lower-tests))
(defn test-entry [i]
  (let [source-name (str "lg-test-body-" i)
        matches (filter (fn [f] (= source-name (str (:fn-name f)))) (:fns lowered))]
    (when (not= 1 (count matches)) (die (str "test did not lower: " (first (nth tests i)))))
    (let [f (first matches)
          call (str (:go-name f) "(ec)")]
      (str "{Name: " (pr-str (str (first (nth tests i))))
           ", File: " (pr-str fixture) ", Line: " (or (nth (nth tests i) 2) 0)
           ", Body: func(ec *vm.ExecContext) (vm.Value, error) { "
           (if (:needs-error? f)
             (str "_, err := " call "; return vm.NIL, err")
             (str "_ = " call "; return vm.NIL, nil")) " }},\n"))))
(def entries (apply str (map test-entry (range (count tests)))))
(def wrapper
  (str "// Code generated by lg-test-go; DO NOT EDIT.\npackage lgtests\n"
       "import (\n_ \"embed\"\n\"testing\"\n"
       "\"github.com/nooga/let-go/pkg/clojuretest\"\n\"github.com/nooga/let-go/pkg/vm\"\n)\n"
       "//go:embed tests.lgb\nvar testBundle []byte\n"
       "func TestClojure(t *testing.T) { clojuretest.Run(t, testBundle, " (pr-str (str target-ns))
       ", []clojuretest.Test{\n" entries "}) }\n"))
(let [result (os/sh "mkdir" "-p" out-dir)]
  (when (not= 0 (:exit result)) (die (:err result))))
(let [result (os/sh (first (seq os/args)) "-c" (str out-dir "/tests.lgb") fixture)]
  (when (not= 0 (:exit result)) (die (str (:out result) (:err result)))))
(spit (str out-dir "/bodies.go") (:source lowered))
(spit (str out-dir "/clojure_test.go") wrapper)
(println "lg-test-go: emitted" (count tests) "tests into" out-dir)
