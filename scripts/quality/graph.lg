(ns quality.graph
  "Definition reference graph and static test reachability.

   Definitions are keyed by a qualified `ns/name` symbol derived from each
   source file's `(ns ...)` form (falling back to the file's path when no
   `ns` form is found), so same-named definitions in different namespaces
   (e.g. `join` in two files) never collide or merge.

   A raw symbol reference (bare, alias-qualified, or fully namespace
   qualified) is resolved to a definition in this priority order: (1) an
   exact match against a qualified definition key, (2) the bare name
   qualified by the referencing definition's own namespace, (3) a bare-name
   match that is unique across the whole corpus. An ambiguous bare name
   (more than one definition shares it) resolves to no edge at all, rather
   than guessing.

   This is STATIC analysis: it follows only symbols that appear literally
   in a form. Dynamic dispatch (multimethods invoked by a computed value,
   `resolve`, `eval`, reflection-ish interop) is invisible to it. Coverage
   numbers from this namespace are therefore an UPPER BOUND on what's
   actually exercised, not a measurement of it — a definition can be
   \"reached\" here yet never actually run by the test suite if the only
   caller path is itself dead code, and true dynamic coverage would only
   ever be lower."
  (:require
   [clojure.string :as str]
   [quality.forms :as f]))

(defn references
  "Every symbol occurring anywhere in `form`, as a set. For a qualified
   symbol such as `str/join`, both `str/join` and the bare `join` are
   included, so downstream resolution can try either form."
  [form]
  (letfn [(walk [x acc]
            (cond
              (symbol? x) (conj acc x (symbol (name x)))
              (coll? x) (reduce (fn [a y] (walk y a)) acc (seq x))
              :else acc))]
    (walk form #{})))

(defn- ns-of
  "The symbol named by this text's top-level (ns ...) form, or nil."
  [text]
  (some (fn [seg]
          (let [form (f/read-segment seg)]
            (when (and (seq? form) (= 'ns (first form)) (symbol? (second form)))
              (second form))))
        (f/segments text)))

(defn- qualify [ns-sym name-sym]
  (symbol (str ns-sym "/" name-sym)))

(defn- bare-index
  "bare-name symbol -> #{qname...} across every def, for corpus-wide
   unique-bare-name resolution."
  [all-defs]
  (reduce (fn [m d] (update m (symbol (name (:qname d))) (fnil conj #{}) (:qname d)))
          {} all-defs))

(defn- resolve-ref
  "Resolve a raw reference symbol to a def qname, per the priority order
   documented on the namespace, or nil if it doesn't resolve."
  [sym current-ns defs bidx]
  (cond
    (contains? defs sym) sym
    :else
    (let [bare (symbol (name sym))
          same-ns (when current-ns (qualify current-ns bare))]
      (cond
        (and same-ns (contains? defs same-ns)) same-ns
        :else
        (let [matches (get bidx bare)]
          (when (= 1 (count matches)) (first matches)))))))

(defn build
  "sources = [{:path :text}...] -> {:defs {qname {:path :line :kind}}
                                     :edges {qname #{qname...}}}"
  [sources]
  (let [parsed (for [{:keys [path text]} sources]
                 {:path path :ns (or (ns-of text) (symbol path)) :defs (f/definitions text)})
        all-defs (vec (for [{:keys [path ns defs]} parsed
                            d defs]
                        (assoc d :path path :ns ns :qname (qualify ns (:name d)))))
        defs-map (into {} (map (fn [d] [(:qname d) (select-keys d [:path :line :kind])]) all-defs))
        bidx (bare-index all-defs)]
    {:defs defs-map
     :edges (into {}
                  (map (fn [d]
                         (let [refs (references (:form d))
                               resolved (set (keep #(resolve-ref % (:ns d) defs-map bidx) refs))]
                           [(:qname d) (disj resolved (:qname d))]))
                       all-defs))}))

(defn test-roots
  "tests = [{:path :text}...] -> #{sym...} referenced from deftest bodies
   and top-level is/are forms, as raw (unresolved) symbols."
  [tests]
  (reduce (fn [acc {:keys [text]}]
            (reduce (fn [a seg]
                      (let [form (f/read-segment seg)]
                        (if (and (seq? form) (#{'deftest 'is 'are} (first form)))
                          (into a (references form))
                          a)))
                    acc (f/segments text)))
          #{} tests))

(defn reachable
  "Transitive closure of `roots` over `(:edges graph)`, restricted to
   defs actually present in the graph."
  [graph roots]
  (loop [todo (vec (filter (:defs graph) roots)) seen #{}]
    (if (empty? todo)
      seen
      (let [n (peek todo) todo (pop todo)]
        (if (seen n)
          (recur todo seen)
          (recur (into todo (remove seen (get-in graph [:edges n]))) (conj seen n)))))))

(defn coverage
  "sources vs tests -> {:reached n :total n :percent p
                         :untested [{:name :path :line}...]}
   `deftest` definitions are excluded from the denominator. `:untested`
   is sorted by path then line; `:name` is the bare (unqualified) name."
  [sources tests]
  (let [graph (build sources)
        bidx (bare-index (map (fn [[qname info]] (assoc info :qname qname)) (:defs graph)))
        roots (set (keep #(resolve-ref % nil (:defs graph) bidx) (test-roots tests)))
        reached (reachable graph roots)
        candidates (remove (fn [[_ d]] (= :deftest (:kind d))) (:defs graph))
        total (count candidates)
        hit (count (filter (fn [[n _]] (reached n)) candidates))
        untested (->> candidates
                      (remove (fn [[n _]] (reached n)))
                      (map (fn [[n d]] {:name (symbol (name n)) :path (:path d) :line (:line d)}))
                      (sort-by (juxt :path :line))
                      vec)]
    {:reached hit :total total
     :percent (if (pos? total) (* 100.0 (/ hit (double total))) 100.0)
     :untested untested}))
