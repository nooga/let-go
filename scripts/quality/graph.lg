(ns quality.graph
  "Definition reference graph and static test reachability.

   Definitions are keyed by a qualified `ns/name` symbol derived from each
   source file's `(ns ...)` form (falling back to the file's path when no
   `ns` form is found), so same-named definitions in different namespaces
   (e.g. `join` in two files) never collide or merge.

   A qualified reference resolves only to its exact definition key. A bare
   reference resolves first in the referencing definition's namespace, then
   by a unique bare-name match across the corpus. An ambiguous bare name
   resolves to no edge rather than guessing.

   Before resolution, an `alias/name` reference is rewritten to
   `full.ns/name` using the aliases the referencing FILE establishes via
   its `(ns ... (:require [full.ns :as alias] ...))` clause or any
   top-level `(require '[full.ns :as alias])` form — so an aliased
   reference is tried against its real namespace without a bare-name fallback.
   A name the file brings in with `[full.ns :refer [name]]` is rewritten the
   same way, so a referred bare name stays specific even when several
   namespaces define it. `[full.ns :rename {orig local}]` rewrites `local` to
   `full.ns/orig`, which no other rule could reach: the call site mentions a
   name no definition has.

   `[full.ns :refer :all]` names nothing specific, so it is resolved against
   the corpus instead: a bare name becomes `full.ns/name` when exactly one
   wholesale-referred namespace defines it. Zero matches leave the symbol
   alone, so a `:refer :all` does not swallow every bare name in the file, and
   two matches leave it alone as well -- the ambiguous-bare-name rule above
   applies to wholesale referral too, and the reference resolves to no edge
   rather than to a guess. An explicit `:refer`/`:rename` is the more specific
   statement and wins over a wholesale one.

   This is STATIC analysis: it follows only symbols that appear literally
   in a form. Dynamic dispatch (multimethods invoked by a computed value,
   `resolve`, `eval`, reflection-ish interop) is invisible to it. Coverage
   numbers from this namespace are therefore an UPPER BOUND on what's
   actually exercised, not a measurement of it — a definition can be
   \"reached\" here yet never actually run by the test suite if the only
   caller path is itself dead code, and true dynamic coverage would only
   ever be lower."
  (:require
   [clojure.string :as str]
   [quality.forms :as f]))

(defn references
  "Every symbol occurring anywhere in `form`, as a set. Qualified symbols
   retain their namespace: `str/join` must not also imply a local `join`."
  [form]
  (letfn [(walk [x acc]
            (cond
              (symbol? x) (conj acc x)
              (coll? x) (reduce (fn [a y] (walk y a)) acc (seq x))
              :else acc))]
    (walk form #{})))

(defn- ns-of
  "The symbol named by this text's top-level (ns ...) form, or nil."
  [text]
  (some (fn [seg]
          (let [form (f/read-segment seg)]
            (when (and (seq? form) (= 'ns (first form)) (symbol? (second form)))
              (second form))))
        (f/segments text)))

(defn- path-ns
  "The namespace symbol to use for a file with no `(ns ...)` form -- most
   scripts. Slashes become dots: a symbol built straight from the path would
   split at its FIRST slash, so `(name 'scripts/sort-defns.lg/sort-file)`
   would be `sort-defns.lg/sort-file` rather than `sort-file`, and every
   bare-name resolution against that definition would silently fail."
  [path]
  (symbol (str/replace path #"/" ".")))

(defn- qualify [ns-sym name-sym]
  (symbol (str ns-sym "/" name-sym)))

(defn- unquote-entry
  "Strip a (quote x) wrapper from a require arg, e.g. from
   (require '[full.ns :as alias])."
  [x]
  (if (and (seq? x) (= 'quote (first x))) (second x) x))

(defn- entry-option
  "The value following `k` in a [full.ns :k v ...] require entry, or nil."
  [entry k]
  (let [n (count entry)]
    (loop [i 1]
      (cond
        (>= (inc i) n) nil
        (= k (nth entry i)) (nth entry (inc i))
        :else (recur (inc i))))))

(defn- entry-alias
  "A [full.ns :as alias] (or bare-symbol, or :refer-only) require entry ->
   [alias full-ns] pair, or nil when the entry declares no :as alias."
  [entry]
  (let [entry (unquote-entry entry)]
    (when (vector? entry)
      (when-let [alias (entry-option entry :as)]
        [alias (first entry)]))))

(defn- entry-refers
  "A [full.ns :refer [a b]] require entry -> [[a full-ns] [b full-ns]].
   `:refer :all` names nothing specific, so it maps nothing here -- see
   `entry-refer-all`."
  [entry]
  (let [entry (unquote-entry entry)]
    (when (vector? entry)
      (let [names (entry-option entry :refer)]
        (when (sequential? names)
          (map (fn [sym] [sym (first entry)]) (filter symbol? names)))))))

(defn- entry-refer-all
  "The namespace a [full.ns :refer :all] entry refers wholesale, or nil."
  [entry]
  (let [entry (unquote-entry entry)]
    (when (and (vector? entry) (= :all (entry-option entry :refer)))
      (first entry))))

(defn- entry-renames
  "A [full.ns :rename {orig local}] require entry -> [[local full.ns/orig]...].
   The mapping is LOCAL name -> the qualified definition it stands for; the
   local name exists nowhere else, so nothing else can resolve it."
  [entry]
  (let [entry (unquote-entry entry)]
    (when (vector? entry)
      (let [m (entry-option entry :rename)]
        (when (map? m)
          (keep (fn [[orig local]]
                  (when (and (symbol? orig) (symbol? local))
                    [local (qualify (first entry) orig)]))
                m))))))

(defn- require-entries
  "The require entries a single top-level form declares: the ns form's
   (:require ...) clause, or a top-level (require ...) call's args."
  [form]
  (cond
    (and (seq? form) (= 'ns (first form)))
    (mapcat (fn [clause] (when (and (seq? clause) (= :require (first clause))) (rest clause)))
            (filter seq? (drop 2 form)))
    (and (seq? form) (= 'require (first form)))
    (rest form)
    :else nil))

(defn- file-aliases
  "What this file's (ns ...) :require clause and top-level (require ...) forms
   establish:

     {:as {alias full-ns} :refer {name full-ns}
      :rename {local full.ns/orig} :refer-all #{full-ns}}

   A referred or renamed name is as specific as an alias: `[a :refer [foo]]`
   makes bare `foo` mean `a/foo` even when another namespace also defines
   `foo`, and `[a :rename {foo renamed}]` makes `renamed` mean `a/foo`.
   `:refer-all` is the set of namespaces referred wholesale; those name
   nothing by themselves and are resolved against the corpus's definitions
   (see `rewrite-aliased`)."
  [text]
  (reduce (fn [m seg]
            (let [form (f/read-segment seg)]
              (reduce (fn [m2 entry]
                        (let [pair (entry-alias entry)
                              m2 (if pair (assoc-in m2 [:as (first pair)] (second pair)) m2)
                              m2 (if-let [all (entry-refer-all entry)]
                                   (update m2 :refer-all conj all)
                                   m2)
                              m2 (reduce (fn [m3 [sym full]] (assoc-in m3 [:rename sym] full))
                                         m2 (entry-renames entry))]
                          (reduce (fn [m3 [sym full]] (assoc-in m3 [:refer sym] full))
                                  m2 (entry-refers entry))))
                      m (require-entries form))))
          {:as {} :refer {} :rename {} :refer-all #{}} (f/segments text)))

(defn- refer-all-match
  "The single wholesale-referred namespace that defines bare `sym`, or nil.
   Zero matches mean the name came from somewhere else and the symbol is left
   alone; two or more mean the reference is ambiguous, and the ambiguous-bare-
   name rule resolves it to nothing rather than to a guess. A definition the
   referencing namespace makes itself shadows a wholesale import, as it does
   at runtime, so `self-ns` is checked first."
  [sym aliases defs self-ns]
  (when (and defs (seq (:refer-all aliases))
             (not (and self-ns (contains? defs (qualify self-ns sym)))))
    (let [hits (vec (filter #(contains? defs (qualify % sym)) (:refer-all aliases)))]
      (when (= 1 (count hits)) (qualify (first hits) sym)))))

(defn- rewrite-aliased
  "sym rewritten to its full namespace: alias/name via the file's :as aliases,
   a bare renamed or referred name via its :rename/:refer, and otherwise a
   bare name defined by exactly one wholesale-referred namespace. Unchanged
   when none applies. `defs` is the corpus's definition map, which only the
   `:refer :all` case needs; nil disables that case."
  [sym aliases defs self-ns]
  (let [nsp (namespace sym)]
    (cond
      (and nsp (contains? (:as aliases) (symbol nsp)))
      (symbol (str (get-in aliases [:as (symbol nsp)]) "/" (name sym)))
      nsp sym
      (contains? (:rename aliases) sym) (get-in aliases [:rename sym])
      (contains? (:refer aliases) sym)
      (symbol (str (get-in aliases [:refer sym]) "/" (name sym)))
      :else (or (refer-all-match sym aliases defs self-ns) sym))))

(defn- references-aliased
  "references, with each known alias, referred, renamed or wholesale-referred
   name rewritten to its full namespace."
  ([form aliases] (references-aliased form aliases nil nil))
  ([form aliases defs] (references-aliased form aliases defs nil))
  ([form aliases defs self-ns]
   (let [refs (references form)]
     (if (and (empty? (:as aliases)) (empty? (:refer aliases))
              (empty? (:rename aliases))
              (or (nil? defs) (empty? (:refer-all aliases))))
       refs
       (set (map #(rewrite-aliased % aliases defs self-ns) refs))))))

(defn- bare-index
  "bare-name symbol -> #{qname...} across every def, for corpus-wide
   unique-bare-name resolution."
  [all-defs]
  (reduce (fn [m d] (update m (symbol (name (:qname d))) (fnil conj #{}) (:qname d)))
          {} all-defs))

(defn- resolve-ref
  "Resolve a raw reference symbol to a def qname, per the priority order
   documented on the namespace, or nil if it doesn't resolve."
  [sym current-ns defs bidx]
  (cond
    (contains? defs sym) sym
    (namespace sym) nil
    :else
    (let [bare (symbol (name sym))
          same-ns (when current-ns (qualify current-ns bare))]
      (cond
        (and same-ns (contains? defs same-ns)) same-ns
        :else
        (let [matches (get bidx bare)]
          (when (= 1 (count matches)) (first matches)))))))

(defn build
  "sources = [{:path :text}...] -> {:defs {qname {:path :line :kind}}
                                     :edges {qname #{qname...}}}"
  [sources]
  (let [parsed (for [{:keys [path text]} sources]
                 {:path path :ns (or (ns-of text) (path-ns path))
                  :aliases (file-aliases text) :defs (f/definitions text)})
        all-defs (vec (for [{:keys [path ns aliases defs]} parsed
                            d defs]
                        (assoc d :path path :ns ns :aliases aliases :qname (qualify ns (:name d)))))
        defs-map (into {} (map (fn [d] [(:qname d) (select-keys d [:path :line :kind])]) all-defs))
        bidx (bare-index all-defs)]
    {:defs defs-map
     :edges (into {}
                  (map (fn [d]
                         (let [refs (references-aliased (:form d) (:aliases d) defs-map (:ns d))
                               resolved (set (keep #(resolve-ref % (:ns d) defs-map bidx) refs))]
                           [(:qname d) (disj resolved (:qname d))]))
                       all-defs))}))

(defn test-roots
  "tests = [{:path :text}...] -> #{sym...} referenced from deftest bodies
   and top-level is/are forms, as raw (unresolved) symbols. `defs` is the
   corpus's definition map; pass it so `:refer :all` imports resolve (see
   `rewrite-aliased`), omit it when the caller has no graph yet."
  ([tests] (test-roots tests nil))
  ([tests defs]
   (reduce (fn [acc {:keys [text]}]
             (let [aliases (file-aliases text)]
               (reduce (fn [a seg]
                         (let [form (f/read-segment seg)]
                           (if (and (seq? form) (#{'deftest 'is 'are} (first form)))
                             (into a (references-aliased form aliases defs))
                             a)))
                       acc (f/segments text))))
           #{} tests)))

(defn reachable
  "Transitive closure of `roots` over `(:edges graph)`, restricted to
   defs actually present in the graph."
  [graph roots]
  (loop [todo (vec (filter (:defs graph) roots)) seen #{}]
    (if (empty? todo)
      seen
      (let [n (peek todo) todo (pop todo)]
        (if (seen n)
          (recur todo seen)
          (recur (into todo (remove seen (get-in graph [:edges n]))) (conj seen n)))))))

(defn resolve-symbols
  "Raw symbols resolved to definition keys of `graph`, dropping what does not
   resolve. Public so callers can build their own root sets -- `reachable` is
   generic over roots, and production reachability is the same closure from a
   different starting point than test reachability."
  [graph syms]
  (let [defs (:defs graph)
        bidx (bare-index (map (fn [[qname info]] (assoc info :qname qname)) defs))]
    (set (keep #(resolve-ref % nil defs bidx) syms))))

(def ^:private def-heads-set #{'defn 'defn- 'defmacro 'defmethod 'deftest 'def})

(defn top-level-refs
  "Symbols referenced by the top-level NON-definition forms of `sources` --
   a script's entry point, a registry registration, a dispatch table built at
   load time. These are references the edge builder does not see, because it
   only walks definitions, and they are exactly what makes a script's or a
   registry's callees reachable. `defs` is the corpus's definition map; pass
   it so `:refer :all` imports resolve, omit it when there is no graph yet."
  ([sources] (top-level-refs sources nil))
  ([sources defs]
   (reduce (fn [acc {:keys [path text]}]
             (let [aliases (file-aliases text)
                   self-ns (or (ns-of text) (path-ns path))]
               (reduce (fn [a seg]
                         (let [form (f/read-segment seg)]
                           (if (and (seq? form) (def-heads-set (first form)))
                             a
                             (into a (references-aliased form aliases defs self-ns)))))
                       acc (f/segments text))))
           #{} sources)))

(defn entry-roots
  "Production roots contributed by each source's own top-level
   NON-definition forms -- a script's entry call, a registry registration, a
   dispatch table built at load time.

   Each file's references are resolved with that FILE's namespace preferred,
   which matters more than it sounds: two scripts both defining `do-check`
   make the bare name ambiguous corpus-wide, and the ambiguity rule then
   resolves it to nothing, so each script's own entry point would look
   unreachable."
  [graph sources]
  (let [defs (:defs graph)
        bidx (bare-index (map (fn [[qname info]] (assoc info :qname qname)) defs))]
    (set (mapcat (fn [{:keys [path text]}]
                   (let [ns (or (ns-of text) (path-ns path))
                         aliases (file-aliases text)]
                     (keep #(resolve-ref % ns defs bidx)
                           (reduce (fn [a seg]
                                     (let [form (f/read-segment seg)]
                                       (if (and (seq? form) (def-heads-set (first form)))
                                         a
                                         (into a (references-aliased form aliases defs ns)))))
                                   #{} (f/segments text)))))
                 sources))))

(defn public?
  "Whether a definition is part of its namespace's public surface.
   `defn-` is private, and so is anything carrying ^:private metadata --
   which `quality.forms` records as the definition's `:private?`."
  [d]
  (not (or (= :defn- (:kind d)) (:private? d))))

(defn coverage
  "sources vs tests -> {:reached n :total n :percent p
                         :untested [{:name :qname :path :line}...]}
   `deftest` definitions are excluded from the denominator. `:untested`
   is sorted by path then line; `:name` is the bare (unqualified) name and
   `:qname` the qualified `ns/name` -- a bare name alone is ambiguous when
   several namespaces define it, so human surfaces should print `:qname`."
  [sources tests]
  (let [graph (build sources)
        bidx (bare-index (map (fn [[qname info]] (assoc info :qname qname)) (:defs graph)))
        roots (set (keep #(resolve-ref % nil (:defs graph) bidx)
                         (test-roots tests (:defs graph))))
        reached (reachable graph roots)
        candidates (remove (fn [[_ d]] (= :deftest (:kind d))) (:defs graph))
        total (count candidates)
        hit (count (filter (fn [[n _]] (reached n)) candidates))
        untested (->> candidates
                      (remove (fn [[n _]] (reached n)))
                      (map (fn [[n d]] {:name (symbol (name n)) :qname n
                                        :path (:path d) :line (:line d)}))
                      (sort-by (juxt :path :line))
                      vec)]
    {:reached hit :total total
     ;; No definitions at all means nothing to be covered: the percentage is
     ;; undefined (nil), so the corpus term is omitted rather than reported
     ;; as a vacuous 100%.
     :percent (when (pos? total) (* 100.0 (/ hit (double total))))
     :untested untested}))
