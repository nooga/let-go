(ns quality.report
  "Rendering only: a measured result map in, deterministic text or EDN out.

   `text` and `edn` are pure functions of the map `quality/measure` builds;
   they compute nothing and read nothing. Ordering is fixed by the
   producer (files by path, issues by impact, top-complexity by cc), so
   two runs over the same inputs render byte-identical output."
  (:require
   [clojure.string :as str]
   [quality.score :as score]))

(defn- n1 [v] (if (nil? v) "-" (format "%.1f" (double v))))
(defn- n2 [v] (if (nil? v) "-" (format "%.2f" (double v))))

(defn- pad [s w]
  (let [s (str s)]
    (if (>= (count s) w) s (str s (apply str (repeat (- w (count s)) " "))))))

(defn- lpad [s w]
  (let [s (str s)]
    (if (>= (count s) w) s (str (apply str (repeat (- w (count s)) " ")) s))))

(defn- measure-str
  "An issue's measure: integers verbatim, fractions to two decimals."
  [v]
  (if (integer? v) (str v) (n2 v)))

(defn header
  "The provenance block: what this report was measured against. Every
   external input is pinned -- the commit, the resolved git range, the
   coverprofile's content hash, the CI duration's source -- and the two
   caveat lines say how duplication share and coverage are derived."
  [{:keys [inputs omitted]}]
  (let [{:keys [commit commit-source git-range go-cover ci paths source-roots corpus]} inputs]
    [(str "commit " (if (str/blank? commit) "unknown" commit)
          (if commit-source (str " (" commit-source ")") ""))
     (str "git-range " (:since git-range) " "
          (if (str/blank? (:from git-range)) "(root)" (:from git-range))
          ".." (:to git-range))
     (str "go-cover " (if go-cover
                        (str (:path go-cover) " sha256=" (:sha256 go-cover))
                        "none"))
     (str "ci " (if ci (str (:source ci) " " (:seconds ci) "s") "none"))
     (str "paths " (str/join " " paths))
     (str "source-roots " (if (seq source-roots) (str/join " " source-roots) "none"))
     (str "corpus " (:files corpus) " files tracked-by " (:tracked-by corpus))
     (str "omitted " (pr-str omitted))
     (str "dup-share by lines: regions are matched on TOKENS and reported on the "
          "lines their first and last token fall on (a boundary approximation), "
          "then unioned per file")
     "defects: renames credited to target via -M"
     (str "coverage lg=static go=" (if go-cover "dynamic" "none"))
     (str "debt: 0 is perfect (every metric at or better than its good "
          "threshold), 100 is every metric exactly at its bad threshold, "
          "lower is better, unbounded above")
     (str "caveat: static coverage is an upper bound "
          "(dynamic dispatch followed only through literal symbols)")
     "caveat: efficiency couples coverage to CI time; deleting slow tests lowers it"]))

(defn- debt-block [{total :debt :keys [terms coverage testing]}]
  ;; Display order only (names, not numbers); any future term in
  ;; `thresholds` that isn't listed here still prints, after these.
  (let [preferred [:files :coverage :efficiency :testing]
        known (set (map first (:corpus-weights score/thresholds)))
        order (concat (filter known preferred)
                      (sort (remove (set preferred) known)))]
    (concat
      [(str "debt " (n1 total))]
      (for [k order]
        (str "  " (pad (name k) 12) (lpad (n1 (terms k)) 6)))
      [(str "  coverage lg=" (n1 (get-in coverage [:lg :percent])) "% static"
            " go=" (if (:go coverage) (str (n1 (get-in coverage [:go :percent])) "% dynamic") "none"))
       (str "  testing density=" (n1 (:density testing)) "/KLOC"
            " ratio=" (n2 (:ratio testing))
            " assertions=" (:assertions testing))])))

(defn- file-table
  "The per-file table, in the order the producer fixed: debt DESCENDING
   (worst first), ties broken by path.

   EVERY column is DEBT (`quality.score/file-debt`'s `:cc :mi :dup
   :defects` and their weighted `:debt`), not the measurement behind it, so
   all of them run the same direction -- 0 at perfect, lower is better, no
   upper bound -- and a row, or the same row across two runs, reads without
   the reader having to remember which metrics invert. The raw measurements live where they are pointers
   rather than scores: the issues list and the top-complexity table (and,
   unchanged, the EDN). `cc`/`mi` read `-` for Go, whose complexity and
   maintainability are out of scope."
  [files]
  (concat
    ["" "files (all columns are debt: 0 is perfect, lower is better, unbounded above)"
     (str (pad "path" 56) (lpad "debt" 10) (lpad "cc" 8) (lpad "mi" 8)
          (lpad "dup" 8) (lpad "defects" 9))]
    (for [f files]
      (str (pad (:path f) 56) (lpad (n1 (:debt f)) 10) (lpad (n1 (:cc f)) 8)
           (lpad (n1 (:mi f)) 8) (lpad (n1 (:dup f)) 8)
           (lpad (n1 (:defects f)) 9)))))

(defn- issue-at
  "`path:line`, or `path:start-end` for an issue that spans lines (a
   duplicated region), so the reader sees how much code it covers."
  [i]
  (str (:path i) ":" (:line i)
       (if (and (:end i) (not= (:end i) (:line i))) (str "-" (:end i)) "")))

(defn- issue-lines [issues]
  (concat
    ["" (str "issues " (count issues) " (count; lower is better, same direction as debt, "
             "ranked by debt impact)")]
    (for [i issues]
      (str (pad (issue-at i) 56) (pad (name (:kind i)) 15)
           (pad (measure-str (:measure i)) 8) (:hint i)))))

(defn- top-lines
  "The most complex definitions. Unlike the files table these are RAW
   measurements, where higher means worse -- said so in the section header
   so the two tables are never read the same way."
  [top]
  (concat
    ["" (str "top complexity " (count top) " (raw measurements; higher is worse)")
     (str (pad "path:line" 56) (pad "name" 28) (lpad "cc" 5) (lpad "depth" 7) (lpad "lines" 7))]
    (for [t top]
      (str (pad (str (:path t) ":" (:line t)) 56) (pad (:name t) 28)
           (lpad (:cc t) 5) (lpad (:depth t) 7) (lpad (:lines t) 7)))))

(defn text
  "The full text report: header, debt block, file table (debt descending),
   ranked issues, then the most complex definitions."
  [result]
  (str (str/join "\n"
                 (concat (header result)
                         [""]
                         (debt-block result)
                         (file-table (:files result))
                         (issue-lines (:issues result))
                         (top-lines (:top-complexity result))))
       "\n"))

(defn edn
  "The same data for machines: the whole result map as one readable form."
  [result]
  (str (pr-str result) "\n"))
