(ns quality.dup
  "Winnowing (Schleimer, Wilkerson, Aiken) over normalized tokens: k-gram
   hashes, window minima, shared-fingerprint regions between and within
   files.")

(defn- kgram-hashes [tokens k]
  (let [ts (mapv :t tokens) n (count ts)]
    (vec (for [i (range 0 (max 0 (inc (- n k))))]
           {:hash (hash (subvec ts i (+ i k))) :pos i}))))

(defn fingerprints [tokens k w]
  (let [hs (kgram-hashes tokens k) n (count hs)]
    (if (< n w)
      (vec (distinct hs))
      (loop [i 0 last nil out []]
        (if (> (+ i w) n)
          out
          (let [win (subvec hs i (+ i w))
                m (reduce (fn [a b] (if (<= (:hash b) (:hash a)) b a)) win)]
            (recur (inc i) m (if (= m last) out (conj out m)))))))))

(defn- kgram-index
  "hash -> sorted vec of k-gram start positions, from the full (non-winnowed)
   k-gram hash list."
  [tokens k]
  (reduce (fn [m {:keys [hash pos]}] (update m hash (fnil conj []) pos))
          {} (kgram-hashes tokens k)))

(defn- self-overlap?
  "Whether a self-match region's two sides overlap once each k-gram's window
   is taken into account -- i.e. the \"copy\" is really the same text."
  [r k]
  (and (<= (:a-from r) (+ (:b-to r) k -1))
       (<= (:b-from r) (+ (:a-to r) k -1))))

(defn- cross-shared
  "Distinct-hash matches between two different files. A hash with multiple
   occurrences in one or both files contributes `min(count-in-a,
   count-in-b)` pairs (positions zipped in index order), never a cross
   product -- so `shared` never exceeds either file's total k-gram count,
   and `similarity` stays bounded by 1.0."
  [kix-a kix-b]
  (vec (mapcat (fn [[h pas]]
                 (when-let [pbs (get kix-b h)]
                   (map vector (repeat h) pas (take (count pas) pbs))))
               kix-a)))

(defn- self-shared
  "Distinct-hash matches within one file: a copy-paste duplicate. Only
   hashes with at least two occurrences separated by >= k positions count
   (closer repeats are just the same occurrence's overlapping k-gram
   windows, not a second copy); the earliest and latest occurrence are
   used as the pair's representative positions, one pair per hash."
  [kix k]
  (vec (keep (fn [[h ps]]
               (when (> (count ps) 1)
                 (let [pmin (apply min ps) pmax (apply max ps)]
                   (when (>= (- pmax pmin) k)
                     [h pmin pmax]))))
             kix)))

(defn- aligned-regions
  "Group [hash pos-a pos-b] matches into ALIGNED regions: walking the matches
   in pos-a order, a match extends the current region only when BOTH sides
   advance by no more than `k` positions, so two files that share two
   separate blocks yield two regions (and a block pair whose order is swapped
   between the files does too, because side B jumps). Each region carries
   `:n`, the number of matched k-grams inside it.

   Aligning by the matches themselves -- rather than grouping each side's
   positions independently and pairing the results by index -- is what makes
   a region in A name the region in B it actually matches."
  [matches k]
  (reduce (fn [rs [_ pa pb]]
            (let [r (peek rs)
                  da (when r (- pa (:a-to r)))
                  db (when r (- pb (:b-to r)))]
              (if (and r (<= da k) (<= db k) (>= db (- k)))
                (conj (pop rs) (assoc r :a-to (max (:a-to r) pa)
                                      :b-to (max (:b-to r) pb)
                                      :n (inc (:n r))))
                (conj rs {:a-from pa :a-to pa :b-from pb :b-to pb :n 1}))))
          [] (sort-by second matches)))

(defn- token-line
  "The source line of the token at `pos` (clamped to the last token)."
  [f pos]
  (:line (nth (:tokens f) (min pos (dec (count (:tokens f)))))))

(defn pairs
  "EVERY near-duplicate region pair across `files` ([{:path :tokens}...]) --
   one record per matched region, not one per file pair, so a file that
   shares two separate blocks with another reports both with their own line
   spans and their own similarity.

   `k` = k-gram size in tokens, `w` = winnowing window (k-grams), `floor` =
   minimum number of matched k-grams a REGION must carry to be reported.
   `floor` is a token-run threshold in disguise: winnowing guarantees at
   least one shared fingerprint for any contiguous run of `w + k - 1` or more
   identical tokens between two files, so `floor` matched k-grams corresponds
   to roughly `floor + k - 1` contiguous duplicated tokens when the region is
   one unbroken run (e.g. floor=50, k=25 => a ~74-token run).
   `fingerprints` (winnowed, sparse) is used only as a cheap pre-filter --
   pairs whose fingerprint hash sets don't intersect at all are skipped
   before the exact comparison runs. Because winnowing only guarantees
   coverage for runs of >= w+k-1 tokens, a pair whose only shared code is
   several *short*, scattered matches (each below that length) may be missed
   by the pre-filter even though the raw k-gram overlap exists; this is
   winnowing's documented trade-off (sparse index, not exhaustive recall on
   fragmented matches), not a bug in the exact counts that follow.

   Once a candidate pair clears the pre-filter, matches come from the full
   (non-winnowed) k-gram hash index -- an O(tokens) hash-map lookup, not a
   nested scan over every position pair. The two paths count differently,
   deliberately: `cross-shared` (two different files) counts MIN-MULTIPLICITY
   matches, zipping a hash's occurrences in A against its occurrences in B so
   a repetitive file cannot cross-multiply; `self-shared` (one file against
   itself) counts one match per DISTINCT hash, using that hash's earliest and
   latest occurrence as the copy's two representative positions.

   `:shared` is the region's matched-k-gram count and `:similarity` is
   `shared / min(region-kgrams-a, region-kgrams-b)`, which is always in
   [0, 1] because a sum of per-hash minimums cannot exceed either side's
   position count inside the region; two identical files score 1.0.

   Per-FILE duplication is the union of all these regions' lines -- see
   `file-percent`, which is the aggregate view of what this function reports
   region by region.

   Same-file (`i = j`) self-pairs are reported too -- a copy-paste duplicate
   inside one file is still duplication -- and a self-region whose two sides
   overlap is dropped rather than reported."
  [files k w floor]
  (let [prepped (mapv (fn [f]
                        (let [kix (kgram-index (:tokens f) k)]
                          (assoc f
                                 :fps (fingerprints (:tokens f) k w)
                                 :kix kix
                                 :nk (reduce + 0 (map count (vals kix))))))
                  files)
        n (count prepped)]
    (->> (for [i (range n)
               :let [a (nth prepped i)
                     ha (set (map :hash (:fps a)))]
               j (range i n)
               :let [b (nth prepped j)]
               :when (or (= i j) (some ha (map :hash (:fps b))))
               :let [matches (if (= i j)
                               (self-shared (:kix a) k)
                               (cross-shared (:kix a) (:kix b)))]
               :when (seq matches)
               r (aligned-regions matches k)
               :when (>= (:n r) floor)
               :when (or (not= i j) (not (self-overlap? r k)))
               :let [span-a (- (:a-to r) (:a-from r) -1)
                     span-b (- (:b-to r) (:b-from r) -1)]]
           {:a {:path (:path a) :start (token-line a (:a-from r))
                :end (token-line a (+ k -1 (:a-to r)))}
            :b {:path (:path b) :start (token-line b (:b-from r))
                :end (token-line b (+ k -1 (:b-to r)))}
            :shared (:n r)
            :similarity (min 1.0 (/ (double (:n r)) (max 1 (min span-a span-b))))})
         ;; realized before sorting, then ordered for determinism
         vec
         (sort-by (juxt #(get-in % [:a :path]) #(get-in % [:a :start])
                        #(get-in % [:b :path]) #(get-in % [:b :start])))
         vec)))

(defn merge-spans
  "`spans` ([from to], inclusive) merged into disjoint, ascending spans.
   Overlapping and adjacent spans become one, so a file matched by many
   partners over the same region is never charged for that region twice."
  [spans]
  (loop [ss (vec (sort-by first spans)) from nil to nil out []]
    (if (empty? ss)
      (if from (conj out [from to]) out)
      (let [[s e] (first ss)]
        (cond
          (nil? from) (recur (rest ss) s (max s e) out)
          (<= s (inc to)) (recur (rest ss) from (max to e) out)
          :else (recur (rest ss) s (max s e) (conj out [from to])))))))

(defn- union-lines
  "Total number of distinct lines covered by `spans`."
  [spans]
  (reduce + 0 (map (fn [[f t]] (inc (- t f))) (merge-spans spans))))

(defn- file-spans
  "Every reported region span belonging to `path`, from both sides of every
   pair (a self-pair contributes both of its sides)."
  [path pairs]
  (vec (concat
         (for [p pairs :when (= path (get-in p [:a :path]))]
           [(get-in p [:a :start]) (get-in p [:a :end])])
         (for [p pairs :when (= path (get-in p [:b :path]))]
           [(get-in p [:b :start]) (get-in p [:b :end])]))))

(defn duplicated-lines
  "{path n...} -- for each file, the number of its TOKEN-BEARING lines that
   fall inside at least one reported duplicate region, after the union.

   Token-bearing, because a region's span includes whatever blank and
   comment lines sit inside it and those are not code. Raw count, not a
   percentage: the caller divides by the file's own LOC (the same LOC the
   rest of the report uses) rather than by the last token's line number,
   which is what `file-percent` approximates with."
  [files pairs]
  (into {}
        (for [f files]
          (let [token-lines (set (map :line (:tokens f)))
                spans (merge-spans (file-spans (:path f) pairs))]
            [(:path f)
             (reduce + 0 (map (fn [[from to]]
                                (count (filter token-lines (range from (inc to)))))
                              spans))]))))

(defn file-percent
  "Approximates each file's duplicated share as the UNION of its reported
   region lines over its total token-bearing lines (dup % by lines), not by
   raw token count.

   The union matters: a file that matches many partners over the same lines
   -- a common shape for a widely-copied helper -- would otherwise have each
   partner's span added separately and saturate at 100% while no single pair
   covered more than a sliver."
  [files pairs]
  (into {}
        (for [f files]
          (let [covered (union-lines (file-spans (:path f) pairs))
                ;; A file with no tokens (empty, or nothing but comments)
                ;; has no last token to read a line number from.
                total-lines (max 1 (or (:line (last (:tokens f))) 0))]
            [(:path f) (* 100.0 (/ (min covered total-lines) (double total-lines)))]))))
