(ns quality.score
  "Thresholds, weights, and the pure arithmetic that turns measured numbers
   into DEBT.

   Debt is 0 when a metric sits at (or better than) its `good` threshold,
   100 when it sits exactly at its `bad` threshold, and it keeps growing
   past that -- there is no upper clamp. That is the whole point: a clamp
   at the bad end makes complexity 30 and complexity 200 score identically,
   so fixing the worst file in the repo registers as no change. Lower is
   better, 0 is perfect, and there is no credit (no negative debt) for
   beating a threshold.

   Every constant the report depends on lives in `thresholds` -- nothing
   else in the tool hardcodes a number. All other functions here are pure
   functions of numbers already measured by `quality.metrics`,
   `quality.dup`, `quality.graph`, and `quality.inputs`.")

(def thresholds
  "The single source of every threshold and weight.

   `:cc`/`:mi`/`:coverage`/`:efficiency`/`:density`/`:ratio` are `penalty`
   good/bad pairs, read as \"good = zero debt, bad = 100 debt points\" (the
   pair is signed, so it states the metric's direction too: `:cc` 10 -> 30
   is higher-is-worse, `:density` 40 -> 4 is higher-is-better);
   `:dup`/`:defects` are already debt-shaped -- per-point times the measured
   value, 0 at 0, unbounded above;
   `:issues` are issue triggers; `:dup-k`/`:dup-w`/`:dup-floor` are the
   winnowing parameters handed to `quality.dup/pairs`; the two weight maps
   combine per-file scores and corpus terms."
  {:cc {:good 10 :bad 30}
   ;; Raw SEI MI is unbounded below (this repo has files at -229), so the
   ;; pair gives those files real debt instead of flattening them onto the
   ;; same floor as a file at MI 0.
   :mi {:good 100 :bad 0}
   :coverage {:good 100 :bad 0}
   :dup {:per-point 2.0}
   :defects {:per-point 20.0}
   :efficiency {:good 20.0 :bad 2.0}
   :density {:good 40.0 :bad 4.0}
   :ratio {:good 1.0 :bad 0.1}
   :issues {:cc 10 :nesting 6 :long-defn 60 :low-comment 0.05
            :low-comment-min-loc 100 :hotspot-percentile 0.9}
   ;; How much each issue is estimated to move the debt. `:cc-span` is the
   ;; complexity distance (past the trigger) worth a full term weight;
   ;; `:low-comment`/`:hotspot` are fractions of their term weight; the rest
   ;; are flat, because `nesting`/`long-defn` feed issues only and
   ;; `untested` is already counted by the coverage term.
   :impact {:cc-span 20.0 :nesting 0.05 :long-defn 0.05
            :low-comment 0.1 :hotspot 0.2 :untested 0.02}
   ;; Erosion's high-complexity threshold, from the paper: a callable counts
   ;; as high-complexity when CC is STRICTLY above it.
   :erosion {:cc 10}
   ;; Namespaces whose PUBLIC surface is called by users the graph cannot
   ;; see, so their public definitions are production roots.
   :lib-roots ["pkg/rt/core/"]
   :dup-k 25 :dup-w 40 :dup-floor 50
   ;; Below this many LOC a single fix commit implies an absurd per-KLOC
   ;; rate (one fix in a 9-line stub reads as 111/KLOC), so the defects term
   ;; is omitted for the file rather than scored off a meaningless rate.
   :defects-min-loc 20
   ;; A faint pair still counts toward dup%, but only a substantial one is
   ;; worth a `duplicate` issue line telling someone to go look.
   :dup-issue-min-similarity 0.3
   :top-default 20
   :since-days 180
   :file-weights {:cc 0.35 :mi 0.30 :dup 0.20 :defects 0.15}
   :corpus-weights {:files 0.60 :coverage 0.10 :efficiency 0.15 :testing 0.15}})

(defn penalty
  "Debt points for `v` against a good/bad pair: 0 at `good`-or-better,
   100 at `bad`, and linearly onward past `bad` with NO upper clamp.

       100 * max(0, (v - good) / (bad - good))

   `(bad - good)` is signed, so one formula serves both directions:
   `(penalty 50 10 30)` is 200 (complexity, higher is worse) and
   `(penalty 0 40 4)` is 111 (assertion density, higher is better). The
   clamp is on the good side only -- beating a threshold earns no credit,
   because there is no such thing as negative debt."
  [v good bad]
  (* 100.0 (max 0.0 (/ (- (double v) good) (- bad good)))))

(defn- floor0 [v] (max 0.0 (double v)))

(defn- weighted-mean
  "Weighted mean of the present (non-nil) values in `vals` under `weights`,
   with the remaining weights renormalized, or nil when nothing is present.

   A MEAN, never a sum: debt has to stay a DENSITY so that adding good code
   does not increase it and deleting bad code lowers it. It is still
   unbounded, because a single terrible member is unbounded."
  [vals weights]
  (let [present (filter (fn [[k _]] (some? (vals k))) weights)
        wsum (reduce + 0.0 (map second present))]
    (when (pos? wsum)
      (/ (reduce + 0.0 (map (fn [[k w]] (* w (double (vals k)))) present)) wsum))))

(defn file-debt
  "{:cc-max :mi :dup-pct :defects-per-kloc} -> the four metric debts plus
   their weighted `:debt`. Every value is 0-at-perfect, lower-is-better and
   unbounded above.

   `:mi` arrives RAW from `quality.metrics/file-metrics` (the SEI formula is
   unbounded in both directions) and is charged against the `:mi` good/bad
   pair, so a file at MI -229 carries far more debt than one at MI 0 rather
   than sharing a floor with it. `:dup`/`:defects` are already debt-shaped:
   per-point times the measurement, so 0% duplication is 0 debt.

   A nil input omits its metric and renormalizes the remaining weights --
   Go files are measured for duplication and defects only (complexity and
   maintainability are out of scope for Go, per the design), so they pass
   `:cc-max nil :mi nil` and get an honest two-term debt rather than a
   fabricated perfect one."
  [{:keys [cc-max mi dup-pct defects-per-kloc]}]
  (let [{:keys [cc dup defects file-weights]} thresholds
        mi-th (:mi thresholds)
        sc {:cc (when cc-max (penalty cc-max (:good cc) (:bad cc)))
            :mi (when mi (penalty mi (:good mi-th) (:bad mi-th)))
            :dup (when dup-pct (floor0 (* (:per-point dup) dup-pct)))
            :defects (when defects-per-kloc
                       (floor0 (* (:per-point defects) defects-per-kloc)))}]
    (assoc sc :debt (or (weighted-mean sc file-weights) 0.0))))

(defn testing-term
  "Mean of the assertion-density and test-to-code-ratio debts."
  [{:keys [density ratio]}]
  (/ (+ (penalty density (get-in thresholds [:density :good]) (get-in thresholds [:density :bad]))
        (penalty ratio (get-in thresholds [:ratio :good]) (get-in thresholds [:ratio :bad])))
     2.0))

(defn corpus
  "The four corpus terms and the final `:debt`.

   `files-debt` is the LOC-weighted mean of file debts, `coverage-pct` the
   combined coverage percentage and `efficiency-pts` the raw
   coverage-points-per-CI-minute (both charged against their good/bad pairs
   here), `testing-debt` an already-charged `testing-term`. Any of them may
   be nil when its input is missing; the remaining weights renormalize and
   the omitted term names come back in `:omitted` so the report can say
   which inputs were absent.

   Calibration: 0 means every term sits at or better than its `good`
   threshold; 100 means every term sits exactly at its `bad` threshold;
   above 100 is worse than `bad` across the board, which is allowed and
   expected."
  [files-debt coverage-pct efficiency-pts testing-debt]
  (let [terms {:files files-debt
               :coverage (when coverage-pct
                           (penalty coverage-pct
                                    (get-in thresholds [:coverage :good])
                                    (get-in thresholds [:coverage :bad])))
               :efficiency (when efficiency-pts
                             (penalty efficiency-pts
                                      (get-in thresholds [:efficiency :good])
                                      (get-in thresholds [:efficiency :bad])))
               :testing testing-debt}
        omitted (vec (sort (map first (filter (fn [[_ v]] (nil? v)) terms))))]
    {:terms terms :omitted omitted
     :debt (or (weighted-mean terms (:corpus-weights thresholds)) 0.0)}))

(defn- percentile
  "The `p`-quantile of `xs` by nearest-rank over the sorted values."
  [xs p]
  (if (empty? xs)
    0
    (nth (vec (sort xs)) (min (dec (count xs)) (int (* p (count xs)))))))

(defn- defn-lines [d] (- (:end d) (:line d) -1))

(defn issues
  "Every ranked issue across the corpus, sorted by estimated score impact
   (term weight times normalized distance past threshold) descending, then
   path, then line -- so the first line is the best next fix.

   `per-file` records carry `:path :loc :comment-ratio :defects-per-kloc`
   and `:definitions` ([{:name :line :end :depth :cc}...]); `coverage` is
   `quality.graph/coverage`; `dup-pairs` is `quality.dup/pairs`."
  [per-file coverage dup-pairs]
  (let [th (:issues thresholds)
        fw (:file-weights thresholds)
        im (:impact thresholds)
        hotspot (percentile (keep :defects-per-kloc per-file) (:hotspot-percentile th))]
    (->> (concat
           (for [f per-file d (:definitions f) :when (> (:cc d) (:cc th))]
             {:path (:path f) :line (:line d) :kind :complexity :measure (:cc d)
              :hint (str "split " (:name d) "; cc " (:cc d) " > " (:cc th))
              :impact (* (:cc fw) (/ (- (:cc d) (:cc th)) (:cc-span im)))})
           (for [f per-file d (:definitions f) :when (> (:depth d) (:nesting th))]
             {:path (:path f) :line (:line d) :kind :nesting :measure (:depth d)
              :hint (str "flatten " (:name d) "; depth " (:depth d))
              :impact (:nesting im)})
           (for [f per-file d (:definitions f) :when (> (defn-lines d) (:long-defn th))]
             {:path (:path f) :line (:line d) :kind :long-defn :measure (defn-lines d)
              :hint (str "extract from " (:name d)) :impact (:long-defn im)})
           ;; Comment ratio is measured for .lg only; a nil ratio (Go) is
           ;; not evidence of a missing docstring, so it never fires.
           (for [f per-file :when (and (:comment-ratio f)
                                       (> (:loc f) (:low-comment-min-loc th))
                                       (< (:comment-ratio f) (:low-comment th)))]
             {:path (:path f) :line 1 :kind :low-comment :measure (:comment-ratio f)
              :hint "add docstrings" :impact (* (:mi fw) (:low-comment im))})
           (for [f per-file :when (and (pos? hotspot)
                                       (> (or (:defects-per-kloc f) 0) hotspot))]
             {:path (:path f) :line 1 :kind :defect-hotspot :measure (:defects-per-kloc f)
              :hint "recent fixes concentrate here"
              :impact (* (:defects fw) (:hotspot im))})
           (for [p dup-pairs
                 :when (>= (:similarity p) (:dup-issue-min-similarity thresholds))]
             ;; One issue per matched REGION (see `quality.dup/pairs`), so the
             ;; line carries this region's own span and the span it matches.
             {:path (get-in p [:a :path]) :line (get-in p [:a :start])
              :end (get-in p [:a :end]) :kind :duplicate :measure (:similarity p)
              :hint (str "~ " (get-in p [:b :path]) ":" (get-in p [:b :start])
                         "-" (get-in p [:b :end])
                         " (lines " (- (get-in p [:a :end]) (get-in p [:a :start]) -1) ")")
              :impact (* (:dup fw) (:similarity p))})
           (for [u (:untested coverage)]
             {:path (:path u) :line (:line u) :kind :untested :measure 0
              :hint (str "no test reaches " (:name u)) :impact (:untested im)}))
         ;; `vec` before `sort-by`: the comprehensions above are lazy and
         ;; the sort must see a fully realized sequence.
         vec
         ;; `:kind` (by name) breaks a path/line tie so two issues on the
         ;; same definition always print in the same order.
         (sort-by (juxt (comp - :impact) :path :line (comp name :kind)))
         vec)))

(defn top-complexity
  "The `n` most complex definitions across `per-file`, as
   [{:path :line :name :cc :depth :lines}...] sorted by cc descending,
   then depth descending, then path, then line."
  [per-file n]
  (->> (vec (for [f per-file d (:definitions f)]
              {:path (:path f) :line (:line d) :name (:name d)
               :cc (:cc d) :depth (:depth d) :lines (defn-lines d)}))
       (sort-by (juxt (comp - :cc) (comp - :depth) :path :line))
       (take n)
       vec))
