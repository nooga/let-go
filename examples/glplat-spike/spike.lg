(require 'glplat)

;; Initialize a 640x480 window
(glplat/Init 640 480 "glplat spike")

;; Animation loop: run for ~3 seconds, clearing the screen with a color that fades
(loop []
  (let [t (glplat/Time)]
    (when (and (not (glplat/ShouldClose))
               (< t 3.0))
      ;; Use time to cycle through colors
      (let [phase (/ t 3.0)
            r (if (< phase 0.33) 1.0 (if (< phase 0.67) 0.5 0.0))
            g (if (< phase 0.33) 0.0 (if (< phase 0.67) 1.0 0.5))
            b (if (< phase 0.33) 0.5 (if (< phase 0.67) 0.0 1.0))]
        (glplat/BeginFrame r g b)
        (glplat/EndFrame)
        (glplat/PollEvents)
        (recur)))))

;; Cleanup
(glplat/Terminate)
(println "Done!")
