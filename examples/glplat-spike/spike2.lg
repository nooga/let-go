;; glplat spike 2 — texture loading and rendering
(require 'glplat)

;; Helper: parse EDN metrics file (simplified)
(defn read-metrics [path]
  "Read a simple EDN metrics file."
  (let [content (slurp path)]
    ;; Parse {"@" [u0 v0 u1 v1] ...}
    ;; For this test, we'll hardcode them based on the known atlas
    {"@" [0.0000 0.0000 0.0625 1.0000]
     "#" [0.0625 0.0000 0.1250 1.0000]
     "." [0.1250 0.0000 0.1875 1.0000]
     "x" [0.1875 0.0000 0.2500 1.0000]}))

;; Helper: create an ortho projection matrix (column-major)
(defn ortho-matrix [left right bottom top near far]
  "Create an orthographic projection matrix in column-major order."
  [(* 2.0 (/ 1.0 (- right left))) 0.0 0.0 0.0
   0.0 (* 2.0 (/ 1.0 (- top bottom))) 0.0 0.0
   0.0 0.0 (* -2.0 (/ 1.0 (- far near))) 0.0
   (- (/ (+ right left) (- right left))) (- (/ (+ top bottom) (- top bottom))) (- (/ (+ far near) (- far near))) 1.0])

;; Helper: create a glyph quad (2 triangles, 6 vertices, 9 floats each)
(defn glyph-quad [x y size metrics-entry color-r color-g color-b]
  "Create a glyph quad with position, UVs, and color."
  (let [[u0 v0 u1 v1] metrics-entry
        ;; Quad at (x,y) size=16 pixels (in ortho coords 0-640x0-480)
        x0 x
        y0 y
        x1 (+ x size)
        y1 (+ y size)]
        ;; Triangle 1: (x0,y0), (x1,y0), (x0,y1)
        ;; Triangle 2: (x1,y0), (x1,y1), (x0,y1)
    [;; Triangle 1
     x0 y0 0.0 u0 v0 color-r color-g color-b 1.0
     x1 y0 0.0 u1 v0 color-r color-g color-b 1.0
     x0 y1 0.0 u0 v1 color-r color-g color-b 1.0
     ;; Triangle 2
     x1 y0 0.0 u1 v0 color-r color-g color-b 1.0
     x1 y1 0.0 u1 v1 color-r color-g color-b 1.0
     x0 y1 0.0 u0 v1 color-r color-g color-b 1.0]))

;; Initialize
(glplat/Init 640 480 "glplat spike 2 - text rendering")

;; Load atlas texture
(let [tex-id (glplat/LoadTextureFile "examples/glplat-spike/atlas.png")
      metrics (read-metrics "examples/glplat-spike/atlas.edn")
      ;; Set up ortho matrix for 640x480 window, z range 0-1
      proj-matrix (ortho-matrix 0.0 640.0 480.0 0.0 0.0 1.0)]

  ;; Set matrix once
  (glplat/SetMatrix proj-matrix)

  ;; Animation loop: render glyphs for 3 seconds
  (loop []
    (let [t (glplat/Time)]
      (when (and (not (glplat/ShouldClose))
                 (< t 3.0))
        ;; Clear to dark background
        (glplat/BeginFrame 0.1 0.1 0.15)

        ;; Render "@" in red at (100, 100)
        (glplat/SubmitTriangles tex-id (glyph-quad 100.0 100.0 32.0 (get metrics "@") 1.0 0.0 0.0))

        ;; Render "#" in green at (200, 100)
        (glplat/SubmitTriangles tex-id (glyph-quad 200.0 100.0 32.0 (get metrics "#") 0.0 1.0 0.0))

        ;; Render "." in blue at (300, 100)
        (glplat/SubmitTriangles tex-id (glyph-quad 300.0 100.0 32.0 (get metrics ".") 0.0 0.0 1.0))

        ;; Render "x" in white at (400, 100)
        (glplat/SubmitTriangles tex-id (glyph-quad 400.0 100.0 32.0 (get metrics "x") 1.0 1.0 1.0))

        ;; Present
        (glplat/EndFrame)
        (glplat/PollEvents)
        (recur)))))

;; Cleanup
(glplat/Terminate)
(println "Spike 2 complete!")
