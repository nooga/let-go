(ns test.quality-touched-test
  (:require [quality.touched :as t]
            [quality.metrics :as metrics]
            [test :refer :all]))

(defn change [old-text new-text old-spans new-spans]
  {:status :modified :old-path "sample.lg" :new-path "sample.lg"
   :old-text old-text :new-text new-text
   :old-spans old-spans :new-spans new-spans})

(defn span [start count] {:start start :count count})

(deftest a-line-inside-a-long-definition-expands-to-the-whole-form
  (let [old "(ns demo)\n(defn calc [x]\n  (let [a (inc x)]\n    (if a\n      (+ a 1)\n      x)))\n"
        new "(ns demo)\n(defn calc [x]\n  (let [a (inc x)]\n    (if a\n      (+ a 2)\n      x)))\n"
        rows (t/build [(change old new [(span 5 1)] [(span 5 1)])])]
    (is (= 1 (count rows)))
    (is (= {:start 2 :end 6} (:old-span (first rows))))
    (is (= {:start 2 :end 6} (:new-span (first rows))))
    (is (= :paired (:pairing (first rows))))
    (is (= 'demo/calc (:identity (first rows))))
    (is (= {:cc 0 :sloc 0} (:delta (first rows))))))

(deftest multiple-hunks-in-one-form-deduplicate
  (let [old "(ns demo)\n(defn calc [x]\n  (inc x)\n  (+ x 1))\n"
        new "(ns demo)\n(defn calc [x]\n  (dec x)\n  (+ x 2))\n"
        rows (t/build [(change old new [(span 3 1) (span 4 1)]
                               [(span 3 1) (span 4 1)])])]
    (is (= 1 (count rows)))
    (is (= {:start 2 :end 4} (:new-span (first rows))))))

(deftest a-hunk-crossing-two-definitions-selects-both
  (let [old "(ns demo)\n(defn a [] 1)\n(defn b [] 2)\n"
        new "(ns demo)\n(defn a [] 3)\n(defn b [] 4)\n"
        rows (t/build [(change old new [(span 2 2)] [(span 2 2)])])]
    (is (= '[demo/a demo/b] (map :identity rows)))
    (is (= [:paired :paired] (map :pairing rows)))))

(deftest first-and-last-line-edits-find-a-unique-counterpart
  (let [old "(ns demo)\n(defn a []\n  1)\n(defn b [] 2)\n"
        first-new "(ns demo)\n(defn a [x]\n  1)\n(defn b [] 2)\n"
        last-new "(ns demo)\n(defn a []\n  2)\n(defn b [] 2)\n"
        first-edit (first (t/build [(change old first-new [(span 2 1)] [(span 2 1)])]))
        last-edit (first (t/build [(change old last-new [(span 3 1)] [(span 3 1)])]))]
    (is (= :paired (:pairing first-edit)))
    (is (= {:start 2 :end 3} (:old-span first-edit)))
    (is (= :paired (:pairing last-edit)))
    (is (= {:start 2 :end 3} (:new-span last-edit)))))

(deftest a-zero-length-counterpart-anchor-still-finds-the-full-index
  (let [old "(ns demo)\n(defn a []\n  1)\n"
        new "(ns demo)\n(defn a []\n  ; inserted\n  1)\n"
        row (first (t/build [(change old new [(span 2 0)] [(span 3 1)])]))]
    (is (= :paired (:pairing row)))
    (is (= {:start 2 :end 3} (:old-span row)))
    (is (= {:start 2 :end 4} (:new-span row)))))

(deftest zero-length-anchor-only-selects-strict-interior
  (let [text "(ns demo)\n(defn a []\n  1)\n(defn b [] 2)\n"
        interior (t/build [(change text text [(span 2 0)] [])])
        boundary (t/build [(change text text [(span 3 0)] [])])]
    (is (= :paired (:pairing (first interior))))
    (is (= 'demo/a (:identity (first interior))))
    (is (= :outside-form (:reason (first boundary))))))

(deftest comment-only-change-is-explicitly-outside-forms
  (let [old "(ns demo)\n; old comment\n(defn a [] 1)\n"
        new "(ns demo)\n; new comment\n(defn a [] 1)\n"
        row (first (t/build [(change old new [(span 2 1)] [(span 2 1)])]))]
    (is (= :outside-form (:reason row)))
    (is (nil? (:delta row)))
    (is (= {:start 2 :end 2} (:old-span row)))))

(deftest added-and-deleted-definitions-have-no-invented-zero-baseline
  (let [old "(ns demo)\n(defn old [] 1)\n"
        new "(ns demo)\n(defn fresh [] 2)\n"
        rows (t/build [(change old new [(span 2 1)] [(span 2 1)])])]
    (is (= 2 (count rows)))
    (is (= #{'demo/old 'demo/fresh} (set (map :identity rows))))
    (is (every? #(= :unpaired (:pairing %)) rows))
    (is (every? #(nil? (:delta %)) rows))))

(deftest duplicate-or-missing-identity-never-pairs
  (let [old "(ns demo)\n(defn same [] 1)\n(defn same [] 2)\n(println 1)\n"
        new "(ns demo)\n(defn same [] 3)\n(defn same [] 4)\n(println 2)\n"
        rows (t/build [(change old new [(span 2 3)] [(span 2 3)])])]
    (is (= 6 (count rows)))
    (is (every? #(= :unpaired (:pairing %)) rows))
    (is (every? #(nil? (:delta %)) rows))))

(deftest defmethod-dispatch-identifies-distinct-methods
  (let [old "(ns demo)\n(defmethod paint :red [x] (inc x))\n(defmethod paint :blue [x] (dec x))\n"
        new "(ns demo)\n(defmethod paint :red [x] (+ x 2))\n(defmethod paint :blue [x] (- x 2))\n"
        rows (t/build [(change old new [(span 2 2)] [(span 2 2)])])]
    (is (= 2 (count rows)))
    (is (= [:paired :paired] (map :pairing rows)))
    (is (= #{":red" ":blue"} (set (map :dispatch rows))))))

(deftest namespace-transitions-change-definition-identity
  (let [old "(ns demo)\n(in-ns 'a)\n(defn x [] 1)\n"
        new "(ns demo)\n(in-ns 'b)\n(defn x [] 2)\n"
        rows (filter :identity
                     (t/build [(change old new [(span 2 2)] [(span 2 2)])]))]
    (is (= #{'a/x 'b/x} (set (map :identity rows))))
    (is (= 2 (count rows)))
    (is (every? #(= :unpaired (:pairing %)) rows))
    (is (every? #(not (contains? % :delta)) rows))))

(deftest atomic-top-level-form-does-not-break-later-definition-pairing
  (let [old "(ns demo)\n42\n(defn x [] 1)\n"
        new "(ns demo)\n42\n(defn x [] 2)\n"
        rows (t/build [(change old new [(span 3 1)] [(span 3 1)])])]
    (is (= 1 (count rows)))
    (is (= 'demo/x (:identity (first rows))))
    (is (= :paired (:pairing (first rows))))))

(deftest dynamic-namespace-transition-does-not-reuse-stale-identity
  (let [old "(ns demo)\n(in-ns (symbol \"a\"))\n(defn x [] 1)\n"
        new "(ns demo)\n(in-ns (symbol \"b\"))\n(defn x [] 2)\n"
        rows (filter #(= :defn (:kind %))
                     (t/build [(change old new [(span 2 2)] [(span 2 2)])]))]
    (is (= 2 (count rows)))
    (is (every? #(nil? (:identity %)) rows))
    (is (every? #(= :unpaired (:pairing %)) rows))))

(deftest deftest-retains-callable-complexity-and-sloc
  (let [old "(ns demo)\n(deftest check-it (is (= 1 1)))\n"
        new "(ns demo)\n(deftest check-it (is (= 1 2)))\n"
        row (first (t/build [(change old new [(span 2 1)] [(span 2 1)])]))]
    (is (= :paired (:pairing row)))
    (is (= {:cc 1 :sloc 1} (:old-metrics row)))
    (is (= {:cc 1 :sloc 1} (:new-metrics row)))
    (is (= {:cc 0 :sloc 0} (:delta row)))))

(deftest internal-metric-errors-are-not-called-invalid-source
  (let [old "(ns demo)\n(defn x [] 1)\n"
        new "(ns demo)\n(defn x [] 2)\n"
        row (change old new [(span 2 1)] [(span 2 1)])]
    (is (thrown? Throwable
                 (with-redefs [metrics/complexity
                               (fn [_] (throw (ex-info "injected metric failure" {:probe true})))]
                   (t/build [row]))))))

(deftest non-callable-form-has-no-invented-metrics-or-delta
  (let [old "(ns demo)\n(def answer 1)\n"
        new "(ns demo)\n(def answer 2)\n"
        row (first (t/build [(change old new [(span 2 1)] [(span 2 1)])]))]
    (is (= :paired (:pairing row)))
    (is (nil? (:old-metrics row)))
    (is (nil? (:new-metrics row)))
    (is (not (contains? row :delta)))))

(deftest added-and-deleted-files-retain-a-missing-side
  (let [text "(ns demo)\n(defn thing [] 1)\n"
        added (first (t/build [{:status :added :old-path nil :new-path "new.lg"
                                :new-text text :old-spans [(span 0 0)]
                                :new-spans [(span 1 2)]}]))
        deleted (first (t/build [{:status :deleted :old-path "old.lg" :new-path nil
                                  :old-text text :old-spans [(span 1 2)]
                                  :new-spans [(span 0 0)]}]))]
    (is (= :unpaired (:pairing added)))
    (is (nil? (:old-span added)))
    (is (nil? (:delta added)))
    (is (= :unpaired (:pairing deleted)))
    (is (nil? (:new-span deleted)))
    (is (nil? (:delta deleted)))))

(deftest empty-added-source-and-rename-only-change-stay-path-entries
  (let [empty-file (t/build [{:status :added :old-path nil :new-path "empty.lg"
                              :new-text "" :old-spans [] :new-spans []}])
        rename (t/build [{:status :renamed :old-path "old.lg"
                          :new-path "new.lg" :old-spans [] :new-spans []}])]
    (is (= :path-only (:entry-type (first empty-file))))
    (is (= :path-only (:entry-type (first rename))))))

(deftest hunk-covering-a-form-and-an-outside-comment-reports-both
  (let [old "(ns demo)\n(defn a [] 1)\n; old\n"
        new "(ns demo)\n(defn a [] 2)\n; new\n"
        rows (t/build [(change old new [(span 2 2)] [(span 2 2)])])]
    (is (= [:form :outside-form] (map :entry-type rows)))
    (is (= {:start 3 :end 3} (:new-span (second rows))))))

(deftest invalid-file-falls-back-with-a-reason
  (let [row (first (t/build [(change "(ns demo)\n(defn a [] 1)\n"
                                   "(ns demo)\n(defn a [] 1\n"
                                   [(span 2 1)] [(span 2 1)])]))]
    (is (= :invalid-source (:reason row)))
    (is (string? (:message row)))
    (is (nil? (:delta row)))))

(defn go-change [path old-text new-text old-spans new-spans]
  {:status :modified :old-path path :new-path path
   :old-text old-text :new-text new-text
   :old-spans old-spans :new-spans new-spans})

(deftest go-line-inside-multiline-function-expands-with-callable-metrics
  (let [old "package p\nfunc a(x int) int {\n  if x > 0 {\n    return 1\n  }\n  return 0\n}\nfunc b() {}\n"
        new "package p\nfunc a(x int) int {\n  if x > 0 {\n    return 2\n  }\n  return 0\n}\nfunc b() {}\n"
        rows (t/build [(go-change "a.go" old new [(span 4 1)] [(span 4 1)])])]
    (is (= 1 (count rows)))
    (is (= "a" (:name (first rows))))
    (is (= {:start 2 :end 7} (:new-span (first rows))))
    (is (= :paired (:pairing (first rows))))
    (is (= {:cc 0 :sloc 0} (:delta (first rows))))))

(deftest go-adjacent-declarations-and-receiver-types-have-distinct-identities
  (let [old "package p\ntype A struct{}\ntype B struct{}\nfunc (a *A) emit() {\n  println(1)\n}\nfunc (b *B) emit() {\n  println(1)\n}\n"
        new "package p\ntype A struct{}\ntype B struct{}\nfunc (a *A) emit() {\n  println(2)\n}\nfunc (b *B) emit() {\n  println(2)\n}\n"
        rows (t/build [(go-change "a.go" old new [(span 5 1) (span 8 1)] [(span 5 1) (span 8 1)])])]
    (is (= 2 (count rows)))
    (is (= #{"(*A).emit" "(*B).emit"} (set (map :name rows))))
    (is (every? #(= :paired (:pairing %)) rows))))

(deftest go-noncallable-top-level-declaration-has-no-metrics
  (let [old "package p\nvar answer = 1\nfunc f() {}\n"
        new "package p\nvar answer = 2\nfunc f() {}\n"
        row (first (t/build [(go-change "a.go" old new [(span 2 1)] [(span 2 1)])]))]
    (is (= :var (:kind row)))
    (is (= :paired (:pairing row)))
    (is (nil? (:old-metrics row)))
    (is (not (contains? row :delta)))))

(deftest malformed-go-file-falls-back-while-valid-file-is-expanded
  (let [valid-old "package p\nfunc f() { println(1) }\n"
        valid-new "package p\nfunc f() { println(2) }\n"
        bad (go-change "bad.go" "package p\nfunc (" "package p\nfunc (" [(span 2 1)] [(span 2 1)])
        good (go-change "good.go" valid-old valid-new [(span 2 1)] [(span 2 1)])
        rows (t/build [bad good])]
    (is (= :file-fallback (:entry-type (first rows))))
    (is (= :invalid-source (:reason (first rows))))
    (is (string? (:message (first rows))))
    (is (= :paired (:pairing (second rows))))))

(deftest cross-language-rename-stays-path-only
  (let [rows (t/build [{:status :renamed :old-path "before.lg" :new-path "after.go"
                        :old-text "(ns p)\n(defn f [] 1)\n"
                        :new-text "package p\nfunc f() {}\n"
                        :old-spans [(span 2 1)] :new-spans [(span 2 1)]}])]
    (is (= 1 (count rows)))
    (is (= :path-only (:entry-type (first rows))))))

(deftest grouped-go-declaration-header-and-closing-line-select-every-spec
  (let [old "package p\nvar (\n  first = 1\n  second = 2\n)\n"
        header-new "package p\nconst (\n  first = 1\n  second = 2\n)\n"
        close-new "package p\nvar (\n  first = 1\n  second = 2\n) // note\n"
        header (t/build [(go-change "header.go" old header-new
                                    [(span 2 1)] [(span 2 1)])])
        closing (t/build [(go-change "closing.go" old close-new
                                     [(span 5 1)] [(span 5 1)])])]
    (is (= 4 (count header)))
    (is (every? #(= :form (:entry-type %)) header))
    (is (= #{"first" "second"} (set (map :name header))))
    (is (every? #(= :unpaired (:pairing %)) header))
    (is (= 2 (count closing)))
    (is (every? #(= :paired (:pairing %)) closing))
    (is (= #{"first" "second"} (set (map :name closing))))))
