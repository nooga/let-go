;; Behavior tests for (is (thrown? ...)) and (is (thrown-with-msg? ...)) —
;; the clojure.test special forms that assert a body throws.
;;
;; Harness note: like run_test_var_test.lg, probes that must fail or error
;; are given :test metadata via set-test (not deftest, so their underlying
;; var stays a plain placeholder) and run through run-test-var, which
;; binds the counters. Because :test metadata makes a var visible to
;; test-all-vars's automatic scan (spec 9.2/9.3), this file defines a
;; test-ns-hook (spec 9.3) that runs only the real tests below — a
;; registered probe running via the automatic scan would fail the whole
;; suite on purpose.

(ns test.thrown-test
  (:require
   [test :refer :all]))

;; --- probes -----------------------------------------------------------

(def no-throw-probe nil)
(set-test no-throw-probe (is (thrown? Exception :did-not-throw)))

(def wrong-message-probe nil)
(set-test wrong-message-probe
  (is (thrown-with-msg? Exception #"nope" (throw (ex-info "boom" {})))))

(def non-matching-class-probe nil)
;; A thrown value not matching the class rethrows, so the runner counts
;; it as an :error — matching clojure.test.
(set-test non-matching-class-probe
  (is (thrown? clojure.lang.ExceptionInfo (throw "plain string"))))

(defn- quiet
  "Run f, discarding whatever it prints via report, but keep report's real
   dispatch (and so its counter-incrementing side effects) intact — unlike
   rebinding report itself to a no-op, which would also swallow :pass/
   :fail/:error counting and break every summary this file asserts on.
   with-test-out always prints through *test-out*, not *out*, so route
   *test-out* into with-out-str*'s capture buffer for the duration."
  [f]
  (let [result (atom nil)]
    (with-out-str* (fn [] (binding [*test-out* *out*] (reset! result (f)))))
    @result))

;; --- thrown? ----------------------------------------------------------

(deftest thrown-passes-on-matching-class
  (is (thrown? Exception (throw (ex-info "b" {}))))
  (is (thrown? clojure.lang.ExceptionInfo (throw (ex-info "b" {})))))

(deftest thrown-returns-the-exception
  (let [e (is (thrown? Exception (throw (ex-info "boom" {:k 1}))))]
    (is (= "boom" (ex-message e)))))

(deftest thrown-fails-when-body-does-not-throw
  (let [c (quiet #(run-test-var (var no-throw-probe)))]
    (is (= 1 (:fail c)))
    (is (= 0 (:pass c)))
    (is (= 0 (:error c)))))

(deftest thrown-non-matching-class-is-an-error
  (let [c (quiet #(run-test-var (var non-matching-class-probe)))]
    (is (= 1 (:error c)))
    (is (= 0 (:fail c)))))

;; --- thrown-with-msg? -------------------------------------------------

(deftest thrown-with-msg-passes-on-matching-message
  (is (thrown-with-msg? Exception #"bo+m" (throw (ex-info "boom" {}))))
  (is (thrown-with-msg? clojure.lang.ExceptionInfo #"boom" (throw (ex-info "big boom" {})))))

(deftest thrown-with-msg-fails-on-non-matching-regex
  (let [c (quiet #(run-test-var (var wrong-message-probe)))]
    (is (= 1 (:fail c)))
    (is (= 0 (:pass c)))
    (is (= 0 (:error c)))))

;; --- the [form msg] arity of is ---------------------------------------

(deftest thrown-works-with-message-arity
  (is (thrown? Exception (throw (ex-info "b" {}))) "should throw")
  (is (thrown-with-msg? Exception #"b" (throw (ex-info "b" {}))) "should throw with b"))

;; --- test-ns-hook: run only the real tests above, never the probes ----

(defn test-ns-hook []
  (doseq [t [(var thrown-passes-on-matching-class)
             (var thrown-returns-the-exception)
             (var thrown-fails-when-body-does-not-throw)
             (var thrown-non-matching-class-is-an-error)
             (var thrown-with-msg-passes-on-matching-message)
             (var thrown-with-msg-fails-on-non-matching-regex)
             (var thrown-works-with-message-arity)]]
    (test-var t)))
