(ns fixture.dup-two-blocks-b)

;; Shared block one: identical token structure in both files.
(defn calc-beta-one [a b c]
  (let [p0 (+ a b)
        p1 (+ p0 1)
        p2 (+ p1 2)
        p3 (+ p2 3)
        p4 (+ p3 4)
        p5 (+ p4 5)
        p6 (+ p5 6)
        p7 (+ p6 7)
        p8 (+ p7 8)
        p9 (+ p8 9)
        p10 (+ p9 10)
        p11 (+ p10 11)
        p12 (+ p11 12)
        p13 (+ p12 13)
        p14 (+ p13 14)
        p15 (+ p14 15)
        p16 (+ p15 16)
        p17 (+ p16 17)
        p18 (+ p17 18)
        p19 (+ p18 19)
        p20 (+ p19 20)
        p21 (+ p20 21)
        p22 (+ p21 22)
        p23 (+ p22 23)
        p24 (+ p23 24)
        p25 (+ p24 25)
        tot (* p25 c)]
    (reduce + 0 [p1 p5 p9 tot])))

;; Filler unique to file B (a different token shape).
(def b-row-1 [1 2 3])
(def b-row-2 [2 3 4])
(def b-row-3 [3 4 5])
(def b-row-4 [4 5 6])
(def b-row-5 [5 6 7])
(def b-row-6 [6 7 8])
(def b-row-7 [7 8 9])
(def b-row-8 [8 9 10])
(def b-row-9 [9 10 11])
(def b-row-10 [10 11 12])
(def b-row-11 [11 12 13])
(def b-row-12 [12 13 14])
(def b-row-13 [13 14 15])
(def b-row-14 [14 15 16])
(def b-row-15 [15 16 17])

;; Shared block two: a different shape, so it never matches block one.
(defn pick-beta-two [x]
  (cond
    (= x 1) (str "v1")
    (= x 2) (str "v2")
    (= x 3) (str "v3")
    (= x 4) (str "v4")
    (= x 5) (str "v5")
    (= x 6) (str "v6")
    (= x 7) (str "v7")
    (= x 8) (str "v8")
    (= x 9) (str "v9")
    (= x 10) (str "v10")
    (= x 11) (str "v11")
    (= x 12) (str "v12")
    (= x 13) (str "v13")
    (= x 14) (str "v14")
    (= x 15) (str "v15")
    (= x 16) (str "v16")
    (= x 17) (str "v17")
    (= x 18) (str "v18")
    (= x 19) (str "v19")
    (= x 20) (str "v20")
    (= x 21) (str "v21")
    (= x 22) (str "v22")
    (= x 23) (str "v23")
    (= x 24) (str "v24")
    (= x 25) (str "v25")
    :else (str "none")))
