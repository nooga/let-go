;; Behavior tests for test/run-test-var and the run-test macro — the
;; single-var entry point editors use for "run the test under the cursor"
;; (clj-pulse resolves clojure.test/run-test-var, which aliases here).
;;
;; The point of run-test-var over `((deref v))` is that it goes through the
;; same once/each fixture composition and the same namespace switch as
;; run-tests, so one test behaves the way the whole suite does — while
;; binding the counters so it never disturbs the run it was called from.
;;
;; Harness note: this file's own tests run under the shared TestRunner,
;; which asserts (successful? (run-tests ns)) on the file's namespace.
;; test-vars only runs a var carrying :test metadata (spec 9.2/9.3), so a
;; probe that must fail or throw on purpose needs :test metadata too, attached via
;; set-test rather than deftest so its underlying var value stays a plain
;; placeholder. That metadata would make test-all-vars pick the probe up
;; on the file's own (run-tests) scan, so this file defines a test-ns-hook
;; (spec 9.3) that explicitly runs only the real tests below, bypassing
;; the automatic scan entirely.

(ns test.run-test-var-test
  (:require
   [test :refer :all]))

;; --- probes -----------------------------------------------------------

(deftest sample-passing
  (is (= 1 1)))

(def sample-failing nil)
(set-test sample-failing (is (= 1 2)))

(def sample-throwing nil)
(set-test sample-throwing (throw (ex-info "boom" {})))

;; Namespace probe: its metadata says it lives in `string`, so run-test-var
;; must in-ns there before invoking it and come back afterwards.
(def observed-ns (atom nil))

(def foreign-probe nil)
(set-test foreign-probe (reset! observed-ns (ns-name *ns*)))
(alter-meta! (var foreign-probe) assoc :ns (find-ns 'string))

(def fixture-events (atom []))

(defn- logging-fixture [before after]
  (fn [t]
    (swap! fixture-events conj before)
    (t)
    (swap! fixture-events conj after)))

(defn- with-fixtures
  "Run thunk f with the given :each / :once fixtures installed on this
   namespace via use-fixtures (spec 8), resetting them to empty afterward
   so they don't leak into any test that runs after this one — fixtures
   now live on namespace metadata rather than being global dynamic state."
  [each once f]
  (try
    (apply use-fixtures :each each)
    (apply use-fixtures :once once)
    (f)
    (finally
      (use-fixtures :each)
      (use-fixtures :once))))

;; --- counters ---------------------------------------------------------

(deftest run-test-var-counts-a-passing-test
  (let [c (run-test-var (var sample-passing))]
    (is (= 1 (:test c)))
    (is (= 1 (:pass c)))
    (is (= 0 (:fail c)))
    (is (= 0 (:error c)))))

(deftest run-test-var-counts-a-failing-assertion
  ;; The inner run prints "FAIL (= 1 2)" — that is the probe failing on
  ;; purpose, not this file failing.
  (let [c (run-test-var (var sample-failing))]
    (is (= 1 (:test c)))
    (is (= 1 (:fail c)))
    (is (= 0 (:error c)))))

(deftest run-test-var-counts-a-throwing-test
  ;; A thrown body is an :error, and must not propagate to the caller.
  (let [c (run-test-var (var sample-throwing))]
    (is (= 1 (:test c)))
    (is (= 1 (:error c)))
    (is (= 0 (:pass c)))))

;; --- isolation from the enclosing run ---------------------------------

(deftest a-nested-run-leaves-the-enclosing-run-untouched
  ;; This test is itself running under run-tests. Running a failing and a
  ;; throwing test inside it must not touch the suite's tally: run-test-var
  ;; binds its own counters, so a nested failure is visible only in the
  ;; summary it returns and can never be mistaken for — or erase — the
  ;; enclosing run's verdict.
  (let [before test/*report-counters*
        failed (run-test-var (var sample-failing))
        errored (run-test-var (var sample-throwing))]
    (is (= before test/*report-counters*))
    (is (not (successful? failed)))
    (is (not (successful? errored)))))

;; --- fixtures ---------------------------------------------------------

(deftest run-test-var-applies-once-and-each-fixtures
  (reset! fixture-events [])
  (let [c (with-fixtures [(logging-fixture :each-before :each-after)]
                         [(logging-fixture :once-before :once-after)]
                         (fn [] (run-test-var (var sample-passing))))]
    (is (= 1 (:pass c)))
    (is (= [:once-before :each-before :each-after :once-after] @fixture-events))))

;; --- namespace handling -----------------------------------------------

(deftest run-test-var-runs-in-the-vars-namespace
  (reset! observed-ns nil)
  (let [before (ns-name *ns*)]
    (run-test-var (var foreign-probe))
    (is (= 'string @observed-ns))
    (is (= before (ns-name *ns*)))))

(deftest run-test-var-restores-the-namespace-after-a-throw
  (let [before (ns-name *ns*)]
    (run-test-var (var sample-throwing))
    (is (= before (ns-name *ns*)))))

;; --- deftest metadata -------------------------------------------------

(deftest deftest-records-clojure-test-var-metadata
  (let [m (meta (var sample-passing))]
    (is (= 'sample-passing (:name m)))
    (is (= 'test.run-test-var-test (ns-name (:ns m))))
    ;; :test holds the test fn, as in clojure.test — not a boolean marker.
    (is (fn? (:test m)))))

;; --- run-test macro ---------------------------------------------------

(deftest run-test-macro-matches-run-test-var
  (let [via-macro (run-test sample-passing)
        via-fn (run-test-var (var sample-passing))]
    (is (= via-fn via-macro))))

;; --- test-ns-hook: run only the real tests above, never the probes ----

(defn test-ns-hook []
  (doseq [t [(var sample-passing)
             (var run-test-var-counts-a-passing-test)
             (var run-test-var-counts-a-failing-assertion)
             (var run-test-var-counts-a-throwing-test)
             (var a-nested-run-leaves-the-enclosing-run-untouched)
             (var run-test-var-applies-once-and-each-fixtures)
             (var run-test-var-runs-in-the-vars-namespace)
             (var run-test-var-restores-the-namespace-after-a-throw)
             (var deftest-records-clojure-test-var-metadata)
             (var run-test-macro-matches-run-test-var)]]
    (test-var t)))
