(ns test.kwargs-trailing-map-test
  (:require [test :refer :all]))

;; Clojure 1.11 keyword arguments: a kwargs fn accepts a single trailing map,
;; whose entries are assoc'd in place after the explicit pairs. honeysql's
;; format supports (format data :dialect :mysql {:pretty true}) through this.

(defn- kw-fn [& {:as opts}] opts)
(defn- kw-keys-fn [& {:keys [a b] :as opts}] [a b opts])

(deftest kwargs-pairs
  (is (= {:a 1 :b 2} (kw-fn :a 1 :b 2)))
  (is (nil? (kw-fn))))

(deftest kwargs-single-trailing-map
  (is (= {:a 1} (kw-fn {:a 1})))
  (is (= [1 2 {:a 1 :b 2}] (kw-keys-fn {:a 1 :b 2}))))

(deftest kwargs-pairs-plus-trailing-map
  (is (= {:a 1 :b 2} (kw-fn :a 1 {:b 2})))
  (is (= [1 2 {:a 1 :b 2 :c 3}] (kw-keys-fn :a 1 {:b 2 :c 3})))
  ;; assoc-in-order: the trailing map's entries land last, so they win.
  (is (= {:a 3 :b 2} (kw-fn :a 1 {:b 2 :a 3}))))

(deftest kwargs-odd-without-map-still-throws
  ;; (is (thrown? ...)) once #754 lands; try/catch keeps this branch-local.
  (is (= :threw (try (kw-fn :a) :no-throw (catch Throwable _ :threw)))))
