(ns test.quality-cli-test
  (:require
   [clojure.string :as str]
   [quality :as q]
   [test :refer :all]))

;; The test runner's cwd is `test/`, so the fixture corpus is at
;; `fixtures/quality` here and at `test/fixtures/quality` from the repo
;; root. `--source-root` measures it as source (only `*_test.lg` inside it
;; stays a test), and every reported path is repo-root-relative either way.
(def fixtures "fixtures/quality")

(deftest cli-produces-deterministic-report-over-fixtures
  (let [edn-path (str (os/temp-dir) "quality-cli-test.edn")
        args ["--ci-seconds" "300" "--go-cover" (str fixtures "/cover.out")
              "--edn" edn-path "--since" "2000-01-01" "--top" "5"
              "--source-root" fixtures fixtures]
        out1 (with-out-str (q/main args))
        out2 (with-out-str (q/main args))]
    (is (= out1 out2))
    (is (str/includes? out1 "score"))
    (is (str/includes? out1 "duplicate"))
    (is (str/includes? out1 "untested"))
    (is (str/includes? out1 "top complexity"))
    ;; Paths are repo-root-relative regardless of the process cwd.
    (is (str/includes? out1 "\ntest/fixtures/quality/cli_src.lg"))
    (is (str/includes? out1 "defects: renames credited to target via -M"))
    (let [r (read-string (slurp edn-path))
          untested (set (map :name (get-in r [:coverage :lg :untested])))]
      (is (<= 0 (:score r) 100))
      (is (= "supplied" (get-in r [:inputs :ci :source])))
      (is (vector? (:issues r)))
      (is (vector? (:top-complexity r)))
      (is (>= (:cc (first (:top-complexity r))) (:cc (second (:top-complexity r)))))
      ;; A real tested/untested split, not an artifact of misclassification.
      (is (contains? untested 'untested-fn))
      (is (not (contains? untested 'tested-fn)))
      ;; The one `*_test.lg` under the source root still counts as a test.
      (is (pos? (get-in r [:testing :assertions]))))))

(deftest test-classification-is-cwd-independent
  ;; Repo-relative paths, so the rules mean the same thing from any cwd.
  (is (q/test-file? "test/fixtures/quality/cli_src.lg"))
  (is (not (q/test-file? "test/fixtures/quality/cli_src.lg" ["test/fixtures/quality"])))
  (is (q/test-file? "test/fixtures/quality/cli_src_test.lg" ["test/fixtures/quality"]))
  (is (q/test-file? "pkg/rt/lang_test.go"))
  (is (not (q/test-file? "pkg/rt/lang.go"))))

(deftest trailing-valueless-flag-is-rejected
  (is (thrown? Throwable (q/parse-args ["--top"]))))

(deftest requiring-the-cli-namespace-does-not-run-it
  ;; The entry guard means loading `quality` for this test printed nothing;
  ;; if it had run, the test runner's output would carry a report already.
  (is (fn? q/main)))

(deftest untracked-files-are-not-measured
  ;; The corpus is the VCS file list, so a scratch file in the working copy
  ;; cannot move the score. `scratch_*.lg` is gitignored in the fixture dir
  ;; (jj snapshots on every command, so merely-new would already be tracked).
  (let [scratch (str fixtures "/scratch_untracked.lg")]
    (spit scratch "(ns fixture.scratch)\n(defn scratch-only [x] (inc x))\n")
    (let [out (with-out-str (q/main ["--since" "2000-01-01" "--source-root" fixtures fixtures]))]
      (os/delete-tree scratch)
      (is (not (str/includes? out "scratch_untracked")))
      (is (not (str/includes? out "scratch-only")))
      (is (str/includes? out "tracked-by jj")))))

(deftest an-empty-corpus-is-an-error-not-a-perfect-score
  ;; A path that matches nothing (or only skipped files) used to score 100.0
  ;; off zero files.
  (let [out (with-out-str (is (= 2 (q/main ["--since" "2000-01-01" "fixtures/quality/nope"]))))]
    (is (str/includes? out "no source files under"))))

(deftest help-prints-usage
  (is (str/includes? (with-out-str (q/main ["--help"])) "usage: ./lg scripts/quality.lg")))

(deftest report-header-carries-the-spec-caveats
  (let [out (with-out-str (q/main ["--since" "2000-01-01" "--source-root" fixtures fixtures]))]
    (is (str/includes? out "caveat: static coverage is an upper bound"))
    (is (str/includes? out "caveat: efficiency couples coverage to CI time"))
    (is (str/includes? out "corpus "))
    ;; the two derivation caveats item 6 asks for, stated in the header
    (is (str/includes? out "dup-share by lines: regions are matched on TOKENS"))
    (is (str/includes? out "defects: renames credited to target via -M"))
    ;; duplicate issues carry the A-side span and the matched span
    (is (re-find #"duplicate\s+[0-9.]+\s+~ \S+:\d+-\d+ \(lines \d+\)" out))
    (is (re-find #"test/fixtures/quality/\S+:\d+-\d+\s+duplicate" out))))

(deftest no-paths-means-the-default-roots
  ;; `make quality` relies on this: no positional path measures
  ;; `default-paths`, per language.
  (let [opts (q/parse-args [])]
    (is (= [] (:paths opts)))
    (is (= ["pkg/rt/core" "scripts" "test"] (:lg q/default-paths)))
    (is (= ["pkg" "cmd"] (:go q/default-paths)))))
