(ns test.quality-generated-test
  (:require [clojure.string :as str]
            [quality :as q]
            [test :refer :all]))

(deftest generated-corpus-is-explicit-and-measures-compiler-output
  (let [dir (str (os/temp-dir) "/quality-generated-" (System/nanoTime))
        path (str dir "/core_go_lowered/sample_generated.go")
        report (str dir "/report.edn")]
    (os/sh "mkdir" "-p" (str dir "/core_go_lowered"))
    (try
      (spit path (str "// Code generated by test compiler. DO NOT EDIT.\n"
                      "package sample\nfunc Generated(x int) int {\n"
                      (apply str (repeat 11 "if x > 0 { x-- }\n"))
                      "return x\n}\n"))
      (let [out (with-out-str
                  (is (= 0 (q/main ["--generated" "--since" "2000-01-01"
                                     "--edn" report dir]))))
            r (read-string (slurp report))]
        (is (= 1 (get-in r [:inputs :corpus :files])))
        (is (= "generated" (get-in r [:inputs :corpus :tracked-by])))
        (is (= 1 (get-in r [:inputs :corpus :generated-included])))
        (is (= 12 (:cc (first (:top-complexity r)))))
        (is (= 1.0 (get-in r [:terms :erosion])))
        (is (nil? (get-in r [:terms :defects])))
        (is (nil? (get-in r [:terms :testing])))
        (is (str/includes? out "generated files included")))
      (with-out-str
        (is (= 2 (q/main ["--since" "2000-01-01" dir]))))
      (spit (str dir "/generated.lg") "(ns generated)\n(defn unused [] 1)\n")
      (with-out-str
        (is (= 0 (q/main ["--generated" "--since" "2000-01-01"
                          "--edn" report dir]))))
      (let [r (read-string (slurp report))]
        (is (= 2 (get-in r [:inputs :corpus :files])))
        (is (nil? (get-in r [:terms :dead])))
        (is (every? #(nil? (:dead %)) (:files r))))
      (finally (os/delete-tree dir)))))

(deftest generated-corpus-cannot-invent-a-git-baseline
  (is (thrown? Throwable (q/parse-args ["--generated" "--base" "HEAD"]))))

(deftest generated-corpus-counts-unmarked-files-correctly
  (let [dir (str (os/temp-dir) "/quality-generated-unmarked-" (System/nanoTime))
        path (str dir "/sample.go")
        report (str dir "/report.edn")]
    (os/sh "mkdir" "-p" dir)
    (try
      ;; File without any "// Code generated..." comment marker
      (spit path "package sample\nfunc Plain(x int) int {\nreturn x\n}\n")
      (let [out (with-out-str
                  (is (= 0 (q/main ["--generated" "--since" "2000-01-01"
                                    "--edn" report dir]))))
            r (read-string (slurp report))]
        (is (= 1 (get-in r [:inputs :corpus :files])))
        (is (= 1 (get-in r [:inputs :corpus :generated-included])))
        (is (str/includes? out "1 generated files included")))
      (finally (os/delete-tree dir)))))

