(ns test.unchecked-math-test
  (:require [test :refer :all]))

;; The unchecked-* family wraps int64 arithmetic. Floats have no int64
;; overflow to wrap, and Clojure keeps double arithmetic as doubles, so they
;; must pass through rather than being truncated through an int coercion.

(deftest unchecked-wraps-int64
  (is (= -9223372036854775808 (unchecked-add 9223372036854775807 1)))
  (is (= 9223372036854775807 (unchecked-subtract -9223372036854775808 1)))
  (is (= -2 (unchecked-multiply 9223372036854775807 2))))

(deftest unchecked-preserves-floats
  (is (= 4.0 (unchecked-add 1.5 2.5)))
  (is (= 1.5 (unchecked-subtract 4.0 2.5)))
  (is (= 3.0 (unchecked-multiply 1.5 2.0)))
  (is (= -1.5 (unchecked-negate 1.5))))

(deftest unchecked-preserves-other-numeric-types
  ;; Only int64 pairs wrap. Ratio, BigDecimal, Float32 and BigInt keep their
  ;; own arithmetic; coercing them to int64 would silently truncate.
  (is (= 1 (unchecked-add 1/2 1/2)))
  (is (= 2 (unchecked-multiply 1/2 4)))
  (is (= -1/2 (unchecked-negate 1/2)))
  (is (= 1.5M (unchecked-add 1M 0.5M)))
  (is (= 4.0 (unchecked-add (float 1.5) (float 2.5)))))

(deftest unchecked-mixed-int-and-float
  (is (= 3.5 (unchecked-add 1 2.5)))
  (is (= 3.5 (unchecked-add 2.5 1))))

(deftest unchecked-negate-still-wraps-ints
  (is (= -5 (unchecked-negate 5)))
  (is (= 5 (unchecked-negate -5))))

;; ---------------------------------------------------------------------------
;; *unchecked-math* is a COMPILE-TIME knob: the value when each form compiles
;; is what matters. CompileMultiple evaluates each top-level form before
;; compiling the next, so the set! below is visible to everything after it.
;; TestRunner runs each file under clean bindings, so nothing leaks out.
;; ---------------------------------------------------------------------------

(deftest checked-by-default
  (is (thrown? Exception (+ 9223372036854775807 1)))
  (is (thrown? Exception (inc 9223372036854775807))))

(set! *unchecked-math* true)

(deftest unchecked-math-binary
  (is (= -9223372036854775808 (+ 9223372036854775807 1)))
  (is (= 9223372036854775807 (- -9223372036854775808 1)))
  (is (= -2 (* 9223372036854775807 2))))

(deftest unchecked-math-unary-inc-dec
  (is (= -9223372036854775808 (inc 9223372036854775807)))
  (is (= 9223372036854775807 (dec -9223372036854775808))))

(deftest unchecked-math-higher-arity-left-nests
  (is (= -9223372036854775808 (+ 9223372036854775807 1 0)))
  (is (= -9223372036854775807 (+ 9223372036854775807 1 1)))
  (is (= -4 (* 9223372036854775807 2 2))))

(deftest unchecked-math-identity-arities-untouched
  (is (= 0 (+)))
  (is (= 1 (*)))
  (is (= 5 (+ 5)))
  (is (= 5 (* 5))))

(deftest unchecked-math-unary-minus-negates
  (is (= -5 (- 5)))
  (is (= 5 (- -5))))

(deftest unchecked-math-floats-stay-floats
  (is (= 4.0 (+ 1.5 2.5)))
  (is (= 3.0 (* 1.5 2.0)))
  (is (= -1.5 (- 1.5))))

(deftest unchecked-math-other-numeric-types-untouched
  ;; The compiler rewrite must not change these either: they route through the
  ;; numeric tower inside unchecked-*, so results match the checked ops.
  (is (= 1 (+ 1/2 1/2)))
  (is (= 2 (* 1/2 4)))
  (is (= -1/2 (- 1/2)))
  (is (= 1.5M (+ 1M 0.5M)))
  (is (= 4.0 (+ (float 1.5) (float 2.5)))))

(deftest unchecked-math-qualified-head
  (is (= -9223372036854775808 (clojure.core/+ 9223372036854775807 1))))

(deftest unchecked-math-respects-lexical-shadowing
  (is (= "ab" (let [+ str] (+ "a" "b"))))
  (is (= :shadowed (let [unchecked-add (fn [_ _] :shadowed)]
                     (unchecked-add 1 2)))))

(set! *unchecked-math* false)

(deftest checked-again-after-unset
  (is (thrown? Exception (+ 9223372036854775807 1))))
