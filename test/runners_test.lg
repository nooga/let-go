(ns test.runners-test
  (:require
   [test :refer :all]))

;; All helper namespaces are defined up front, before test.runners-test's
;; own deftests, so that *default-test-ns* (set by every deftest/set-test
;; as it runs) points at test.runners-test itself once this file finishes
;; loading — otherwise the harness's own (run-tests) driver call would run
;; whichever throwaway namespace's deftest happened to load last instead
;; of this file's real tests.

;; A throwaway namespace with two tests and fixtures, built at load time.
(ns test.runners-test.subject (:require [test :refer :all]))
(def log (atom []))
(use-fixtures :once (fn [f] (swap! log conj :once-in) (f) (swap! log conj :once-out)))
(use-fixtures :each (fn [f] (swap! log conj :each) (f)))
(deftest t-pass (is (= 1 1)))
(deftest t-fail (is (= 1 2)))

;; Hoisted to top level: `ns` inside a deftest body cannot forward-resolve
;; the namespace-qualified symbols the test then refers to (macroexpansion
;; happens before the (ns ...) call runs), per Task 13's brief fallback.
(ns test.runners-test.hooked (:require [test :refer :all]))
(def hook-log (atom []))
(use-fixtures :each (fn [f] (swap! hook-log conj :fixture) (f)))
(deftest hooked-test (swap! hook-log conj :ran))
(defn test-ns-hook [] (hooked-test))

;; The spec's whole-namespace zero-arg run cannot be exercised on
;; test.runners-test itself: that namespace's own tests are mid-run when
;; this one executes, so a nested (run-tests) here would discover this very
;; test var among its interns and recurse into it forever. Per the brief's
;; documented fallback, exercise the zero-arg default-to-current-ns
;; behavior — and run-all-tests's no-match arity, which per Clojure 1.12.5
;; falls back to the 0-arity (current ns), not {:type :summary} — on a
;; throwaway namespace switched into with in-ns instead.
(ns test.runners-test.zeroarg (:require [test :refer :all]))
(deftest zeroarg-t-pass (is (= 1 1)))

(ns test.runners-test)

(defn- quiet
  "Run f, discarding whatever it prints via report, but keep report's real
   dispatch (and so its counter-incrementing side effects) intact — unlike
   rebinding report itself to a no-op, which would also swallow :pass/
   :fail/:error counting and break every summary this file asserts on.
   with-test-out always prints through *test-out*, not *out*, so route
   *test-out* into with-out-str*'s capture buffer for the duration."
  [f]
  (let [result (atom nil)]
    (with-out-str* (fn [] (binding [*test-out* *out*] (reset! result (f)))))
    @result))

(deftest fixtures-are-per-namespace-metadata
  (let [m (meta (find-ns 'test.runners-test.subject))]
    (is (= 1 (count (:test/once-fixtures m))))
    (is (= 1 (count (:test/each-fixtures m))))
    (is (nil? (:test/each-fixtures (meta *ns*))))))

(deftest run-tests-returns-summary-and-runs-fixtures
  (reset! test.runners-test.subject/log [])
  (let [summary (quiet #(run-tests 'test.runners-test.subject))]
    (is (= {:test 2 :pass 1 :fail 1 :error 0 :type :summary} summary))
    (is (not (successful? summary)))
    (is (= [:once-in :each :each :once-out] @test.runners-test.subject/log))))

(deftest run-tests-events-are-ordered
  (let [events (atom [])]
    (binding [report (fn [m] (swap! events conj (:type m)))]
      (run-tests 'test.runners-test.subject))
    (is (= :begin-test-ns (first @events)))
    (is (= [:end-test-ns :summary] (take-last 2 @events)))
    (is (= 2 (count (filter #{:begin-test-var} @events))))))

(deftest run-test-var-runs-one
  (let [summary (quiet #(run-test-var (var test.runners-test.subject/t-pass)))]
    (is (= {:test 1 :pass 1 :fail 0 :error 0 :type :summary} summary))))

(deftest run-test-macro
  (is (= 1 (:test (quiet #(run-test test.runners-test.subject/t-pass))))))

(deftest run-all-tests-filters-with-re-matches
  (is (= 2 (:test (quiet #(run-all-tests #"test\.runners-test\.subject")))))
  ;; Clojure 1.12.5: a non-matching regex leaves run-tests with zero
  ;; namespace args, so it falls back to the 0-arity (current ns) — it does
  ;; NOT return a bare {:type :summary}. Exercise that from the throwaway
  ;; zeroarg ns, which has exactly one passing deftest, so the fallback is
  ;; observable without recursing into this file's own in-flight run.
  ;; nil is a deliberate leading no-op: a compiler quirk mistakes a literal
  ;; (in-ns ...) as the very first form of a nested body for a top-level
  ;; namespace switch, shifting compile-time *ns* for the REST OF THIS
  ;; FILE rather than just this closure's own runtime *ns* — confirmed by
  ;; isolated repro. Any leading form defeats the misdetection.
  (let [orig-ns *ns*]
    nil
    (in-ns 'test.runners-test.zeroarg)
    (try
      (is (= {:test 1 :pass 1 :fail 0 :error 0 :type :summary}
             (quiet #(run-all-tests #"no-such-ns-anywhere"))))
      (finally (in-ns (ns-name orig-ns))))))

(deftest test-ns-hook-bypasses-fixtures
  (reset! test.runners-test.hooked/hook-log [])
  (quiet #(run-tests 'test.runners-test.hooked))
  (is (= [:ran] @test.runners-test.hooked/hook-log)))

(deftest run-tests-no-args-runs-current-ns
  ;; The spec's whole-namespace zero-arg run cannot be exercised on
  ;; test.runners-test itself: that namespace's own tests are mid-run when
  ;; this test executes, so a nested (run-tests) here would discover this
  ;; very test var among its interns and recurse into it forever. Exercise
  ;; the zero-arg default-to-current-ns behavior on the throwaway zeroarg
  ;; namespace instead, switched into with in-ns.
  ;; See the leading nil in run-all-tests-filters-with-re-matches above for
  ;; why the (in-ns ...) below can't be the first form of the binding body.
  (let [orig-ns *ns*]
    (binding [report (fn [_])]
      nil
      (in-ns 'test.runners-test.zeroarg)
      (try
        (is (= 'test.runners-test.zeroarg (ns-name *ns*)))
        (is (map? (run-tests)))
        (finally (in-ns (ns-name orig-ns)))))))
