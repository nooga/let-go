(ns test.quality-graph-test
  (:require
   [quality.graph :as g]
   [test :refer :all]))

(def src [{:path "fixtures/quality/graph_src.lg" :text (slurp "fixtures/quality/graph_src.lg")}])
(def tst [{:path "fixtures/quality/graph_test_fixture.lg" :text (slurp "fixtures/quality/graph_test_fixture.lg")}])

(deftest references-preserve-qualified-symbols
  (let [refs (g/references (read-string "(g/public-a (str/join x))"))]
    (is (contains? refs 'g/public-a))
    (is (contains? refs 'str/join))
    (is (not (contains? refs 'public-a)))
    (is (not (contains? refs 'join)))))

(deftest qualified-call-does-not-create-a-local-name-collision-edge
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn foo [] 2)\n(defn caller [] (a/foo))\n"}]
        graph (g/build sources)]
    (is (= #{'a/foo} (get-in graph [:edges 'b/caller])))))

(deftest graph-edges-follow-calls
  (let [gr (g/build src)]
    (is (= #{'fixture.graph/helper} (get-in gr [:edges 'fixture.graph/public-a])))
    (is (= 4 (count (:defs gr))))))

(deftest roots-come-from-deftests-and-top-level-assertions
  (let [roots (g/test-roots tst)]
    (is (contains? roots 'fixture.graph/public-a))
    (is (contains? roots 'fixture.graph/public-b))))

(deftest coverage-reaches-transitively-and-lists-untested
  (let [c (g/coverage src tst)]
    (is (= 3 (:reached c)))     ; public-a, helper (via a), public-b
    (is (= 4 (:total c)))
    (is (= 75.0 (:percent c)))
    (is (= ['orphan] (map :name (:untested c))))
    (is (= ['fixture.graph/orphan] (map :qname (:untested c))))
    (is (= 5 (:line (first (:untested c)))))))

;; Two files both define `helper`. `fixture.alias-a/public-a` calls the
;; bare name `helper` -> priority 2 (same-namespace bare match) resolves
;; it to its own file's helper, not the corpus-wide-ambiguous fallback.
;; `fixture.alias-c/caller` also calls bare `helper` but has no helper of
;; its own, so it falls through to priority 3 (corpus-wide unique bare
;; match) -- which is ambiguous here (two `helper`s exist) -> no edge.
(def alias-a-text (slurp "fixtures/quality/graph_alias_a.lg"))
(def alias-b-text (slurp "fixtures/quality/graph_alias_b.lg"))
(def alias-c-text (slurp "fixtures/quality/graph_alias_c.lg"))
(def alias-abc-sources [{:path "a" :text alias-a-text}
                        {:path "b" :text alias-b-text}
                        {:path "c" :text alias-c-text}])

(deftest priority-2-same-namespace-bare-match-wins-over-ambiguous-corpus-match
  (let [gr (g/build alias-abc-sources)]
    (is (= #{'fixture.alias-a/helper} (get-in gr [:edges 'fixture.alias-a/public-a])))
    (is (= #{} (get-in gr [:edges 'fixture.alias-c/caller])))))

;; A test file requires fixture.alias-a under the alias `x` and calls
;; `(x/helper 1)`. Bare `helper` alone is ambiguous across a+b (priority
;; 3 fails), but alias resolution rewrites `x/helper` to
;; `fixture.alias-a/helper` before priority-1 matching, so it resolves
;; unambiguously to that specific definition.
(deftest alias-qualified-ref-resolves-via-require-as
  (let [alias-test-text (slurp "fixtures/quality/graph_alias_test_fixture.lg")
        sources [{:path "a" :text alias-a-text} {:path "b" :text alias-b-text}]
        tests [{:path "t" :text alias-test-text}]
        roots (g/test-roots tests)
        c (g/coverage sources tests)]
    (is (contains? roots 'fixture.alias-a/helper))
    (is (= 1 (:reached c)))
    (is (= 3 (:total c)))
    (is (= #{'public-a 'helper} (set (map :name (:untested c)))))))

(deftest bare-names-resolve-in-files-without-an-ns-form
  ;; Most scripts have no (ns ...) form, so the graph falls back to the path.
  ;; A symbol built straight from a path splits at its FIRST slash, which made
  ;; (name 'scripts/foo.lg/helper) read as "foo.lg/helper" and every bare-name
  ;; resolution against it fail silently -- so every such definition looked
  ;; unreachable. Slashes are mapped to dots to keep the name a real name.
  (let [src {:path "scripts/deep/tool.lg"
             :text "(defn- helper [x] (inc x))\n(defn run [x] (helper x))\n(run 1)\n"}
        g (g/build [src])
        roots (g/resolve-symbols g (g/top-level-refs [src]))]
    (is (= 1 (count roots)))
    ;; the entry call resolves, and the helper is reachable from it
    (is (= 2 (count (g/reachable g roots))))))

(deftest top-level-refs-see-registry-and-entry-forms
  ;; A registration in a top-level non-definition form is a real reference the
  ;; edge builder does not see, because it only walks definitions.
  (let [src {:path "lib.lg"
             :text "(ns lib)\n(defn- impl [x] x)\n(register! :thing impl)\n"}
        refs (g/top-level-refs [src])]
    (is (contains? refs 'impl))
    (is (contains? refs 'register!))
    ;; definitions themselves are not top-level refs
    (is (not (contains? (g/top-level-refs [{:path "d.lg" :text "(defn only [x] x)\n"}])
                        'only)))))

(deftest referred-name-resolves-despite-a-bare-name-collision
  ;; `foo` is defined in two namespaces, so the bare name alone is ambiguous.
  ;; A test that requires `[a :refer [foo]]` still reaches `a/foo`, and only it.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn foo [] 2)\n"}]
        tests [{:path "a_test.lg"
                :text "(ns a-test (:require [a :refer [foo]] [test :refer :all]))\n(deftest foo-works (is (= 1 (foo))))\n"}]
        c (g/coverage sources tests)]
    (is (= 1 (:reached c)))
    (is (= 2 (:total c)))
    (is (= ['b/foo] (map :qname (:untested c))))))

;; `:refer :all` and `:rename` are import forms this repository uses, and an
;; unhandled one is a silent FALSE NEGATIVE: the call is there, the graph does
;; not see it, and the definition is reported dead or untested. `:refer :all`
;; names nothing, so it is resolved against the definitions that namespace
;; actually has -- which is also what makes the collision rule below possible.

(deftest refer-all-resolves-despite-a-bare-name-collision
  ;; `foo` is defined in two namespaces. A test that pulls in only `a` with
  ;; `:refer :all` reaches `a/foo`, not nothing and not both.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn foo [] 2)\n"}]
        tests [{:path "a_test.lg"
                :text "(ns a-test (:require [a :refer :all] [test :refer :all]))\n(deftest foo-works (is (= 1 (foo))))\n"}]
        c (g/coverage sources tests)]
    (is (contains? (g/test-roots tests (:defs (g/build sources))) 'a/foo))
    (is (= 1 (:reached c)))
    (is (= 2 (:total c)))
    (is (= ['b/foo] (map :qname (:untested c))))))

(deftest refer-all-from-two-namespaces-defining-one-name-stays-ambiguous
  ;; Both namespaces are referred wholesale and both define `foo`, so the
  ;; reference is genuinely ambiguous. The documented rule for an ambiguous
  ;; bare name is NO edge rather than a guess, and `:refer :all` does not get
  ;; an exception to it.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn foo [] 2)\n"}]
        tests [{:path "ab_test.lg"
                :text "(ns ab-test (:require [a :refer :all] [b :refer :all] [test :refer :all]))\n(deftest foo-works (is (= 1 (foo))))\n"}]
        c (g/coverage sources tests)]
    (is (= 0 (:reached c)))
    (is (= ['a/foo 'b/foo] (map :qname (:untested c))))))

(deftest refer-all-only-claims-names-that-namespace-defines
  ;; A wholesale refer must not swallow every bare name in the file: `helper`
  ;; lives in `b`, so it still resolves there by unique bare name.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn helper [] 2)\n"}]
        tests [{:path "t.lg"
                :text "(ns t (:require [a :refer :all] [test :refer :all]))\n(deftest both (is (= 1 (foo))) (is (= 2 (helper))))\n"}]
        c (g/coverage sources tests)]
    (is (= 2 (:reached c)))
    (is (= [] (map :qname (:untested c))))))

(deftest an-explicit-refer-wins-over-a-wholesale-one
  ;; `[b :refer [foo]]` is the more specific statement, so it decides, even
  ;; though `a` is referred wholesale and also defines `foo`.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn foo [] 2)\n"}]
        tests [{:path "t.lg"
                :text "(ns t (:require [a :refer :all] [b :refer [foo]] [test :refer :all]))\n(deftest foo-works (is (= 2 (foo))))\n"}]
        c (g/coverage sources tests)]
    (is (= 1 (:reached c)))
    (is (= ['a/foo] (map :qname (:untested c))))))

(deftest renamed-import-resolves-to-the-original-definition
  ;; `[a :rename {foo renamed}]` binds the LOCAL name `renamed` to `a/foo`;
  ;; without it the call site mentions a name no definition has.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}]
        tests [{:path "a_test.lg"
                :text "(ns a-test (:require [a :rename {foo renamed}] [test :refer :all]))\n(deftest renamed-works (is (= 1 (renamed))))\n"}]
        c (g/coverage sources tests)]
    (is (contains? (g/test-roots tests (:defs (g/build sources))) 'a/foo))
    (is (= 1 (:reached c)))
    (is (= 1 (:total c)))
    (is (= [] (map :qname (:untested c))))))

(deftest rename-and-refer-all-are-applied-to-graph-edges-too
  ;; The rewrite is not a test-root special case: a production file's edges
  ;; go through the same resolution.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n(defn bar [] 2)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn foo [] 9)\n"}
                 {:path "c.lg"
                  :text "(ns c (:require [a :refer :all :rename {foo renamed}]))\n(defn caller [] (+ (renamed) (bar)))\n"}]
        gr (g/build sources)]
    (is (= #{'a/foo 'a/bar} (get-in gr [:edges 'c/caller])))))

(deftest a-top-level-entry-form-honours-refer-all-and-rename
  ;; Entry roots take the same path through `references-aliased`.
  (let [sources [{:path "a.lg" :text "(ns a)\n(defn foo [] 1)\n"}
                 {:path "b.lg" :text "(ns b)\n(defn foo [] 2)\n"}
                 {:path "run.lg"
                  :text "(ns run (:require [b :refer :all :rename {foo go}]))\n(go)\n"}]
        gr (g/build sources)]
    (is (contains? (g/entry-roots gr sources) 'b/foo))
    (is (not (contains? (g/entry-roots gr sources) 'a/foo)))
    (is (contains? (g/top-level-refs [(nth sources 2)] (:defs gr)) 'b/foo))))
