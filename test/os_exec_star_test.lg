;; os/exec* runs a command with inherited stdio and returns its exit code.
(ns test.os-exec-star-test
  (:require [test :refer :all]))

(deftest exec-star-exit-codes
  (testing "returns 0 for a successful command"
    (is (= 0 (os/exec* "true"))))
  (testing "returns the non-zero exit code of a failing command"
    (is (= 1 (os/exec* "false")))
    (is (= 3 (os/exec* "sh" "-c" "exit 3"))))
  (testing "coerces non-string args to strings"
    (is (= 0 (os/exec* "sh" "-c" "exit 0")))))

(deftest exec-star-follows-out-binding
  (testing "a writer-backed *out* (with-out-str) captures the child's stdout"
    (is (= "captured\n" (with-out-str (os/exec* "sh" "-c" "echo captured")))))
  (testing "a file-backed *out* receives the child's stdout directly"
    (let [tmp (str (os/temp-dir) "/exec-star-out-" (rand-int 1000000) ".txt")
          h (open tmp :append)]
      (binding [*out* h]
        (os/exec* "sh" "-c" "echo to-file"))
      (close! h)
      (is (= "to-file\n" (slurp tmp)))
      (delete-file tmp))))
