(ns test.ns-meta-test
  (:require
   [test :refer :all]))

(deftest ns-meta-starts-nil-and-alters
  (is (nil? (meta (find-ns 'test.ns-meta-test))))
  (alter-meta! *ns* assoc :k 1)
  (is (= 1 (:k (meta *ns*))))
  (alter-meta! *ns* update :k inc)
  (is (= 2 (:k (meta (find-ns 'test.ns-meta-test)))))
  (is (= {:k 2} (meta *ns*))))
