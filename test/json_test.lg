(ns test.json-test
  (:require [test :refer :all]
            [json :refer :all]))

(deftest json-read-numbers
  (testing "integers stay as ints"
    (is (= 42 (read-json "42")))
    (is (int? (read-json "42"))))

  (testing "floats are preserved"
    (is (= 1.5 (read-json "1.5")))
    (is (float? (read-json "1.5"))))

  (testing "whole floats become ints"
    (is (= 3 (read-json "3.0")))
    (is (int? (read-json "3.0")))))

(deftest json-read-structures
  (testing "arrays"
    (is (= [1 2 3] (read-json "[1,2,3]"))))

  (testing "objects with keywords"
    (let [m (read-json "{\"a\":1,\"b\":2}" {:keywords? true})]
      (is (= 1 (:a m)))
      (is (= 2 (:b m)))))

  (testing "nested structures"
    (let [m (read-json "{\"x\":[1,2.5],\"y\":null}" {:keywords? true})]
      (is (= [1 2.5] (:x m)))
      (is (nil? (:y m))))))

(deftest json-write-basic
  (testing "string"
    (is (= "\"hello\"" (write-json "hello"))))

  (testing "int"
    (is (= "42" (write-json 42))))

  (testing "float"
    (is (= "1.5" (write-json 1.5))))

  (testing "boolean"
    (is (= "true" (write-json true))))

  (testing "nil"
    (is (= "null" (write-json nil)))))

(deftest json-write-collections
  (testing "empty vector"
    (is (= "[]" (write-json []))))

  (testing "vector"
    (is (= "[1,2,3]" (write-json [1 2 3]))))

  (testing "nested empty vector"
    (is (= "{\"items\":[]}" (write-json {:items []}))))

  (testing "persistent map"
    (let [s (write-json {:a 1})]
      (is (= "{\"a\":1}" s))))

  (testing "nested"
    (let [s (write-json {:items [1 2.5 "x"]})]
      (is (includes? s "\"items\""))
      (is (includes? s "2.5")))))

(deftest json-write-string-map-keys
  (testing "string keys are encoded as JSON object keys, not quoted strings"
    (is (= "{\"key\":\"value\"}"
           (write-json {"key" "value"}))))

  (testing "nested string-key maps round-trip"
    (let [original {"outer" {"inner" 1}}]
      (is (= original (read-json (write-json original))))))

  (testing "empty, escaped, Unicode, and slash keys round-trip"
    (doseq [key ["" "a\"b" "snowman-☃" "a/b"]]
      (let [original {key "value"}]
        (is (= original (read-json (write-json original)))))))

  (testing "keyword keys retain their existing JSON spelling"
    (is (= "{\"key\":\"value\"}"
           (write-json {:key "value"})))))

(deftest json-roundtrip
  (testing "roundtrip preserves floats"
    (let [original {:price 9.99 :qty 3}
          json-str (write-json original)
          parsed (read-json json-str {:keywords? true})]
      (is (= 9.99 (:price parsed)))
      (is (= 3 (:qty parsed))))))

(deftest json-write-float32
  ;; (float x) yields a Float32, which reports FloatType but is a distinct
  ;; concrete type from Float (float64). write-json used to panic asserting it
  ;; straight to float64; values chosen exact in float32 to avoid drift.
  (testing "float32 scalar"
    (is (= "1.5" (write-json (float 1.5)))))

  (testing "float32 nested in a map"
    (is (= "{\"rate\":0.25}" (write-json {:rate (float 0.25)}))))

  (testing "float32 in a vector"
    (is (= "[2.5]" (write-json [(float 2.5)])))))

;; Integer literals decode exactly; through float64 they round above 2^53.
(deftest json-read-exact-integers
  (testing "both sides of 2^53"
    (is (= 9007199254740992 (read-json "9007199254740992")))
    (is (= 9007199254740993 (read-json "9007199254740993")))
    (is (= -9007199254740993 (read-json "-9007199254740993")))
    (is (= 9007199254740993 (get (read-json "{\"id\":9007199254740993}") "id"))))

  (testing "int64 limits stay ints"
    (is (= 9223372036854775807 (read-json "9223372036854775807")))
    (is (int? (read-json "9223372036854775807")))
    (is (= -9223372036854775808 (read-json "-9223372036854775808")))
    (is (int? (read-json "-9223372036854775808"))))

  (testing "past int64 becomes a BigInt, as the reader does"
    (is (= 9223372036854775808N (read-json "9223372036854775808")))
    (is (= -9223372036854775809N (read-json "-9223372036854775809")))
    (is (= 123456789012345678901234567890N (read-json "123456789012345678901234567890"))))

  (testing "decimal and exponent forms keep the float path"
    (is (= 1.5 (read-json "1.5")))
    (is (= 1000 (read-json "1e3")))
    (is (int? (read-json "1e3")))
    (is (= 0.001 (read-json "1e-3")))
    (is (float? (read-json "9.223372036854775808e18")))
    (is (= 0 (read-json "-0"))))

  (testing "malformed input is an error"
    (doseq [bad ["" "01" "1." ".5" "1e" "+1" "1 2" "[1,]" "{\"a\":1" "1e400" "NaN"]]
      (is (thrown? Exception (read-json bad)) bad))))
