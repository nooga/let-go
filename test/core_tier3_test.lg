(ns test.core-tier3-test
  (:require [test :refer :all]))

;; --- Bitwise ops ---

(deftest bit-and-test
  (testing "bit-and"
    (is (= 0 (bit-and 1 2)))
    (is (= 1 (bit-and 3 1)))
    (is (= 12 (bit-and 14 12)))))

(deftest bit-or-test
  (testing "bit-or"
    (is (= 3 (bit-or 1 2)))
    (is (= 7 (bit-or 5 3)))))

(deftest bit-xor-test
  (testing "bit-xor"
    (is (= 3 (bit-xor 1 2)))
    (is (= 6 (bit-xor 5 3)))))

(deftest bit-not-test
  (testing "bit-not"
    (is (= -1 (bit-not 0)))
    (is (= -2 (bit-not 1)))))

(deftest bit-shift-test
  (testing "bit-shift-left"
    (is (= 4 (bit-shift-left 1 2)))
    (is (= 16 (bit-shift-left 1 4))))
  (testing "bit-shift-right"
    (is (= 2 (bit-shift-right 8 2)))
    (is (= 1 (bit-shift-right 4 2)))))

(deftest unsigned-bit-shift-right-test
  (testing "unsigned-bit-shift-right"
    (is (= 2 (unsigned-bit-shift-right 8 2)))))

(deftest bit-test-test
  (testing "bit-test"
    (is (bit-test 5 0))       ;; 101 bit 0 = 1
    (is (not (bit-test 5 1))) ;; 101 bit 1 = 0
    (is (bit-test 5 2))))     ;; 101 bit 2 = 1

(deftest bit-set-clear-test
  (testing "bit-set"
    (is (= 5 (bit-set 4 0)))  ;; 100 | 001 = 101
    (is (= 7 (bit-set 5 1)))) ;; 101 | 010 = 111
  (testing "bit-clear"
    (is (= 4 (bit-clear 5 0)))  ;; 101 & ~001 = 100
    (is (= 1 (bit-clear 5 2))))) ;; 101 & ~100 = 001

;; --- Bitwise flag patterns ---

(deftest bitwise-flags
  (testing "flag manipulation"
    (let [read    1
          write   2
          execute 4
          perms (bit-or read write)]
      (is (bit-test perms 0))     ;; read set
      (is (bit-test perms 1))     ;; write set
      (is (not (bit-test perms 2))) ;; execute not set
      (is (= 7 (bit-or perms execute))))))

;; --- re-groups ---

(deftest re-groups-test
  (testing "re-groups finds all groups"
    (let [result (re-groups (re-pattern "(\\w+)@(\\w+)") "foo@bar baz@qux")]
      (is (= 2 (count result)))
      (is (= ["foo@bar" "foo" "bar"] (first result)))
      (is (= ["baz@qux" "baz" "qux"] (second result)))))
  (testing "re-groups with no match"
    (is (nil? (re-groups (re-pattern "\\d+") "abc"))))
  (testing "re-groups no capture groups"
    (let [result (re-groups (re-pattern "\\d+") "123 456")]
      (is (= 2 (count result)))
      (is (= ["123"] (first result)))
      (is (= ["456"] (second result)))))
  (testing "re-groups distinguishes unmatched and empty capture groups"
    (is (= [["b" nil]] (re-groups (re-pattern "(a)?b") "b")))
    (is (= [["b" ""]] (re-groups (re-pattern "(a*)b") "b")))))

;; --- Unchecked arithmetic (OP_UNCHECKED_ADD / SUB / MUL fast path) ---
;;
;; The bytecode compiler emits a dedicated opcode for the binary form, so
;; these pin the opcode's semantics against the core fn's: wrap at the
;; platform width, never promote, reject non-integers, and stay out of the
;; way when the name is shadowed or the arity is wrong.

(deftest unchecked-add-test
  (testing "unchecked-add wraps instead of overflowing"
    (is (= 5 (unchecked-add 2 3)))
    (is (= Long/MIN_VALUE (unchecked-add Long/MAX_VALUE 1)))
    (is (= -2 (unchecked-add Long/MAX_VALUE Long/MAX_VALUE))))
  (testing "checked + still refuses the same overflow"
    (is (thrown? Exception (+ Long/MAX_VALUE 1)))))

(deftest unchecked-subtract-test
  (testing "unchecked-subtract wraps instead of overflowing"
    (is (= -1 (unchecked-subtract 2 3)))
    (is (= Long/MAX_VALUE (unchecked-subtract Long/MIN_VALUE 1))))
  (testing "checked - still refuses the same overflow"
    (is (thrown? Exception (- Long/MIN_VALUE 1)))))

(deftest unchecked-multiply-test
  (testing "unchecked-multiply wraps instead of overflowing"
    (is (= 6 (unchecked-multiply 2 3)))
    (is (= 0 (unchecked-multiply Long/MIN_VALUE 2)))
    ;; xxh3's PRIME32_1 * PRIME32_3: a product that only fits after wrapping.
    (is (= 5964046043053701959 (unchecked-multiply 0x9E3779B1 0x85EBCA77))))
  (testing "checked * still refuses the same overflow"
    (is (thrown? Exception (* Long/MAX_VALUE 2)))))

(deftest unchecked-ops-reject-non-integers-test
  (testing "the opcode keeps the core fn's Int-only contract"
    (is (thrown? Exception (unchecked-add 1.5 1)))
    (is (thrown? Exception (unchecked-subtract 1 "2")))
    (is (thrown? Exception (unchecked-multiply nil 2)))))

(deftest unchecked-ops-stay-out-of-the-way-test
  (testing "a local shadowing the name wins over the fast opcode"
    (let [unchecked-add (fn [a b] :shadowed)]
      (is (= :shadowed (unchecked-add 1 2)))))
  (testing "wrong arity reaches the core fn's arity error"
    (is (thrown? Exception (unchecked-add 1)))
    (is (thrown? Exception (unchecked-multiply 1 2 3)))))
