;; A macro that inspects its argument with map?/set? must see the SOURCE
;; literal types inside a deftype method body, whether or not the literal
;; references a field.
;;
;; Field rewriting (dt-rewrite-field) runs over the method body BEFORE
;; expand-all, so it expands each macro call before rewriting inside it: the
;; macro receives the literal as written, and field references in its
;; expansion are rewritten afterwards. test/gold/macro_literal_kind_field.cljc
;; pins the same cases against JVM Clojure on the bytecode path.
(ns examples.macro-literal-kind)

(defmacro literal-kind [form]
  (cond
    (map? form) :map
    (set? form) :set
    :else       :other))

(defprotocol P (probe [this]))

(deftype T []
  P
  (probe [this]
    [(literal-kind {:a 1})
     (literal-kind #{1})]))

(deftype F [x]
  P
  (probe [this]
    [(literal-kind {x 1})
     (literal-kind {:k x})
     (literal-kind #{x})
     (when true (literal-kind {x x}))
     {x 1}
     #{x}]))

(defn run ^Object []
  [(probe (->T)) (probe (->F :field))])
