;; lgbgen:skip-go — multi-arity / macro forms do not emit valid Go; bytecode only

;; string namespace — string utility functions
;; Native builtins (trim, upper-case, etc.) are defined in core via Go.
;; This namespace re-exports them under the string/ prefix.
(ns string
  (:refer-clojure :exclude [ends-with? includes? index-of last-index-of lower-case replace reverse split starts-with? subs trim triml trimr upper-case]))

(defn join
  ([coll] (apply str coll))
  ([sep coll] (apply str (interpose sep coll))))

(defn replace [s match replacement]
  (str-replace s match replacement))

(defn replace-first [s match replacement]
  (str-replace-first s match replacement))

;;; Define upper-case early so it's available for capitalize.
;;; The bootstrap closure will be replaced at runtime by RegisterGeneratedPrimitives
;;; to use the native UpperCase implementation.
(defn upper-case [s]
  (when (nil? s)
    (throw (ex-info "upper-case expected non-nil" {:fn :string/upper-case :value s})))
  (core/upper-case (str s)))

(defn lower-case [s]
  (when (nil? s)
    (throw (ex-info "lower-case expected non-nil" {:fn :string/lower-case :value s})))
  (core/lower-case (str s)))

(defn- whitespace-char? [c]
  (or (= c \space)
      (= c \tab)
      (= c \newline)
      (= c \return)
      (= c \formfeed)))

(defn blank? [s]
  (cond
    (nil? s) true
    (not (string? s)) (throw (ex-info "blank? expected String" {:fn :string/blank? :value s}))
    :else (every? whitespace-char? (seq s))))

(defn reverse [s]
  (when (nil? s)
    (throw (ex-info "reverse expected non-nil" {:fn :string/reverse :value s})))
  (apply str (core/reverse (vec s))))

(defn capitalize [s]
  (when (nil? s)
    (throw (ex-info "capitalize expected non-nil" {:fn :string/capitalize :value s})))
  (let [s (str s)]
    (if (= "" s)
      s
      (str (upper-case (subs s 0 1)) (lower-case (subs s 1))))))

(defn index-of
  ([s value] (core/index-of s value))
  ([s value from-index] (core/index-of s value from-index)))

(defn last-index-of
  ([s value] (core/last-index-of s value))
  ([s value from-index] (core/last-index-of s value from-index)))

(defn escape [s cmap]
  (when (not (string? s))
    (throw (ex-info "escape expected String" {:fn :string/escape :value s})))
  (apply str (map (fn [c] (or (get cmap c) c)) s)))

(defn re-quote-replacement [replacement]
  replacement)

;; Re-export core builtins for string/ qualified access
(def trim core/trim)
(def triml core/triml)
(def trimr core/trimr)

(defn starts-with? [s substr]
  (when (nil? s)
    (throw (ex-info "starts-with? expected non-nil string" {:fn :string/starts-with? :value s})))
  (when (not (string? substr))
    (throw (ex-info "starts-with? expected String prefix" {:fn :string/starts-with? :value substr})))
  (core/starts-with? (str s) substr))

(defn ends-with? [s substr]
  (when (nil? s)
    (throw (ex-info "ends-with? expected non-nil string" {:fn :string/ends-with? :value s})))
  (when (not (string? substr))
    (throw (ex-info "ends-with? expected String suffix" {:fn :string/ends-with? :value substr})))
  (core/ends-with? (str s) substr))
(def includes? core/includes?)
;; Java Pattern.split semantics (what clojure.string/split delegates to):
;; limit 0 drops trailing empty fields, except that a string with no match
;; is returned as its own single field ("" -> [""]); limit > 0 yields at
;; most limit fields with the last holding the remainder; limit < 0 keeps
;; every field. core/split is the raw primitive (Go SplitN count).
(defn split
  ([s re] (split s re 0))
  ([s re limit]
   (if (zero? limit)
     (let [v (vec (core/split s re -1))]
       (if (= 1 (count v))
         v
         (loop [v v]
           (if (and (seq v) (= "" (peek v)))
             (recur (pop v))
             v))))
     (vec (core/split s re limit)))))

(defn split-lines [s]
  (split s #"\r?\n"))
(def subs core/subs)
