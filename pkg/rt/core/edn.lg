;; edn — EDN reading and writing
;;
;; read-string deliberately shadows clojure.core/read-string: this is the EDN
;; reader, and callers say (edn/read-string s). The :exclude states that the
;; shadow is intended, matching io/slurp and io/spit, and keeps the
;; warn-on-core-shadow check quiet during boot.
(ns edn
  (:refer-clojure :exclude [read-string])
  (:require
   [pprint]))

(defn read-string
  "Read one form with Clojure data semantics: metadata attaches to values that
   carry it, #{} reads as a set, #_ inside collections splices nothing, and
   nothing is evaluated."
  ([s] (core/read-data-string s)))

(defn read-all-string
  "Every top-level form of s with data semantics, as a vector."
  [s] (core/read-all-data-string s))

(defn write-string [form]
  (pr-str form))

;; deep-sort recursively reorders every map's keys into sorted order so that
;; serialization is deterministic regardless of how the map was built. Vector
;; and seq order is preserved (callers sort where order is semantic); scalars
;; pass through unchanged.
(defn deep-sort [form]
  (cond
    (map? form)    (reduce (fn [acc k] (assoc acc k (deep-sort (get form k))))
                           (sorted-map) (sort (keys form)))
    (vector? form) (mapv deep-sort form)
    :else          form))

;; pretty returns a deterministic, pretty-printed EDN string for `form`,
;; newline-terminated. Determinism comes from deep-sort (stable key order);
;; layout reuses the core pretty-printer. Suitable for committed,
;; diff-friendly artifacts.
(defn pretty [form]
  (str (pprint/pprint-str (deep-sort form)) "\n"))
