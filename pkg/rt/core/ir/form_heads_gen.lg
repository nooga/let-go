;; Code generator for form-heads dispatcher.
;;
;; Produces the form-heads-dispatcher function: cond chain derived from the catalog,
;; semantically equivalent to build-list's hardcoded form-head dispatch.
;; Single-sourced from the catalog replaces four hand-coded duplicates:
;;   1. build-list's cond chain
;;   2. free-vars's explicit handlers
;;   3. captures-of's explicit handlers
;;   4. The "special forms" set itself
;;
;; Generated artifact goes to pkg/rt/core/ir/form_heads/generated.lg,
;; compiled into the bundle (form dispatch is used by build-list at runtime).

;; lgbgen:skip

(ns ir.form-heads-gen
  (:require [ir.form-heads]))

;;Build the generated dispatcher source.
;; Returns a single string to write to the generated.lg file.
(defn emit-dispatcher-source []
  (let [heads (ir.form-heads/form-heads-catalog)]
    (str ";; Generated form-heads dispatcher (from pkg/rt/core/ir/form_heads_gen.lg)\n"
         ";; DO NOT EDIT — run `make generate` to regenerate.\n"
         "\n"
         "(ns ir.form-heads-generated)\n"
         "\n"
         ";; form-heads-dispatcher: cond chain derived from the catalog.\n"
         ";; Replaces build-list's hardcoded cond; semantically identical.\n"
         ";; Each form head matches to its handler; all others fall through to build-call.\n"
         "\n"
         "(defn form-heads-dispatcher [form ctx]\n"
         "  (let [head (first form)]\n"
         "    (cond\n"
         "      (empty? form)   (add-inst! ctx (ctx-block ctx) :const [] form)\n"
         (apply str
                (for [[head _fv? _co? _desc] heads]
                  (let [handler-name (str "build-" (name head))
                        head-sym (if (= head '.) "'." (str "'" (name head)))]
                    (format "      (= head %s)   (%s form ctx)\n" head-sym handler-name))))
         "      :else           (build-call form ctx))))\n"
         "\n"
         "(println \"ir.form-heads.generated dispatcher loaded\")\n")))

;; Emit the generated file by returning its content.
;; The gen-lisp function in scripts/generate.lg expects the final form to return
;; the content string, which it then spits to the file.
(emit-dispatcher-source)
