;;
;; ir.structurize — recover STRUCTURED control flow from the IR's
;; block-parameter SSA CFG.
;;
;; build.lg only ever emits `if` and `loop`/`recur` shapes, so the CFG it
;; produces is reducible. This pass walks that CFG and returns a
;; target-INDEPENDENT control tree:
;;
;;   [:return    bid]                 block bid's terminator is :return
;;   [:tail      bid]                 terminator is :recur-fn (function-level
;;                                    recur back-edge)
;;   [:seq       bid edge next]       :branch; edge = branch-target, then `next`
;;   [:if        bid tt et then else cont]
;;                                    :branch-if; tt/et = the true/false
;;                                    branch-targets (carry block-args),
;;                                    `cont` = structured join region (or nil)
;;   [:loop      bid body cont]       bid is a loop header; `body` uses
;;                                    :continue/:break; `cont` = region after
;;   [:continue  bid edge]            back-edge to the enclosing loop header
;;   [:break     bid edge]            edge exits the enclosing loop
;;   [:fallthrough bid]               region rejoins an enclosing continuation
;;   [:goto      bid]                 FALLBACK: unstructurable transfer
;;
;; lower_go (and a future wasm backend) walk this tree; `bid` leaves let the
;; backend emit each block's instructions + edge copies. The :goto escape
;; hatch means correctness never depends on full structural coverage — the
;; `:fallbacks` counter ratchets toward zero on the real corpus.

(ns ir.structurize
  (:require
   ;; ir.data interns ir/blocks, ir/block-term, … into the `ir` namespace;
   ;; require it so they resolve under the source-bootstrap loader (the bundle
   ;; bakes a load order, a fresh require does not).
   [ir.data]
   [ir.dominance :as dom]))

(declare structure structure-straight structure-loop)

;; --- generic Cooper/Harvey/Kennedy dominators ------------------------
;; A copy of dominance.lg's algorithm parameterized by succ/pred functions
;; and a root, so we can run it on the REVERSE graph to get post-dominators.

(defn- g-postorder [root succ-fn]
  (loop [stack   [[root (succ-fn root) 0]]
         visited #{root}
         post    []]
    (if (empty? stack)
      post
      (let [top   (peek stack)
            bid   (nth top 0)
            succs (nth top 1)
            si    (nth top 2)]
        (if (< si (count succs))
          (let [s      (nth succs si)
                stack' (assoc stack (dec (count stack)) [bid succs (inc si)])]
            (if (contains? visited s)
              (recur stack' visited post)
              (recur (conj stack' [s (succ-fn s) 0])
                     (conj visited s)
                     post)))
          (recur (pop stack) visited (conj post bid)))))))

(defn- g-intersect [idom rpo-idx b1 b2]
  (loop [b1 b1 b2 b2]
    (if (= b1 b2)
      b1
      (cond
        (> (nth rpo-idx b1) (nth rpo-idx b2)) (recur (nth idom b1) b2)
        (> (nth rpo-idx b2) (nth rpo-idx b1)) (recur b1 (nth idom b2))
        :else b1))))

(defn- g-refine [preds idom rpo-idx]
  (loop [ps preds new-id -1]
    (if (empty? ps)
      new-id
      (let [p (first ps)]
        (cond
          (= -1 (nth idom p)) (recur (rest ps) new-id)
          (= -1 new-id)       (recur (rest ps) p)
          :else               (recur (rest ps) (g-intersect idom rpo-idx p new-id)))))))

(defn- g-idoms [node-count root succ-fn pred-fn]
  (let [rpo     (vec (reverse (g-postorder root succ-fn)))
        rpo-idx (loop [i 0 idx (vec (repeat node-count -1))]
                  (if (>= i (count rpo))
                    idx
                    (recur (inc i) (assoc idx (nth rpo i) i))))
        idom0   (assoc (vec (repeat node-count -1)) root root)]
    (let [final (loop [idom idom0]
                  (let [step (loop [bs rpo idom idom changed? false]
                               (if (empty? bs)
                                 [idom changed?]
                                 (let [b (first bs)]
                                   (if (= b root)
                                     (recur (rest bs) idom changed?)
                                     (let [ni (g-refine (pred-fn b) idom rpo-idx)]
                                       (if (or (= -1 ni) (= (nth idom b) ni))
                                         (recur (rest bs) idom changed?)
                                         (recur (rest bs) (assoc idom b ni) true)))))))]
                    (if (nth step 1)
                      (recur (nth step 0))
                      (nth step 0))))]
      (assoc final root -1))))

(defn post-idoms [f]
  "Immediate post-dominators. ipdom[bid] = the nearest block that
   post-dominates bid (the join point of branches out of bid), or -1 for
   exit blocks / blocks that reach no exit. Computed as dominators of the
   reverse CFG rooted at a virtual exit node (id = block-count)."
  (let [n     (count (ir/blocks f))
        virt  n
        exits (filterv (fn [b] (empty? (dom/successors f b))) (range n))
        succ-fn (fn [b] (if (= b virt) exits (ir/block-preds b f)))
        pred-fn (fn [b]
                  (if (= b virt)
                    []
                    (let [fs (dom/successors f b)]
                      (if (empty? fs) [virt] fs))))
        idom (g-idoms (inc n) virt succ-fn pred-fn)]
    (mapv (fn [b]
            (let [d (nth idom b)]
              (if (= d virt) -1 d)))
          (range n))))

;; --- loop detection (self-contained; mirrors licm's natural loops) ----

(defn- header->latches [f]
  "Map loop-header block id -> vector of latch preds (preds the header
   dominates — the back-edge invariant). Only headers with >=1 latch.
   Computes the dominator tree once (dom/dominates? would recompute it
   per call)."
  (let [idom (dom/dominators f)
        dominates? (fn [a b]
                     (loop [b b]
                       (cond
                         (= -1 b) false
                         (= a b)  true
                         :else    (recur (nth idom b)))))]
    (reduce (fn [m header]
              (let [latches (filterv (fn [p] (dominates? header p))
                                     (ir/block-preds header f))]
                (if (empty? latches) m (assoc m header latches))))
            {}
            (ir/blocks f))))

(defn- reachable-back [f start avoid]
  "Blocks reachable from `start` by walking predecessors, not crossing
   `avoid` (the loop header). Used to compute the natural-loop body."
  (loop [visited #{start} frontier [start]]
    (if (empty? frontier)
      visited
      (let [b   (peek frontier)
            wl  (pop frontier)
            nps (filterv (fn [p] (and (not= p avoid) (not (visited p))))
                         (ir/block-preds b f))]
        (recur (into visited nps) (into wl nps))))))

(defn- loop-set-of [f header latches]
  "Set of blocks in the natural loop rooted at `header`: the header plus
   everything reachable backward from each latch without re-crossing it."
  (reduce (fn [s latch] (into s (reachable-back f latch header)))
          #{header}
          latches))

(defn- loop-exit-of [f loop-set ipdom header]
  "The single exit block of a loop, or :none / :multi. The exit is a block
   OUTSIDE loop-set that a loop block branches to. When several candidates
   exist we prefer the header's immediate post-dominator if it is one."
  (let [cands (reduce (fn [s b]
                        (reduce (fn [s2 t] (if (contains? loop-set t) s2 (conj s2 t)))
                                s
                                (dom/successors f b)))
                      #{}
                      loop-set)]
    (cond
      (empty? cands)      :none
      (= 1 (count cands)) (first cands)
      :else               (let [pd (nth ipdom header)]
                            (if (contains? cands pd) pd :multi)))))

;; --- context helpers --------------------------------------------------

(defn- continue-target? [ctx b]
  (some (fn [fr] (= (:header fr) b)) (:loops ctx)))

(defn- break-target? [ctx b]
  (some (fn [fr] (= (:exit fr) b)) (:loops ctx)))

(defn- fresh-header? [ctx b]
  (contains? (:headers ctx) b))

;; --- keyword-dispatch chain recognition --------------------------------
;; A right-nested `(cond (= g :a) … (= g :b) … default)` over constant keywords
;; otherwise lowers to an O(n) chain of equality tests. We recognise it HERE,
;; and fold it to a [:switch] node the lower-go tree-walk turns into a Go switch.

(defn- sz-const-kw [f nid]
  ;; the keyword literal when nid is a :const keyword inst, else nil
  (when (= :const (ir/op nid f))
    (let [a (ir/aux nid f)]
      (when (keyword? a) a))))

(defn- sz-blockarg-loc [f nid]
  ;; [block slot] when nid is a :block-arg (slot = its index in block-params)
  (when (= :block-arg (ir/op nid f))
    (loop [bs (ir/blocks f)]
      (when (seq bs)
        (let [b  (first bs)
              ps (ir/block-params b f)
              i  (loop [k 0]
                   (cond (>= k (count ps)) nil
                         (= (nth ps k) nid) k
                         :else (recur (inc k))))]
          (if i [b i] (recur (rest bs))))))))

(defn- sz-term-targets [f term]
  (let [op (ir/op term f) aux (ir/aux term f)]
    (cond
      (= op :branch)    [aux]
      (= op :branch-if) [(ir/cond-target-true aux) (ir/cond-target-false aux)]
      :else             [])))

(defn- sz-param-incoming [f b i]
  ;; nids feeding param slot i of block b across predecessor edges
  (let [acc (atom [])]
    (doseq [bp (ir/block-preds b f)]
      (let [term (ir/block-term bp f)]
        (when term
          (doseq [bt (sz-term-targets f term)]
            (when (= (ir/branch-target-target bt) b)
              (let [args (ir/branch-target-args bt)]
                (when (< i (count args)) (swap! acc conj (nth args i)))))))))
    @acc))

(defn- sz-canonical-disc [f nid]
  ;; Follow single-predecessor :block-arg copies back to the root value, so a
  ;; discriminant threaded through edges (`g = arg0`) unifies with its source.
  (loop [d nid fuel (count (ir/blocks f))]
    (if (<= fuel 0)
      d
      (let [loc (sz-blockarg-loc f d)]
        (if loc
          (let [inc (sz-param-incoming f (nth loc 0) (nth loc 1))]
            (if (= 1 (count inc)) (recur (nth inc 0) (dec fuel)) d))
          d)))))

(defn- sz-eq-kw [f bid]
  ;; [disc kw] when block bid ends in `branch-if (= X Y)` with exactly one of
  ;; X/Y a const keyword; `disc` is the OTHER operand, canonicalised. Else nil.
  (let [term (ir/block-term bid f)]
    (when (and term (= :branch-if (ir/op term f)))
      (let [tr (ir/refs term f)]
        (when (= 1 (count tr))
          (let [c (nth tr 0)]
            (when (= :eq (ir/op c f))
              (let [er (ir/refs c f)]
                (when (= 2 (count er))
                  (let [a (nth er 0) b (nth er 1)
                        ak (sz-const-kw f a) bk (sz-const-kw f b)]
                    (cond
                      (and bk (not ak)) [(sz-canonical-disc f a) bk]
                      (and ak (not bk)) [(sz-canonical-disc f b) ak]
                      :else nil)))))))))))

(defn- test-block-pure-eq-only? [f tb]
  ;; Check that a test block contains ONLY const and :eq instructions, no side effects.
  ;; A block is safe for absorption iff:
  ;; 1. It has zero block params
  ;; 2. All instructions are :const (loading literals)
  ;; 3. The only non-const instruction is a single :eq comparison
  ;; 4. The terminator is :branch-if referencing that :eq
  ;; If any other instructions exist (function calls, side effects, etc.), reject.
  (when (empty? (ir/block-params tb f))
    (let [insts (ir/block-insts tb f)
          term (ir/block-term tb f)
          eq-insts (filter (fn [i] (= :eq (ir/op i f))) insts)
          other-insts (filter (fn [i]
                                (let [op (ir/op i f)]
                                  (and (not= :eq op) (not= :const op))))
                              insts)]
      ;; Reject if there are non-const/eq instructions (side effects)
      ;; or if there are zero or multiple :eq instructions
      (and (empty? other-insts)
           (= 1 (count eq-insts))
           (= :branch-if (ir/op term f))))))

(defn- kw-chain-zero-params-shape? [f chain]
  ;; Maximally conservative gate: chain is absorbable ONLY IF every absorbed
  ;; test block has ZERO block params and contains ONLY const+eq instructions.
  ;; No other checks, no uses-analysis — when in doubt, reject (nested :if fallback is always sound).
  (every? (fn [tb]
            (test-block-pure-eq-only? f tb))
          (:test-blocks chain)))

(defn- collect-kw-chain [f b0]
  ;; Walk the else-spine from test block b0. Returns
  ;;   {:disc root :arms [[kw tt then-block] …]
  ;;    :last-et et :default-block e :test-blocks [b1 b2 …]}
  ;; when >= 3 arms share one canonical discriminant `root` with distinct const
  ;; keywords; else nil. `:test-blocks` excludes b0 (the switch owner) and the
  ;; default block — exactly the blocks absorbed (folded away) by the switch.
  (when-let [t0 (sz-eq-kw f b0)]
    (let [root (nth t0 0)]
      (loop [b b0 arms [] seen #{} tests []]
        (let [tk (sz-eq-kw f b)]
          (if (and tk (= (nth tk 0) root) (not (contains? seen (nth tk 1))))
            (let [kw   (nth tk 1)
                  ct   (ir/aux (ir/block-term b f) f)
                  tt   (ir/cond-target-true ct)
                  et   (ir/cond-target-false ct)
                  e    (ir/branch-target-target et)
                  arms' (conj arms [kw tt (ir/branch-target-target tt)])
                  seen' (conj seen kw)
                  ek   (sz-eq-kw f e)]
              (if (and ek (= (nth ek 0) root) (not (contains? seen' (nth ek 1))))
                (recur e arms' seen' (conj tests e))
                (when (>= (count arms') 3)
                  {:disc root :arms arms' :last-et et
                   :default-block e :test-blocks tests})))
            (when (>= (count arms) 3)
              (let [ct   (ir/aux (ir/block-term b f) f)
                    et   (ir/cond-target-false ct)]
                {:disc root :arms arms :last-et et
                 :default-block (ir/branch-target-target et) :test-blocks tests}))))))))

;; --- the structuring walk --------------------------------------------

(defn- edge->node [f ctx edge stop]
  "Resolve a branch-target edge to a control node: continue/break for loop
   edges, fallthrough when it rejoins an enclosing region, else structure
   the target inline."
  (let [t (ir/branch-target-target edge)]
    (cond
      (continue-target? ctx t) [:continue t edge]
      (break-target? ctx t)    [:break t edge]
      (= t stop)               [:fallthrough t]
      :else                    (structure f ctx t stop))))

(defn- structure-straight [f ctx b stop]
  (let [term (ir/block-term b f)
        op   (ir/op term f)]
    (cond
      (= op :return)    [:return b]
      (= op :recur-fn)  [:tail b]

      ;; build.lg no longer emits :tail-call — function-level recur is
      ;; :recur-fn now. Without this arm a stray one would land in the
      ;; :else fallback below and degrade to an unstructured :goto, which
      ;; is a silent miscompile risk rather than a visible regression.
      (= op :tail-call)
      (throw (str "ir/structurize: unexpected :tail-call terminator in block "
                  b " — build.lg emits :recur-fn for function-level recur"))

      (= op :branch)
      (let [edge (ir/aux term f)]
        [:seq b edge (edge->node f ctx edge stop)])

      (= op :branch-if)
      (let [chain (collect-kw-chain f b)
            ;; Reject the fold if any absorbed test block participates in loop
            ;; structure (header / continue / break) — those must keep their
            ;; own control node.
            chain (when (and chain
                             (not-any? (fn [tb]
                                         (or (fresh-header? ctx tb)
                                             (continue-target? ctx tb)
                                             (break-target? ctx tb)))
                                       (:test-blocks chain)))
                    chain)
            ;; Reject if absorbed blocks have non-zero params or non-const+eq shape.
            ;; Conservative gate: when in doubt, reject and fall back to nested :if.
            chain (when (and chain (kw-chain-zero-params-shape? f chain))
                    chain)
            ct (ir/aux term f)
            tt (ir/cond-target-true ct)
            et (ir/cond-target-false ct)
            t  (ir/branch-target-target tt)
            e  (ir/branch-target-target et)
            jn (nth (:ipdom ctx) b)
            valid-join? (and (>= jn 0)
                             (not= jn stop)
                             (not (continue-target? ctx jn))
                             (not (break-target? ctx jn)))
            arm-stop (if valid-join? jn stop)
            cont (if (and valid-join? (not= jn stop))
                   (structure f ctx jn stop)
                   nil)]
        (if chain
          ;; keyword-dispatch chain → one n-way [:switch] node
          (let [arm-nodes (mapv (fn [arm]
                                  [(nth arm 0) (nth arm 1)
                                   (edge->node f ctx (nth arm 1) arm-stop)])
                                (:arms chain))
                default-node (edge->node f ctx (:last-et chain) arm-stop)]
            ;; Collect instructions from root block b (also part of the switch)
            (when-let [term (ir/block-term b f)]
              (swap! (:absorbed-insts ctx) conj term)
              ;; Add the eq instruction (first ref of branch-if at root)
              (when (= :branch-if (ir/op term f))
                (let [tr (ir/refs term f)]
                  (when (= 1 (count tr))
                    (swap! (:absorbed-insts ctx) conj (nth tr 0))))))
            ;; Collect instructions from absorbed test blocks
            (doseq [tb (:test-blocks chain)]
              (swap! (:absorbed-blocks ctx) conj tb)
              ;; Only mark const and :eq instructions as absorbed, not arbitrary instructions
              (doseq [inst (ir/block-insts tb f)]
                (let [op (ir/op inst f)]
                  (when (or (= :const op) (= :eq op))
                    (swap! (:absorbed-insts ctx) conj inst))))
              (when-let [term (ir/block-term tb f)]
                (swap! (:absorbed-insts ctx) conj term)
                ;; Also add the eq instruction (first ref of branch-if)
                (when (= :branch-if (ir/op term f))
                  (let [tr (ir/refs term f)]
                    (when (= 1 (count tr))
                      (swap! (:absorbed-insts ctx) conj (nth tr 0)))))))
            [:switch b (:disc chain) arm-nodes (:last-et chain) default-node cont])
          ;; ordinary two-way branch
          (let [then-node (edge->node f ctx tt arm-stop)
                else-node (edge->node f ctx et arm-stop)]
            [:if b tt et then-node else-node cont])))

      :else
      (do (swap! (:fallbacks ctx) inc) [:goto b]))))

(defn- structure-loop [f ctx h stop]
  (let [latches  (get (:headers ctx) h)
        loop-set (loop-set-of f h latches)
        exit     (loop-exit-of f loop-set (:ipdom ctx) h)
        frame    {:header h :exit exit :set loop-set}
        ctx-in   (update ctx :loops conj frame)
        body     (structure-straight f ctx-in h :none)
        cont     (if (or (= exit :none) (= exit :multi))
                   nil
                   (structure f ctx exit stop))]
    (when (= exit :multi) (swap! (:fallbacks ctx) inc))
    [:loop h body cont]))

(defn- structure [f ctx b stop]
  (cond
    (= b stop)               [:fallthrough b]
    (continue-target? ctx b) [:continue b nil]
    (break-target? ctx b)    [:break b nil]
    (fresh-header? ctx b)    (structure-loop f ctx b stop)
    :else                    (structure-straight f ctx b stop)))

(defn structurize [f]
  "Build the structured control tree for IR function `f`. Returns
   {:tree <node> :fallbacks <int> :absorbed-blocks <set>} where :fallbacks is
   the number of regions that could not be structured (emitted as :goto), and
   :absorbed-blocks is the set of block IDs absorbed into :switch nodes.
   Callers should compute liveness with the absorbed-blocks to hide absorbed blocks
   from reachability analysis."
  (let [fallbacks (atom 0)
        absorbed-blocks (atom #{})
        absorbed-insts (atom #{})
        ctx {:ipdom    (post-idoms f)
             :headers  (header->latches f)
             :loops    []
             :fallbacks fallbacks
             :absorbed-blocks absorbed-blocks
             :absorbed-insts absorbed-insts}
        tree (structure f ctx (ir/fn-entry f) :none)
        absorbed (deref absorbed-blocks)
        absorbed-insts-set (deref absorbed-insts)]
    {:tree tree :fallbacks (deref fallbacks) :absorbed-blocks absorbed :absorbed-insts absorbed-insts-set}))
