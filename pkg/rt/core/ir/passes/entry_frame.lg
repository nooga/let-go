;; AOT native-entry frame generator (#425 Item 1).
;;
;; Projects lowering facts the compiler already holds — whether a recognized
;; main/-main form lowered, its Go name/arity shape, which packages to
;; blank-import — into a package-main Go file. gloat (or any orchestrator)
;; keeps go.mod / `go build` / program.lgb placement; we own the frame.
;;
;; Entry recognition:
;;   - name: main or -main (including defn- / ^:private)
;;   - arity: exactly [], [argv], or [& args] (#425). [fixed & rest] and
;;     other shapes fail generation with a source-level diagnostic.
;;   - lowered?: direct call into the lowered Go entry; else namespace-
;;     qualified VM InvokeProgramEntry fallback
;;
;; Lifecycle (standalone frame ownership):
;;   - Publishes *command-line-args* immediately after BootCore, before
;;     namespace replay, so top-level forms see the real argv.
;;   - Owns defer rt.ShutdownAllPods() (same contract as lg / lg-runtime).
;;
;; Private entries get a same-package NativeMain bridge so package main can
;; call across the package boundary.

(ns ir.passes.entry-frame
  (:require
   [clojure.string]
   [ir.build :as ir.build]
   [ir.lower-go :as lower-go]))

(def ^:private entry-names #{"main" "-main"})

(defn- entry-name? [nm]
  (contains? entry-names (str nm)))

(defn- unwrap-name [raw-name]
  "Strip (with-meta sym {...}) from a defn name position — same unwrap as
   ir.passes.pipeline/unwrap-name. Needed for `(defn ^long -main …)` / 
   `(defn ^:private -main …)` reader shapes."
  (if (and (seq? raw-name) (= 'with-meta (first raw-name)))
    (second raw-name)
    raw-name))

(defn- name-private? [raw-name]
  "True when the defn NAME carries ^:private — either as symbol meta or as
   the :private key on a (with-meta sym {...}) wrapper. Matches
   ir.passes.pipeline/private-name?."
  (cond
    (and (seq? raw-name) (= 'with-meta (first raw-name)) (>= (count raw-name) 3))
    (let [m (nth raw-name 2)]
      (boolean (and (map? m) (get m :private))))
    (symbol? raw-name)
    (boolean (:private (meta raw-name)))
    :else false))

(defn- skip-defn-preamble [xs]
  "After defn/defn- and name: skip optional docstring + attr-map, return the
   rest starting at the binding vector (or first arity list for multi-arity).
   A return-hinted `^long […]` reads as (with-meta […] …) — a seq, not a map —
   so it is left alone here and unwrapped by parse-entry-form."
  (cond
    (empty? xs) xs
    (string? (first xs)) (skip-defn-preamble (rest xs))
    (map? (first xs))    (skip-defn-preamble (rest xs))
    :else                xs))

(defn- index-of-amp [bvec]
  (loop [i 0]
    (cond
      (>= i (count bvec)) -1
      (= '& (nth bvec i)) i
      :else (recur (inc i)))))

(defn- arity-shape-of [bvec]
  "Classify a single-arity binding vector for the entry frame.
   :variadic    — [& args] only (& must be the first parameter)
   :vector      — [argv] (one arg; frame builds a string vector from os.Args)
   :none        — []
   :unsupported — [fixed & rest], multi-fixed without &, or other shapes
   nil          — not a binding vector"
  (when (vector? bvec)
    (let [n   (count bvec)
          amp (index-of-amp bvec)]
      (cond
        ;; [& args] — & in position 0. [fixed & rest] is NOT accepted: the
        ;; lowered Go signature takes a fixed param + rest slice, and a single
        ;; argv... expansion cannot supply both (#425 / #628).
        (= amp 0)                  :variadic
        (and (neg? amp) (zero? n)) :none
        (and (neg? amp) (= n 1))   :vector
        :else                      :unsupported))))

(defn- parse-entry-form [form]
  "If form is a defn/defn- of main/-main, return
   {:name :private? :arity-shape :binding :form}, else nil.
   :arity-shape may be :unsupported — callers must check entry-arity-error
   before emitting a frame.

   Reuses ir.build's return-hinted arity unwrap (#598) so spellings like
   `(defn -main ^long [] …)` and `(defn ^long -main [] …)` are recognized
   the same way the lowering pipeline sees them."
  (when (and (seq? form)
             (symbol? (first form))
             (or (= 'defn (first form)) (= 'defn- (first form))))
    (let [head     (first form)
          raw-name (second form)
          nm       (unwrap-name raw-name)]
      (when (and (symbol? nm) (entry-name? nm))
        (let [private? (or (= 'defn- head) (name-private? raw-name))
              body     (skip-defn-preamble (nnext form))
              raw-bvec (first body)
              bvec     (when (or (vector? raw-bvec)
                                 (ir.build/return-hinted-arity-vector? raw-bvec))
                         (ir.build/unwrap-arity-vector raw-bvec))
              shape    (arity-shape-of bvec)]
          (when (and bvec shape)
            {:name        (str nm)
             :private?    private?
             :arity-shape shape
             :binding     bvec
             :form        form}))))))

(defn entry-arity-error
  "Nil when entry has a supported arity; otherwise a clear diagnostic string
   suitable for lg-compile stderr. Supported shapes: [], [argv], [& args]."
  [entry]
  (when (and entry (= :unsupported (:arity-shape entry)))
    (str "native-entry: " (:name entry) " has unsupported arity "
         (pr-str (:binding entry))
         "; supported shapes are [], [argv], and [& args] (#425)")))

(defn find-program-entry
  "Scan forms (one namespace) for a recognized main/-main entry. Prefers
   -main when both are present (Clojure convention). Returns the entry map
   (including :unsupported arity shapes) or nil."
  [forms]
  (let [found (keep parse-entry-form forms)]
    (or (first (filter (fn [e] (= "-main" (:name e))) found))
        (first found))))

(defn entry-go-name
  "Pre-collision Go identifier estimate for an entry. Public → PascalCase
   (main/-main both → Main); private → unexported munge (main → main,
   -main → _main), via lower-go/go-name so the munge (incl. reserved-word
   handling) stays single-sourced with the lowered emitter.

   Does NOT consult *export-name-overrides*, so a colliding public -main
   (emitted as Main__main) is NOT visible here. Prefer analyze-entry with a
   :fn lowering record for the actual collision-resolved name."
  [entry]
  (if (:private? entry)
    (lower-go/go-name (:name entry))
    (lower-go/go-export-name (:name entry))))

(defn lookup-entry-fn
  "Find the lowering record for entry in a lower-ns-to-go-result :fns vector.
   Matches on source name (:fn-name). Returns nil when the entry did not lower."
  [fns entry]
  (when (and fns entry)
    (first (filter (fn [r] (= (:name entry) (:fn-name r))) fns))))

(defn- go-src-has-func? [go-src go-name]
  "Compat text scan: true when rendered Go contains `func <go-name>(`.
   Not used on the lg-compile critical path — prefer a :fn lowering record."
  (and (string? go-src)
       (clojure.string/includes? go-src (str "func " go-name "("))))

(defn- go-func-needs-error? [go-src go-name]
  "Compat text scan: true when the lowered func's result list includes error.
   Defaults to true (safer for call sites) when the signature line can't be
   parsed. Not used on the lg-compile critical path."
  (if-not (string? go-src)
    true
    (let [needle (str "func " go-name "(")
          idx    (clojure.string/index-of go-src needle)]
      (if (or (nil? idx) (neg? idx))
        true
        (let [line (first (clojure.string/split (subs go-src idx) #"\n"))
              after-params (let [c (clojure.string/index-of line ")")]
                             (when (and c (not (neg? c)))
                               (clojure.string/trim (subs line (inc c)))))]
          (or (nil? after-params)
              (clojure.string/includes? after-params "error")))))))

(defn- analyze-entry-from-fn
  "Preferred path: consume a lower-ns-to-go-result :fns record (or nil)."
  [entry fn-rec]
  (if fn-rec
    (let [gname (:go-name fn-rec)]
      (assoc entry
             :go-name      gname
             :lowered?     true
             :needs-error? (boolean (:needs-error? fn-rec))
             :call-name    (if (:private? entry) "NativeMain" gname)))
    (let [gname (entry-go-name entry)]
      (assoc entry
             :go-name      gname
             :lowered?     false
             :needs-error? true
             :call-name    (if (:private? entry) "NativeMain" gname)))))

(defn- analyze-entry-from-go-src
  "Compat fallback: recover lowered? / needs-error? by scanning rendered Go.
   Vulnerable to collision-resolved names (main/-main both estimate as Main)
   and formatting changes — keep only for callers holding source alone."
  [entry go-src]
  (let [gname (entry-go-name entry)
        ok?   (go-src-has-func? go-src gname)]
    (assoc entry
           :go-name      gname
           :lowered?     ok?
           :needs-error? (go-func-needs-error? go-src gname)
           :call-name    (if (:private? entry) "NativeMain" gname))))

(defn analyze-entry
  "Combine a discovered entry with lowering facts. Returns entry assoc'd with
   :go-name, :lowered?, :needs-error?, :call-name (NativeMain when private).

   Preferred:
     (analyze-entry entry {:fn fn-record})
   where fn-record is one element of (:fns (lower-ns-to-go-result …)) — or
   nil / omitted-via-lookup when the entry did not lower. When the :fn key is
   present it is authoritative; rendered source is not consulted.

   Compat:
     (analyze-entry entry {:go-src s})
     (analyze-entry entry go-src-string)
   recover facts by scanning rendered Go. Do not use on the lg-compile
   critical path (#657)."
  ([entry src-or-opts]
   (if (map? src-or-opts)
     (if (contains? src-or-opts :fn)
       (analyze-entry-from-fn entry (:fn src-or-opts))
       (analyze-entry-from-go-src entry (:go-src src-or-opts)))
     (analyze-entry-from-go-src entry src-or-opts))))

(defn- go-string-lit [s]
  (str "\"" (clojure.string/replace
              (clojure.string/replace s "\\" "\\\\")
              "\"" "\\\"") "\""))

(defn- emit-argv-setup [arity-shape]
  "Build boxed argv for the direct native call. *command-line-args* is already
   published in the boot sequence; this only constructs the call argument."
  (case arity-shape
    :none nil

    :variadic
    (str "\targv := make([]vm.Value, len(os.Args)-1)\n"
         "\tfor i, a := range os.Args[1:] {\n"
         "\t\targv[i] = vm.String(a)\n"
         "\t}\n")

    :vector
    (str "\targvItems := make([]vm.Value, len(os.Args)-1)\n"
         "\tfor i, a := range os.Args[1:] {\n"
         "\t\targvItems[i] = vm.String(a)\n"
         "\t}\n"
         "\targv := vm.NewArrayVector(argvItems)\n")))

(defn- emit-direct-call [pkg-alias call-name arity-shape needs-error?]
  (let [recv (str pkg-alias "." call-name)
        args (case arity-shape
               :none     "ec"
               :variadic "ec, argv..."
               :vector   "ec, argv")]
    (if needs-error?
      (str "\tif _, err := " recv "(" args "); err != nil {\n"
           "\t\tfmt.Fprint(os.Stderr, vm.FormatError(err))\n"
           "\t\tos.Exit(1)\n"
           "\t}\n")
      (str "\t" recv "(" args ")\n"))))

(defn- emit-vm-fallback [entry]
  "VM fallback when the entry did not lower: Invoke the selected namespace's
   main/-main Var. LoadProgramNamespaces has already replayed every NSOrder
   chunk (including MainChunk when it is one of them), so a bare
   RunProgramMainChunk would no-op for the common single-ns case. The argv is
   shaped to the entry's arity: :variadic spreads os.Args, :vector passes one
   string vector, :none passes nothing. Requires (:ns entry) — the source
   namespace that owns the selected entry."
  (let [var-name (if entry (:name entry) "-main")
        ns-name  (if entry (:ns entry) "")
        shape    (if entry (:arity-shape entry) :variadic)
        argv-setup
        (case shape
          :none
          "\targv := []vm.Value{}\n"

          :vector
          (str "\targvItems := make([]vm.Value, len(os.Args)-1)\n"
               "\tfor i, a := range os.Args[1:] {\n"
               "\t\targvItems[i] = vm.String(a)\n"
               "\t}\n"
               "\targv := []vm.Value{vm.NewArrayVector(argvItems)}\n")

          ;; :variadic (and the nil-entry default)
          (str "\targv := make([]vm.Value, len(os.Args)-1)\n"
               "\tfor i, a := range os.Args[1:] {\n"
               "\t\targv[i] = vm.String(a)\n"
               "\t}\n"))]
    (str argv-setup
         "\tif err := rt.InvokeProgramEntry(ec, "
         (go-string-lit ns-name) ", " (go-string-lit var-name)
         ", argv); err != nil {\n"
         "\t\tfmt.Fprint(os.Stderr, vm.FormatError(err))\n"
         "\t\tos.Exit(1)\n"
         "\t}\n")))

(defn emit-entry-bridge-go
  "Go source for a same-package NativeMain forwarding wrapper. pkg-name is
   the Go package clause identifier (leaf segment). Nil when no bridge needed."
  [pkg-name entry]
  (when (and entry (:lowered? entry) (:private? entry))
    (let [gname (:go-name entry)
          shape (:arity-shape entry)
          params (case shape
                   :none     "ec *vm.ExecContext"
                   :variadic "ec *vm.ExecContext, args ...vm.Value"
                   :vector   "ec *vm.ExecContext, arg0 vm.Value")
          call-args (case shape
                      :none     "ec"
                      :variadic "ec, args..."
                      :vector   "ec, arg0")
          result-sig (if (:needs-error? entry)
                       "(vm.Value, error)"
                       "vm.Value")]
      (str "// Code generated by lg-compile (#425 native-entry bridge). DO NOT EDIT.\n\n"
           "package " pkg-name "\n\n"
           "import \"github.com/nooga/let-go/pkg/vm\"\n\n"
           "// NativeMain is the cross-package reachability surface for a\n"
           "// private (defn- main …) / ^:private entry. package main calls\n"
           "// this; the lowered entry itself stays unexported.\n"
           "func NativeMain(" params ") " result-sig " {\n"
           "\treturn " gname "(" call-args ")\n"
           "}\n"))))

(defn emit-entry-frame-go
  "Generate package-main Go source for the AOT native-entry frame.

   opts:
     :entry          — analyze-entry result (required for direct entry; when
                       nil or :lowered? false, emits VM MainChunk fallback)
     :entry-import   — Go import path of the entry package
     :entry-alias    — import alias (default \"prog\")
     :blank-imports  — other lowered package import paths (for init() overrides)
     :lgb-file       — embed filename (default \"program.lgb\")"
  [opts]
  (let [entry         (:entry opts)
        entry-import  (:entry-import opts)
        entry-alias   (or (:entry-alias opts) "prog")
        blanks        (or (:blank-imports opts) [])
        lgb           (or (:lgb-file opts) "program.lgb")
        lowered?      (boolean (and entry (:lowered? entry)))
        call-name     (when lowered? (:call-name entry))
        shape         (when entry (:arity-shape entry))
        needs-error?  (if entry (:needs-error? entry) true)
        ;; Typed no-error [] entries call prog.Main(ec) with no argv boxing
        ;; and no FormatError — omit the vm import so go build stays clean.
        use-vm?       (or (not lowered?)
                          needs-error?
                          (contains? #{:vector :variadic} shape))
        import-lines
        (vec
          (concat
            ["\t_ \"embed\""
             "\t\"fmt\""
             "\t\"os\""
             ""]
            (when (and lowered? entry-import)
              [(str "\t" entry-alias " " (go-string-lit entry-import))])
            ;; Drop entry-import from the blank list only when it is already
            ;; the aliased import above (lowered?). When the entry did NOT
            ;; lower, keep it blank-imported so any sibling fns it lowered
            ;; still register their init() overrides.
            ;;
            ;; distinct because callers collect one :go-pkg per lowered spec,
            ;; and several specs share a package whenever a namespace spans
            ;; multiple files (or an input is passed twice). Go rejects a
            ;; repeated import, so the dedup belongs here at the emission
            ;; site rather than in any one caller.
            (mapv (fn [p] (str "\t_ " (go-string-lit p)))
                  (distinct
                    (filter (fn [p] (not (and lowered? (= p entry-import)))) blanks)))
            [""
             "\t\"github.com/nooga/let-go/pkg/rt\""]
            (when use-vm?
              ["\t\"github.com/nooga/let-go/pkg/vm\""])))
        boot
        ;; Order is load-bearing: publish *command-line-args* before namespace
        ;; replay so top-level forms see the real argv; own ShutdownAllPods
        ;; like lg / lg-runtime so pods opened during boot/load are cleaned up.
        (str "\tec, err := rt.BootCore()\n"
             "\tif err != nil {\n"
             "\t\tfmt.Fprintf(os.Stderr, \"BootCore: %v\\n\", err)\n"
             "\t\tos.Exit(1)\n"
             "\t}\n"
             "\tdefer rt.ShutdownAllPods()\n"
             "\trt.SetCommandLineArgs(os.Args[1:])\n"
             "\n"
             "\tunit, err := rt.DecodeExecUnit(programLGB)\n"
             "\tif err != nil {\n"
             "\t\tfmt.Fprintf(os.Stderr, \"decode program.lgb: %v\\n\", err)\n"
             "\t\tos.Exit(1)\n"
             "\t}\n"
             "\tif err := rt.LoadProgramNamespaces(unit); err != nil {\n"
             "\t\tfmt.Fprintf(os.Stderr, \"%v\\n\", err)\n"
             "\t\tos.Exit(1)\n"
             "\t}\n"
             "\n")
        entry-body
        (if lowered?
          (str (when-let [setup (emit-argv-setup shape)]
                 (str setup "\n"))
               (emit-direct-call entry-alias call-name shape needs-error?))
          (emit-vm-fallback entry))]
    (str "// Code generated by lg-compile (#425 native-entry frame). DO NOT EDIT.\n"
         "// native entry: "
         (if lowered?
           (str (:name entry) " → " entry-alias "." call-name
                " (" (name shape) ")")
           "none (VM MainChunk fallback)")
         "\n\n"
         "package main\n\n"
         "import (\n"
         (clojure.string/join "\n" import-lines)
         "\n)\n\n"
         "//go:embed " lgb "\n"
         "var programLGB []byte\n\n"
         "func main() {\n"
         boot
         entry-body
         "}\n")))

(defn entry-summary-line
  "Item 3 one-liner: 'N fns lowered; native entry: Main ✓' / 'none'."
  [n-lowered entry]
  (let [label (cond
                (nil? entry)                    "none"
                (not (:lowered? entry))         (str (:name entry) " (not lowered)")
                :else                           (str (:call-name entry) " ✓"))]
    (str n-lowered " fns lowered; native entry: " label)))
