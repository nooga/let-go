;; Loop fusion (deforestation): recognize and later deforest
;; (reduce g init (map f coll)) → transducer form.
;;
;; v1 recognizes the shape only: consumer is reduce, producer is map/filter/remove/keep,
;; both in the same block, producer is the direct refs[3] of the consumer.
;; No rewrite, no safety gate. Runs after Task 2; gate placement (Task 5) controls
;; actual pipeline integration via *enable-fusion*.
;;
;; Benefits both bytecode and lowered-Go backends by eliminating intermediate
;; LazySeq allocations and churn.

(ns ir.passes.fusion
  (:require
   [ir.data]
   [ir.passes.inline :as inline]
   [ir.passes.mutability :as mut]
   [ir.passes.purity :as purity]))

(def ^:dynamic *enable-fusion* false)

(def ^:private consumer-heads
  "Map supported consumer op names to the required arity when fusable."
  {"reduce" 3})

(def ^:private producer-heads
  "Set of supported producer op names (map, filter, remove, keep)."
  #{"map" "filter" "remove" "keep"})

(defn- core-head [f nid]
  "Callee symbol of a :call nid if it resolves to a clojure.core fn, else nil.
   Returns the bare name (e.g., 'reduce', 'map') if found, nil otherwise."
  (when (= :call (ir/op nid f))
    (let [v (inline/call-head-var f nid)]
      (when (and v (= "clojure.core" (namespace v)))
        (name v)))))

(defn match-chain [f nid]
  "Return a fusion match map for (reduce g init (map|filter|remove|keep f coll))
   rooted at consumer nid, or nil. Recognition only — no safety gate, no rewrite.
   v1: producer must be the DIRECT refs[3] call in the SAME block."
  (let [head (core-head f nid)]
    (when (and head (contains? consumer-heads head)
               (= (consumer-heads head) (ir/aux nid f)))
      (let [refs      (ir/refs nid f)
            coll-arg  (nth refs 3)
            prod-head (core-head f coll-arg)]
        (when (and prod-head (contains? producer-heads prod-head)
                   (= 2 (ir/aux coll-arg f))
                   (= (ir/block-of coll-arg f) (ir/block-of nid f)))
          (let [prod-refs (ir/refs coll-arg f)]
            {:consumer nid :consumer-kind head
             :producer coll-arg :producer-kind prod-head
             :g (nth refs 1) :init (nth refs 2)
             :xform-fn (nth prod-refs 1) :coll (nth prod-refs 2)}))))))

(defn fuse! [f match]
  "Rewrite (reduce g init (map f coll)) -> (transduce (map f) g init coll), in place.
   Reuses the producer as the arity-1 xform (SSA order preserved), inserts a
   transduce load-var before the consumer, mutates the consumer. dce cleans up later.
   Returns f."
  (let [{:keys [consumer producer g init xform-fn coll]} match
        prod-lv (nth (ir/refs producer f) 0)]
    (ir.data/set-refs! f producer [prod-lv xform-fn])
    (ir.data/set-aux! f producer 1)
    (let [tx-lv (ir.data/add-inst-before! f consumer :load-var [] (resolve 'clojure.core/transduce))]
      (ir.data/set-refs! f consumer [tx-lv producer g init coll])
      (ir.data/set-aux! f consumer 4))
    (ir.data/invalidate-uses! f)
    f))

(defn- callback-pure? [f xform-fn-nid var-facts]
  "The producer callback must be side-effect-free. Either a :load-var to a
   known/registered pure fn, or a :call whose head is a total-pure builtin.
   Conservative: unknown op -> false."
  (let [op (ir/op xform-fn-nid f)]
    (cond
      (= :load-var op)
      (let [v (try (symbol (ir/aux xform-fn-nid f)) (catch e nil))]
        (and v (or (contains? purity/pure-builtins [(namespace v) (name v)])
                   (purity/user-pure-fn? (namespace v) (name v)))))
      (= :call op) (purity/pure-call? f xform-fn-nid var-facts)
      :else false)))

(defn safe-to-fuse? [f match var-facts]
  "True only when fusion is provably behavior-preserving: producer's callee
   (map/filter/etc) is a stable load-var (not with-redefs'd/alter-var-root'd);
   producer result used exactly once (by the consumer) => non-escape
   (with match-chain's same-block); callback pure (required for chunked/short-circuit correctness).

   The producer's callee must be stable because fusion reuses its :load-var in place.
   The callback purity is required for chunking: if the callback is pure, then
   chunking is unobservable."
  (let [{:keys [producer consumer xform-fn]} match]
    (and
      ;; Producer callee (map/filter/etc) must be a STABLE load-var — not
      ;; with-redefs'd/alter-var-root'd — since we reuse its :load-var in place.
      (mut/stable-load-var? var-facts (ir/aux (nth (ir/refs producer f) 0) f))
      ;; Producer used exactly once, by consumer (non-escape guarantee)
      (let [bs (nth (ir/uses f) producer)]
        (and (= 1 (ir/uses-count bs)) (= consumer (ir/uses-first bs))))
      ;; Callback (xform-fn) is pure (required for chunked/short-circuit correctness)
      (callback-pure? f xform-fn var-facts))))
