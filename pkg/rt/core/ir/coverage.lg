;; SPDX-License-Identifier: MIT
;; ir.coverage — single source of truth for lowering coverage-failure
;; classification. Extracted from scripts/ir-stress.lg so the stress gate, the
;; emission engine, and any coverage dashboard share ONE taxonomy.
(ns ir.coverage
  (:require
   [clojure.string :as string]))

(defn classify-error [err-str]
  "Classify error into a bucket keyword.

   IMPORTANT: build.lg wraps unresolved-symbol errors as
   'ir/build: unresolved symbol X' — including special-form heads like
   set!/var/def/trace when build-list doesn't recognize them and they
   fall through to build-call → build-symbol. So we must check the
   special-form patterns BEFORE the generic 'unresolved symbol' regex,
   otherwise set!/var/def/trace failures get pooled into a single
   :unresolved-symbol bucket and the real cause is hidden.

   For genuinely-unresolved symbols (not special forms), bucket by the
   symbol name itself so we see one row per missing dep instead of
   one giant pile."
  (cond
    ;; Idempotent: an already-classified bucket (a keyword like
    ;; :validate/cross-block-ref, or an `:other | …` string produced by a
    ;; prior classify-error pass) must pass through unchanged, so re-running
    ;; the classifier over stored buckets doesn't double-wrap them.
    (keyword? err-str) err-str
    (and (string? err-str) (string/starts-with? err-str ":")) err-str
    :else
    (let [;; Scrub process-specific noise before truncating. Pointer addresses
          ;; (e.g. `<fn defn 0x2a9abf0be030>`) inside error strings push the
          ;; subs 0 100 cutoff to a different character on each run, so two
          ;; engines emit different `:other | ...` buckets even when the
          ;; semantic content is identical. Normalize the address to a
          ;; fixed marker so truncation lands at a stable spot.
          raw (str err-str)
          m   (string/replace raw #"0x[0-9a-fA-F]{6,}" "0xXXX")
          truncated (if (> (count m) 100) (str (subs m 0 100) "...") m)]
      (cond
        ;; Special-form heads first — these surface as 'unresolved symbol X'
        ;; because build-list has no case for them and falls into build-call.
        (re-find #"unresolved symbol set!" m)    :missing-form/set!
        (re-find #"unresolved symbol var$" m)    :missing-form/var
        (re-find #"unresolved symbol var " m)    :missing-form/var
        (re-find #"unresolved symbol def$" m)    :missing-form/def
        (re-find #"unresolved symbol def " m)    :missing-form/def
        (re-find #"unresolved symbol try" m)     :missing-form/try
        (re-find #"unresolved symbol trace" m)   :missing-form/trace

        ;; Genuinely-unresolved symbol: bucket by the symbol name.
        (re-find #"unresolved symbol" m)
        (let [match (re-find #"unresolved symbol ([^\s,)]+)" m)]
          (if match
            (keyword "unresolved" (second match))
            :unresolved-symbol))
        (re-find #"Can't resolve" m)
        (let [match (re-find #"Can't resolve ([^\s,)]+)" m)]
          (if match
            (keyword "unresolved" (second match))
            :unresolved-symbol))

        ;; Destructuring issues
        (re-find #"destructur" m)  :destructure-rejection

        ;; Bytecode-lowering (ir.lower) structural failures. These carry an
        ;; instruction index in the message — "value %42 not on stack" — so
        ;; without folding, every distinct %N becomes its own bucket and a
        ;; census over the corpus produces 130+ single-count rows instead of a
        ;; diagnosis.
        ;; Bucket by the CONSUMER op, which is the part that identifies the
        ;; shape that failed to lower.
        (re-find #"not on stack for materialize" m)
        (let [match (re-find #"op=:([a-z-]+)" m)]
          (if match
            (keyword "lower/not-on-stack" (second match))
            :lower/not-on-stack))

        (re-find #"unsupported op for lowering" m)
        (let [match (re-find #"unsupported op for lowering: :([a-z-]+)" m)]
          (if match
            (keyword "lower/unsupported-op" (second match))
            :lower/unsupported-op))

        ;; Build-form errors with structural cause.
        (re-find #"no :term" m)              :validate/no-term
        (re-find #"cross-block ref" m)       :validate/cross-block-ref
        (re-find #"is not a valid i" m)      :gogen/bad-identifier
        (re-find #"nth index must be an integer" m) :gogen/nth-non-int
        (re-find #"nested closure" m)        :lower-go/nested-closure
        (re-find #"unrecognized form" m)     :build/unrecognized-form

        ;; Everything else: store the actual error message
        :else (str ":other | " truncated)))))

(defn classify-bytecode-result [result]
  "Classify a `*target* :bytecode` compile-form result into :ok or a
   coverage-failure bucket, fail-loud: score :ok ONLY for shapes we can name as
   a success; classify everything else rather than silently counting it as
   coverage. This mirrors the *ir-compile-strict* posture — a silent downgrade
   must not read as a pass — and is the load-bearing half of the bytecode
   census (#580). Used by scripts/ir-stress.lg's try-lower-bytecode.

   Success shapes on the bytecode path:
     - a non-map native value — a *CodeChunk (single-arity) or a *MultiArityFn
       (multi-arity via make-multi-arity). A failed arity throws out of
       chunk->fn, so no partial-arity shape can escape here (this path has no
       :multi-fn-template result — that only arises under :go).
     - a {:status :lowered} status map.
   Failure channels:
     - a String — compile-form's error channel;
     - a {:status :fallback} map — classify its :reason;
     - ANY OTHER map — an unknown compile-form status variant; classified LOUD."
  (cond
    (string? result)
    (classify-error result)
    (not (map? result))
    :ok
    (= :lowered (:status result))
    :ok
    (= :fallback (:status result))
    (classify-error (or (:reason result) "no-reason"))
    :else
    (classify-error (str ":census/unexpected-result-shape " (pr-str result)))))
