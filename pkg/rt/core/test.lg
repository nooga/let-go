(ns test
  (:require
   [clojure.string :as str]
   [walk :refer [postwalk-replace]]))

;;; ---- Dynamic vars (spec 3.3) ------------------------------------------

(def ^:dynamic *load-tests* true)
(def ^:dynamic *stack-trace-depth* nil)
(def ^:dynamic *report-counters* nil)
(def ^:dynamic *initial-report-counters* {:test 0 :pass 0 :fail 0 :error 0})
(def ^:dynamic *testing-vars* (list))
(def ^:dynamic *testing-contexts* (list))

;; Bound by try-expr to the is form's {:file :line}; the only source of a
;; :fail event's position (spec 10.1).
(def ^:dynamic *assertion-position* nil)

;; Captured once from the host stdout (or the *out* root) so reporter output
;; is not swallowed by with-out-str around a runner (spec 10.2).
(def ^:dynamic *test-out* nil)
(register-test-out (var *test-out*))

(defmacro with-test-out [& body]
  `(binding [*out* *test-out*] ~@body))

;;; ---- Helpers (spec 10.3) -------------------------------------------------

(defn inc-report-counter [name]
  (when *report-counters*
    (dosync (commute *report-counters* update-in [name] (fnil inc 0)))))

(defn testing-vars-str [m]
  (let [{:keys [file line]} m]
    (str "(" (str/join " " (reverse (map (comp :name meta) *testing-vars*))) ")"
         " (" file ":" line ")")))

(defn testing-contexts-str []
  (str/join " " (reverse *testing-contexts*)))

(defn get-possibly-unbound-var [v]
  (try (var-get v)
       (catch Throwable _ nil)))

(defn successful? [summary]
  (and (zero? (:fail summary 0))
       (zero? (:error summary 0))))

;;; ---- Positions (spec 10.1) ------------------------------------------------

(defn- fail-position []
  (or *assertion-position*
      (let [v (first *testing-vars*)]
        (when (and v (:line (meta v)))
          {:file (:file (meta v)) :line (:line (meta v))}))
      {:file nil :line nil}))

(defn- internal-frame? [f]
  (let [n (str (:fn f))]
    (or (str/starts-with? n "test/")
        (str/starts-with? n "clojure.test/")
        (contains? #{"apply" "partial" "map" "reduce" "sort" "sort-by"} n)
        (str/starts-with? n "core/-dispatch")
        (str/starts-with? n "clojure.core/-dispatch"))))

(defn- error-position [thrown]
  (let [frames (drop-while internal-frame?
                           (or (when (resolve 'ex-trace) ((resolve 'ex-trace) thrown)) []))]
    (if (seq frames)
      {:file (:file (first frames)) :line (:line (first frames))}
      (fail-position))))

;;; ---- report (spec 3.1, 10.4) ---------------------------------------------

(defn render-actual [v]
  ;; Slice 1 adds trace rendering; until then every thrown value prints
  ;; with prn, which is also what Clojure prints for a value with no trace.
  (prn v))

(defmulti ^:dynamic report :type)

(defmethod report :default [m]
  (with-test-out (prn m)))

(defmethod report :pass [m]
  (with-test-out (inc-report-counter :pass)))

(defmethod report :fail [m]
  (with-test-out
    (inc-report-counter :fail)
    (println "\nFAIL in" (testing-vars-str m))
    (when (seq *testing-contexts*) (println (testing-contexts-str)))
    (when-let [message (:message m)] (println message))
    (println "expected:" (pr-str (:expected m)))
    (println "  actual:" (pr-str (:actual m)))))

(defmethod report :error [m]
  (with-test-out
    (inc-report-counter :error)
    (println "\nERROR in" (testing-vars-str m))
    (when (seq *testing-contexts*) (println (testing-contexts-str)))
    (when-let [message (:message m)] (println message))
    (println "expected:" (pr-str (:expected m)))
    (print "  actual: ")
    (render-actual (:actual m))))

(defmethod report :summary [m]
  (with-test-out
    (println "\nRan" (:test m) "tests containing"
             (+ (:pass m) (:fail m) (:error m)) "assertions.")
    (println (:fail m) "failures," (:error m) "errors.")))

(defmethod report :begin-test-ns [m]
  (with-test-out
    (println "\nTesting" (ns-name (:ns m)))))

(defmethod report :end-test-ns [m])
(defmethod report :begin-test-var [m])
(defmethod report :end-test-var [m])

(defn do-report [m]
  (report
    (case (:type m)
      :fail (merge (fail-position) m)
      :error (merge (error-position (:actual m)) m)
      m)))

;;; ---- Old shim state (Tasks 10-13 replace what uses these) ----------------

(def ^:dynamic *test-result* true)
(def ^:dynamic *registered-tests* {})
(def ^:dynamic *each-fixtures* [])
(def ^:dynamic *once-fixtures* [])

;; Renamed from the old *report-counters* to avoid colliding with the new
;; spec 3.3 var of the same name above: the old is/test-var*/run-tests
;; machinery bumps this via plain set!+update on an immutable map, while the
;; new *report-counters* is a ref bumped via commute (spec 10.3). Sharing one
;; name would make any do-report call inside an old-shim test run crash
;; ("swap expected Atom") or corrupt the ref's contents. Purely internal
;; state — no external caller (Go harness, other tasks) references it by
;; name — so the rename is safe. Tasks 10-13 delete this along with the rest
;; of the old shim.
(def ^:dynamic *legacy-report-counters* {:test 0 :pass 0 :fail 0 :error 0})

(defn clear-registered-tests! []
  (set! *registered-tests* {}))

(defn register-test! [v]
  (let [n *ns*
        xs (get *registered-tests* n [])]
    ;; Register each var once. Re-evaluating a deftest — sending it to the
    ;; REPL again after an edit — hands us the same var, and appending it
    ;; a second time would make run-tests run and count that test twice.
    (when-not (some (fn [x] (= x v)) xs)
      (set! *registered-tests* (assoc *registered-tests* n (conj xs v))))))

(defmacro deftest [name & body]
  `(do
     (def ~name (fn []
                  (set! *testing-vars* (conj *testing-vars* '~name))
                  (let [ret# (do ~@body)]
                    (set! *testing-vars* (pop *testing-vars*))
                    ret#)))
     ;; The same keys Clojure puts on a test var, attached at evaluation
     ;; time so :ns is the namespace the test was defined in. run-test-var
     ;; reads :ns to run a single test inside its own namespace, and :test
     ;; holds the test fn itself — as in clojure.test, where the runner
     ;; invokes (:test (meta v)).
     (alter-meta! (var ~name) assoc :ns *ns* :name '~name :test ~name)
     (register-test! (var ~name))))

(defn- thrown-form? [form]
  (and (seq? form)
       (or (= 'thrown? (first form))
           (= 'thrown-with-msg? (first form)))))

(defn- expand-is-thrown
  "Expansion for (is (thrown? Klass body...)) and
   (is (thrown-with-msg? Klass re body...)). Passes when the body throws a
   value satisfying (instance? Klass e) — and, for thrown-with-msg?, whose
   ex-message matches re. A normal return counts as :fail; a thrown value
   of the wrong class rethrows into the runner's catch and counts as
   :error, matching clojure.test. On pass, returns the caught value."
  [form msg]
  (let [with-msg? (= 'thrown-with-msg? (first form))
        klass (second form)
        re (when with-msg? (nth form 2))
        body (if with-msg? (drop 3 form) (drop 2 form))
        ;; Explicit gensym rather than an `e#` auto-gensym. The catch
        ;; binding and its uses below sit in SEPARATE syntax-quote forms,
        ;; and auto-gensym numbering restarts per syntax quote, so two `e#`
        ;; occurrences agree only by accident: they are both the first
        ;; auto-gensym in their own form. Add another auto-gensym ahead of
        ;; either one and the two names silently diverge. An explicit symbol
        ;; threads through the unquotes and does not depend on that.
        e (gensym "e__")
        pass `(do
                (set! *legacy-report-counters* (update *legacy-report-counters* :pass inc))
                ~(if msg
                   `(println "PASS" '~form "-" ~msg)
                   `(println "PASS" '~form)))
        fail `(do
                (set! *legacy-report-counters* (update *legacy-report-counters* :fail inc))
                (set! *test-result* false)
                ~(if msg
                   `(println "FAIL" '~form "-" ~msg)
                   `(println "FAIL" '~form))
                false)]
    `(try
       ~@body
       ~fail
       (catch ~e
         (if (instance? ~klass ~e)
           ~(if with-msg?
              `(if (re-find ~re (ex-message ~e))
                 (do ~pass ~e)
                 ~fail)
              `(do ~pass ~e))
           (throw ~e))))))

(defmacro is
  ([form]
   (if (thrown-form? form)
     (expand-is-thrown form nil)
     `(if ~form
        (do
          (set! *legacy-report-counters* (update *legacy-report-counters* :pass inc))
          (println "PASS" '~form)
          true)
        (do
          (set! *legacy-report-counters* (update *legacy-report-counters* :fail inc))
          (set! *test-result* false)
          (println "FAIL" '~form)
          false))))
  ([form msg]
   (if (thrown-form? form)
     (expand-is-thrown form msg)
     `(if ~form
        (do
          (set! *legacy-report-counters* (update *legacy-report-counters* :pass inc))
          (println "PASS" '~form "-" ~msg)
          true)
        (do
          (set! *legacy-report-counters* (update *legacy-report-counters* :fail inc))
          (set! *test-result* false)
          (println "FAIL" '~form "-" ~msg)
          false)))))

(defn compose-fixtures
  "Compose two fixture fns into one that wraps f around g around the test fn."
  [f g]
  (fn [t] (f (fn [] (g t)))))

(defn default-fixture
  "Fixture that adds nothing: it just calls the test fn."
  [t]
  (t))

(defn join-fixtures
  "Compose a collection of fixture fns into a single fixture fn."
  [fs]
  (reduce compose-fixtures default-fixture fs))

(defn- test-var*
  "Run one test var inside *each-fixtures*, counting a thrown body as an
   :error instead of letting it escape. Shared by run-tests and
   run-test-var so a single-var run and a whole-suite run cannot drift.
   Runs the fn in the var's :test metadata, as clojure.test does, and
   falls back to the var's value for a plain fn var."
  [tv]
  (set! *testing-contexts* [])
  (try
    (let [test-fn (or (:test (meta tv)) (deref tv))]
      ((join-fixtures *each-fixtures*) (fn [] (test-fn))))
    (catch e
      (set! *testing-contexts* [])
      (set! *legacy-report-counters* (update *legacy-report-counters* :error inc))
      (set! *test-result* false)
      (println "ERROR in test:" e))))

(defn run-tests [& nss]
  (set! *legacy-report-counters* {:test 0 :pass 0 :fail 0 :error 0})
  (set! *test-result* true)
  (println "Running tests...")
  ((join-fixtures *once-fixtures*)
   (fn []
     (if (seq nss)
       (doseq [s nss]
         (let [old-ns *ns*]
           (in-ns s)
           (doseq [t (get *registered-tests* *ns* [])]
             (set! *legacy-report-counters* (update *legacy-report-counters* :test inc))
             (test-var* t))
           (in-ns (symbol (name old-ns)))))
       ;; Run every registered ns's tests IN that ns, so runtime name
       ;; resolution inside a test (resolve, *ns*, aliases) matches the ns
       ;; the test was defined in — not whatever ns run-tests was called from.
       ;; Keys are namespace objects, so derive the name via ns-name.
       (doseq [[s bs] *registered-tests*]
         (let [old-ns *ns*]
           (in-ns (ns-name s))
           (doseq [t bs]
             (set! *legacy-report-counters* (update *legacy-report-counters* :test inc))
             (test-var* t))
           (in-ns (ns-name old-ns)))))))
  (let [c *legacy-report-counters*]
    (println "Finished running tests. Tests:" (:test c) "Pass:" (:pass c) "Fail:" (:fail c) "Error:" (:error c))
    (set! *test-result* (and (= 0 (:fail c)) (= 0 (:error c))))))

(defn run-test-var
  "Run a single test var and return the report counters
   ({:test :pass :fail :error}). The var runs through the same
   *once-fixtures* / *each-fixtures* composition as run-tests, and inside
   the namespace it was defined in (:ns of its metadata, which deftest
   attaches), so one test behaves the way the whole suite does. A thrown
   test body counts as an :error rather than escaping. This is what editors
   call to run the test under the cursor; see also the run-test macro.

   The counters are bound, not set, for the duration of the run — as
   clojure.test does — so running one test from inside another test, or
   from a REPL in the middle of a suite, cannot overwrite the enclosing
   run's tally or clear its failure flag."
  [v]
  (let [old-ns *ns*]
    (binding [*legacy-report-counters* {:test 1 :pass 0 :fail 0 :error 0}
              *test-result* true
              *testing-contexts* []]
      (in-ns (ns-name (or (:ns (meta v)) *ns*)))
      (try
        ((join-fixtures *once-fixtures*) (fn [] (test-var* v)))
        (finally
          (in-ns (ns-name old-ns))))
      (let [c *legacy-report-counters*]
        (println "Finished running test. Tests:" (:test c) "Pass:" (:pass c) "Fail:" (:fail c) "Error:" (:error c))
        c))))

(defmacro run-test
  "Run the named test and return its report counters:
   (run-test my-test). Sugar for (run-test-var (var my-test))."
  [name]
  `(run-test-var (var ~name)))

;; testing-contexts-str is defined above (spec 10.3); reused here unchanged.

(defmacro testing [description & body]
  `(do
     (set! *testing-contexts* (conj *testing-contexts* ~description))
     (println "Testing:" (testing-contexts-str))
     (let [ret# (do ~@body)]
       (set! *testing-contexts* (pop *testing-contexts*))
       ret#)))

(defn apply-template
  [argv expr values]
  (postwalk-replace (zipmap argv values) expr))

(defmacro do-template
  [argv expr & values]
  (let [c (count argv)]
    `(do ~@(map (fn [a] (apply-template argv expr a))
                (partition c values)))))

(defmacro are [argv expr & args]
  `(do-template ~argv (is ~expr) ~@args))

; simple fixtures API (global per session)
(defn use-fixtures [phase & fs]
  (cond
    (= phase :each) (set! *each-fixtures* fs)
    (= phase :once) (set! *once-fixtures* fs)
    :else nil))

; basic clojure.test shim for stock tests
