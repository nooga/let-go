(ns test
  (:require
   [clojure.string :as str]
   [walk :refer [postwalk-replace]]))

;;; ---- Dynamic vars (spec 3.3) ------------------------------------------

(def ^:dynamic *load-tests* true)
(def ^:dynamic *stack-trace-depth* nil)
(def ^:dynamic *report-counters* nil)
(def ^:dynamic *initial-report-counters* {:test 0 :pass 0 :fail 0 :error 0})
(def ^:dynamic *testing-vars* (list))
(def ^:dynamic *testing-contexts* (list))

;; Bound by try-expr to the is form's {:file :line}; the only source of a
;; :fail event's position (spec 10.1).
(def ^:dynamic *assertion-position* nil)

;; Captured once from the host stdout (or the *out* root) so reporter output
;; is not swallowed by with-out-str around a runner (spec 10.2).
(def ^:dynamic *test-out* nil)
(register-test-out (var *test-out*))

(defmacro with-test-out [& body]
  `(binding [*out* *test-out*] ~@body))

;;; ---- Helpers (spec 10.3) -------------------------------------------------

(defn inc-report-counter [name]
  (when *report-counters*
    (dosync (commute *report-counters* update-in [name] (fnil inc 0)))))

(defn testing-vars-str [m]
  (let [{:keys [file line]} m]
    (str "(" (str/join " " (reverse (map (comp :name meta) *testing-vars*))) ")"
         " (" file ":" line ")")))

(defn testing-contexts-str []
  (str/join " " (reverse *testing-contexts*)))

(defn get-possibly-unbound-var [v]
  (try (var-get v)
       (catch Throwable _ nil)))

(defn successful? [summary]
  (and (zero? (:fail summary 0))
       (zero? (:error summary 0))))

;;; ---- Positions (spec 10.1) ------------------------------------------------

(defn- fail-position []
  (or *assertion-position*
      (let [v (first *testing-vars*)]
        (when (and v (:line (meta v)))
          {:file (:file (meta v)) :line (:line (meta v))}))
      {:file nil :line nil}))

(defn- internal-frame? [f]
  (let [n (str (:fn f))]
    (or (str/starts-with? n "test/")
        (str/starts-with? n "clojure.test/")
        (contains? #{"apply" "partial" "map" "reduce" "sort" "sort-by"} n)
        (str/starts-with? n "core/-dispatch")
        (str/starts-with? n "clojure.core/-dispatch"))))

(defn- error-position [thrown]
  (let [frames (drop-while internal-frame?
                           (or (when (resolve 'ex-trace) ((resolve 'ex-trace) thrown)) []))]
    (if (seq frames)
      {:file (:file (first frames)) :line (:line (first frames))}
      (fail-position))))

;;; ---- report (spec 3.1, 10.4) ---------------------------------------------

(defn render-actual [v]
  ;; Slice 1 adds trace rendering; until then every thrown value prints
  ;; with prn, which is also what Clojure prints for a value with no trace.
  (prn v))

(defmulti ^:dynamic report :type)

(defmethod report :default [m]
  (with-test-out (prn m)))

(defmethod report :pass [m]
  (with-test-out (inc-report-counter :pass)))

(defmethod report :fail [m]
  (with-test-out
    (inc-report-counter :fail)
    (println "\nFAIL in" (testing-vars-str m))
    (when (seq *testing-contexts*) (println (testing-contexts-str)))
    (when-let [message (:message m)] (println message))
    (println "expected:" (pr-str (:expected m)))
    (println "  actual:" (pr-str (:actual m)))))

(defmethod report :error [m]
  (with-test-out
    (inc-report-counter :error)
    (println "\nERROR in" (testing-vars-str m))
    (when (seq *testing-contexts*) (println (testing-contexts-str)))
    (when-let [message (:message m)] (println message))
    (println "expected:" (pr-str (:expected m)))
    (print "  actual: ")
    (render-actual (:actual m))))

(defmethod report :summary [m]
  (with-test-out
    (println "\nRan" (:test m) "tests containing"
             (+ (:pass m) (:fail m) (:error m)) "assertions.")
    (println (:fail m) "failures," (:error m) "errors.")))

(defmethod report :begin-test-ns [m]
  (with-test-out
    (println "\nTesting" (ns-name (:ns m)))))

(defmethod report :end-test-ns [m])
(defmethod report :begin-test-var [m])
(defmethod report :end-test-var [m])

(defn do-report [m]
  (report
    (case (:type m)
      :fail (merge (fail-position) m)
      :error (merge (error-position (:actual m)) m)
      m)))

;;; ---- Old shim state (Tasks 10-13 replace what uses these) ----------------

(def ^:dynamic *test-result* true)
(def ^:dynamic *each-fixtures* [])
(def ^:dynamic *once-fixtures* [])

(defn clear-registered-tests!
  "No-op. There is no test registry any more (spec 7): a test is any var
   with a fn under its :test metadata. Kept only so the Go harness
   (test/language_test.go, test/zz_compat_test.go, test/zz_bench_test.go),
   which still calls this between runs, keeps compiling; Task 14 migrates
   the harness off it."
  [])

;;; ---- Running one var (spec 9.1) ---------------------------------------

;; Defined ahead of deftest et al (spec 7 below), which reference test-var
;; inside their own syntax-quote templates: this dialect's syntax-quote
;; only namespace-qualifies a symbol it can already resolve at the point
;; the enclosing form is read, so a forward reference here would splice a
;; bare, unqualified `test-var` into every macroexpansion — resolvable
;; only in a caller that happens to `(:require [test :refer :all])`, and a
;; "Can't resolve test-var in this context" compile error in any caller
;; that requires test some other way (e.g. `[clojure.test :as t]`).

(defn test-var*
  "Run one test var, as clojure.test's test-var does: emits :begin-test-var,
   counts it, runs the fn under its :test metadata (catching any escaping
   throw as an :error rather than letting it propagate), then emits
   :end-test-var. A var with no :test metadata is not a test — returns nil
   without reporting anything."
  [v]
  (when-let [t (:test (meta v))]
    (binding [*testing-vars* (conj *testing-vars* v)]
      (do-report {:type :begin-test-var :var v})
      (inc-report-counter :test)
      (try (t)
           (catch Throwable e
             (do-report {:type :error
                         :message "Uncaught exception, not in assertion."
                         :expected nil :actual e})))
      (do-report {:type :end-test-var :var v}))))

(def ^:dynamic test-var test-var*)

;;; ---- Defining tests (spec 7) -----------------------------------------

;; def's metadata-map form (`(def ^{:k v} name val)`) takes its map as a
;; literal constant — the compiler reads it straight off the form (see
;; compiler.go's defCompiler) rather than evaluating it, so a :test entry
;; built there would hold an unevaluated `(fn [] ...)` list, not a callable
;; fn. So deftest defines the var first, then attaches :test via
;; alter-meta!, whose argument position is evaluated normally.

;; The last namespace a test-defining form ran in — set by deftest,
;; deftest-, with-test and set-test as they run, read by run-tests' no-arg
;; form (spec 9.2) as its default namespace.
;;
;; Real Clojure's zero-arg (run-tests) just reads *ns*. It is unreliable
;; here: the Go test harness (test/language_test.go) compiles a file, then
;; compiles the separate driver string "(run-tests)" via
;; compiler.NewCompiler(consts, rt.NS("test")) — whose constructor resets
;; the *ns* Var's root to the `test` namespace itself before that string
;; even runs, out from under the file whose tests it means to run (`all-ns`
;; over every namespace ever loaded in the process was tried and rejected:
;; with 200+ corpus files sharing one runtime, it re-runs every earlier
;; file's tests on every later file's (run-tests) call). *default-test-ns*
;; is not a var registry — it holds only the single most-recently-active
;; test-defining namespace — so it survives that reset and still points at
;; the right namespace when run-tests actually executes.
(def ^:dynamic *default-test-ns* nil)

(defmacro deftest
  "Defines a test function with no arguments. Test functions may call other
   tests, so tests may be composed. The var's :test metadata holds the body;
   calling the var runs it through test-var with reporting."
  [name & body]
  (when *load-tests*
    `(do (def ~name (fn [] (test-var (var ~name))))
         (alter-meta! (var ~name) assoc :test (fn [] ~@body))
         (set! *default-test-ns* *ns*))))

(defmacro deftest-
  "Like deftest but creates a private var."
  [name & body]
  (when *load-tests*
    ;; :private has to ride on the def's own literal meta-map argument
    ;; (matching defn-'s def-meta-name path) rather than going through
    ;; alter-meta! afterward: def is the only place that mirrors :private
    ;; into the var's actual isPrivate flag (see rt.ApplyVarMeta), which is
    ;; what ns-publics/ns-interns actually check — plain alter-meta! only
    ;; touches the meta map, which isPrivate does not read back from. Built
    ;; with `list`, not literal syntax-quote, so the `with-meta` head stays
    ;; the bare unqualified symbol the def compiler pattern-matches on
    ;; (syntax-quote would otherwise resolve it to a qualified symbol).
    `(do (def ~(list 'with-meta name {:private true})
           (fn [] (test-var (var ~name))))
         (alter-meta! (var ~name) assoc :test (fn [] ~@body))
         (set! *default-test-ns* *ns*))))

(defmacro with-test
  "Takes any definition form (that returns a Var) as the first argument.
   Remaining body goes in the :test metadata function for that Var."
  [definition & body]
  (if *load-tests*
    `(doto ~definition
       (alter-meta! assoc :test (fn [] ~@body))
       ((fn [_#] (set! *default-test-ns* *ns*))))
    definition))

(defmacro set-test
  "Sets the :test metadata of the named var to a fn with the given body."
  [name & body]
  (when *load-tests*
    `(do (alter-meta! (var ~name) assoc :test (fn [] ~@body))
         (set! *default-test-ns* *ns*))))

;;; ---- Assertions (spec 6) --------------------------------------------------

(defn function?
  "True if argument is a function or a symbol that resolves to a non-macro fn."
  [x]
  (if (symbol? x)
    (when-let [v (resolve x)]
      (when-let [value (get-possibly-unbound-var v)]
        (and (fn? value) (not (:macro (meta v))))))
    (fn? x)))

(defn assert-predicate [msg form]
  (let [args (rest form)
        pred (first form)]
    `(let [values# (list ~@args)
           result# (apply ~pred values#)]
       (if result#
         (do-report {:type :pass :message ~msg
                     :expected '~form :actual (cons '~pred values#)})
         (do-report {:type :fail :message ~msg
                     :expected '~form :actual (list '~'not (cons '~pred values#))}))
       result#)))

(defn assert-any [msg form]
  `(let [value# ~form]
     (if value#
       (do-report {:type :pass :message ~msg :expected '~form :actual value#})
       (do-report {:type :fail :message ~msg :expected '~form :actual value#}))
     value#))

(defmulti assert-expr
  (fn [msg form]
    (cond
      (nil? form) :always-fail
      (seq? form) (first form)
      :else :default)))

(defmethod assert-expr :always-fail [msg form]
  `(do-report {:type :fail :message ~msg}))

(defmethod assert-expr :default [msg form]
  (if (and (sequential? form) (function? (first form)))
    (assert-predicate msg form)
    (assert-any msg form)))

(defmethod assert-expr 'instance? [msg form]
  `(let [klass# ~(nth form 1)
         object# ~(nth form 2)]
     (let [result# (instance? klass# object#)]
       (if result#
         (do-report {:type :pass :message ~msg :expected '~form :actual (class object#)})
         (do-report {:type :fail :message ~msg :expected '~form :actual (class object#)}))
       result#)))

(defmethod assert-expr 'thrown? [msg form]
  (let [klass (second form)
        body (nthnext form 2)]
    `(try ~@body
          (do-report {:type :fail :message ~msg :expected '~form :actual nil})
          (catch ~klass e#
            (do-report {:type :pass :message ~msg :expected '~form :actual e#})
            e#))))

(defmethod assert-expr 'thrown-with-msg? [msg form]
  (let [klass (nth form 1)
        re (nth form 2)
        body (nthnext form 3)]
    `(try ~@body
          (do-report {:type :fail :message ~msg :expected '~form :actual nil})
          (catch ~klass e#
            (let [m# (ex-message e#)]
              (if (re-find ~re m#)
                (do-report {:type :pass :message ~msg :expected '~form :actual e#})
                (do-report {:type :fail :message ~msg :expected '~form :actual e#})))
            e#))))

(defmacro try-expr
  "Used by the is macro; evaluates expr and catches any exception,
   reporting it as an :error. The is form's source position is bound for
   fail-position (spec 10.1)."
  [msg expr]
  (let [{:keys [line]} (meta &form)
        file (when line *file*)]
    `(binding [*assertion-position* ~(when line {:file file :line line})]
       (try ~(assert-expr msg expr)
            (catch Throwable t#
              (do-report {:type :error :message ~msg
                          :expected '~expr :actual t#}))))))

(defmacro is
  ([form] `(is ~form nil))
  ([form msg] `(try-expr ~msg ~form)))

(defn compose-fixtures
  "Compose two fixture fns into one that wraps f around g around the test fn."
  [f g]
  (fn [t] (f (fn [] (g t)))))

(defn default-fixture
  "Fixture that adds nothing: it just calls the test fn."
  [t]
  (t))

(defn join-fixtures
  "Compose a collection of fixture fns into a single fixture fn."
  [fs]
  (reduce compose-fixtures default-fixture fs))

(defn- ns-test-vars
  "Every var in ns with a fn under :test metadata — a test, per spec 7.
   Replaces the old *registered-tests* registry: there is nothing to
   register, membership is just the metadata. Order is unspecified, as in
   Clojure."
  [ns]
  (filter (comp :test meta) (vals (ns-interns ns))))

(defn- run-test-var-body
  "run-test-var's per-var execution (Task 13 replaces this bridge layer).
   Unlike test-var, this falls back to the var's own value when it has no
   :test metadata — preserving the pre-Task-12 test-var*'s support for a
   plain (def probe (fn [] ...)) that is meant to fail or throw on
   purpose, run manually through run-test-var without joining the
   automatic run-tests scan (which only ever sees vars with :test meta
   anyway). *each-fixtures* wraps here, not inside test-var itself — real
   clojure.test applies fixtures at the runner layer, so test-var stays
   exactly spec 9.1."
  [v]
  ((join-fixtures *each-fixtures*) (fn [] ((or (:test (meta v)) (deref v))))))

(defn run-tests [& nss]
  (binding [*report-counters* (ref *initial-report-counters*)]
    (set! *test-result* true)
    (println "Running tests...")
    ((join-fixtures *once-fixtures*)
     (fn []
       (if (seq nss)
         (doseq [s nss]
           (let [old-ns *ns*]
             (in-ns s)
             (doseq [v (ns-test-vars *ns*)]
               ((join-fixtures *each-fixtures*) (fn [] (test-var v))))
             (in-ns (ns-name old-ns))))
         ;; No namespaces given: run the tests in the current namespace — or,
         ;; if that has drifted out from under us (see *default-test-ns*'s
         ;; docstring above), the last namespace a test was actually defined
         ;; in.
         (let [target (or *default-test-ns* *ns*)
               old-ns *ns*]
           (in-ns (ns-name target))
           (doseq [v (ns-test-vars target)]
             ((join-fixtures *each-fixtures*) (fn [] (test-var v))))
           (in-ns (ns-name old-ns))))))
    (let [c @*report-counters*]
      (println "Finished running tests. Tests:" (:test c) "Pass:" (:pass c) "Fail:" (:fail c) "Error:" (:error c))
      (set! *test-result* (successful? c)))))

(defn run-test-var
  "Run a single test var and return the report counters
   ({:test :pass :fail :error}). The var runs through *once-fixtures* and
   *each-fixtures*, and inside the namespace it was defined in (:ns of its
   metadata, which def attaches — Task 5), so one test behaves the way the
   whole suite does. A thrown test body counts as an :error rather than
   escaping. This is what editors call to run the test under the cursor;
   see also the run-test macro.

   The counters are bound, not set, for the duration of the run — as
   clojure.test does — so running one test from inside another test, or
   from a REPL in the middle of a suite, cannot overwrite the enclosing
   run's tally or clear its failure flag."
  [v]
  (let [old-ns *ns*]
    (binding [*report-counters* (ref *initial-report-counters*)
              *test-result* true
              *testing-contexts* []]
      (in-ns (ns-name (or (:ns (meta v)) *ns*)))
      (try
        (binding [*testing-vars* (conj *testing-vars* v)]
          ((join-fixtures *once-fixtures*)
           (fn []
             (do-report {:type :begin-test-var :var v})
             (inc-report-counter :test)
             (try (run-test-var-body v)
                  (catch Throwable e
                    (do-report {:type :error
                                :message "Uncaught exception, not in assertion."
                                :expected nil :actual e})))
             (do-report {:type :end-test-var :var v}))))
        (finally
          (in-ns (ns-name old-ns))))
      (let [c @*report-counters*]
        (println "Finished running test. Tests:" (:test c) "Pass:" (:pass c) "Fail:" (:fail c) "Error:" (:error c))
        (set! *test-result* (successful? c))
        c))))

(defmacro run-test
  "Run the named test and return its report counters:
   (run-test my-test). Sugar for (run-test-var (var my-test))."
  [name]
  `(run-test-var (var ~name)))

;;; ---- testing / are (spec 6.5, 6.6) ----------------------------------------

(defmacro testing [string & body]
  `(binding [*testing-contexts* (conj *testing-contexts* ~string)]
     ~@body))

(defn apply-template [argv expr values]
  (postwalk-replace (zipmap argv values) expr))

(defmacro do-template [argv expr & values]
  (let [c (count argv)]
    `(do ~@(map (fn [a] (apply-template argv expr a))
                (partition c values)))))

(defmacro are [argv expr & args]
  (if (or
        (and (empty? argv) (empty? args))
        (and (pos? (count argv))
             (pos? (count args))
             (zero? (mod (count args) (count argv)))))
    `(do-template ~argv (is ~expr) ~@args)
    (throw (ex-info "The number of args doesn't match are's argv."
                    {:type :illegal-argument
                     :class 'java.lang.IllegalArgumentException}))))

; simple fixtures API (global per session)
(defn use-fixtures [phase & fs]
  (cond
    (= phase :each) (set! *each-fixtures* fs)
    (= phase :once) (set! *once-fixtures* fs)
    :else nil))

; basic clojure.test shim for stock tests
